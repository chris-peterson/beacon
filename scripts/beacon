#!/usr/bin/env python3
"""beacon — at-a-glance session awareness for Claude Code in iTerm2.

Resolves three signals (project, task, status) via chain-of-responsibility
providers, then invokes bin/beacon-iterm to surface results. The CLI is the
only writer to iTerm2. Status carries an optional free-text description
(the "marginalia overlay" body) the user can attach via `status <value>
[<description>]`; `pause [<note>]` is a synonym for `status paused [<note>]`.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

# --- paths and identity ---

PLUGIN_ROOT = Path(os.environ.get("CLAUDE_PLUGIN_ROOT") or Path(__file__).resolve().parent.parent)


def _plugin_version() -> str:
    """Read the plugin's version from .claude-plugin/plugin.json. Single source
    of truth — never hardcode a version constant in code."""
    return json.loads((PLUGIN_ROOT / ".claude-plugin" / "plugin.json").read_text())["version"]


def _default_data_dir() -> Path:
    """Match Claude Code's `<plugin>-<owner>` data-dir convention. Hooks
    receive `CLAUDE_PLUGIN_DATA` from Claude Code, but slash commands and
    the on-PATH wrapper do not — without convergence those contexts would
    write to a different directory than hooks read from, and state changes
    would be invisible across them. Cache installs parse the path; dev
    installs derive the owner from PLUGIN_ROOT's git remote."""
    base = Path.home() / ".claude" / "plugins"
    try:
        rel = PLUGIN_ROOT.relative_to(base / "cache")
        return base / "data" / f"{rel.parts[1]}-{rel.parts[0]}"
    except (ValueError, IndexError):
        pass
    owner = _git_remote_owner(PLUGIN_ROOT)
    if owner:
        return base / "data" / f"{PLUGIN_ROOT.name}-{owner}"
    raise RuntimeError(
        f"can't derive a data dir from PLUGIN_ROOT={PLUGIN_ROOT}: not under "
        f"{base / 'cache'} and no parsable git remote. Set CLAUDE_PLUGIN_DATA "
        f"explicitly or run from a working tree with an origin."
    )


def _git_remote_owner(repo_dir: Path) -> str | None:
    """Owner segment of `remote.origin.url` (e.g. `chris-peterson` from
    `git@github.com:chris-peterson/beacon.git`), or None when no remote.

    Inlined parser instead of reusing `p_git_remote` because this runs at
    module-load time via the `DATA_DIR = ...` assignment, before
    `p_git_remote` is defined — Python only resolves names at call time
    but the call happens during import. The duplication is intentional."""
    try:
        r = subprocess.run(
            ["git", "config", "remote.origin.url"],
            cwd=str(repo_dir), capture_output=True, text=True, timeout=2,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    url = r.stdout.strip()
    if not url:
        return None
    if "://" in url:
        path = url.split("://", 1)[1]
        path = path.split("/", 1)[1] if "/" in path else ""
    elif ":" in url:
        path = url.split(":", 1)[1]
    else:
        path = url
    path = path.rstrip("/")
    if path.endswith(".git"):
        path = path[:-4]
    parts = [p for p in path.split("/") if p]
    return parts[0] if parts else None


DATA_DIR = Path(os.environ.get("CLAUDE_PLUGIN_DATA") or str(_default_data_dir()))
STATE_DIR = DATA_DIR / "state"
CACHE_DIR = DATA_DIR / "cache"

BEACON_ITERM = PLUGIN_ROOT / "bin" / "beacon-iterm"


def _color(code: str, s: str) -> str:
    """Wrap `s` in an ANSI SGR sequence when stdout is a TTY; passthrough
    otherwise so logs and pipes stay clean."""
    return f"\x1b[{code}m{s}\x1b[0m" if sys.stdout.isatty() else s


DEFAULT_BRANCHES = {"main", "master", "develop", "trunk", "HEAD"}

PROJECT_MARKERS = [".git", "package.json", "Cargo.toml", "pyproject.toml",
                   "go.mod", ".hg", "pom.xml", "Gemfile"]

# Slash commands that should reset stale per-session state when invoked
# mid-session. `/recipe` re-bootstraps a session from scratch (it loads a
# playbook), so signals from the prior task — pending attention, a stale
# user-set status, lingering overrides — would otherwise contaminate the
# new context. SessionStart already covers fresh-launch and `/clear`; this
# catches the in-session commands Claude Code does not surface as a hook
# event.
FRESH_START_COMMANDS = ("recipe",)
FRESH_START_RE = re.compile(
    r"^\s*/(?:" + "|".join(FRESH_START_COMMANDS) + r")\b",
    re.IGNORECASE,
)

# Last-assistant-text idle pattern. When pending-attention or signal.status
# = waiting would render the badge red but the transcript shows Claude's
# most recent reply was an idle "Ready..." (final, awaiting-user message),
# the markers are stale (the prior Stop hook never fired or arrived after
# the next session reused the pane). The heuristic forgives the missing
# Stop and clears them.
IDLE_LOOK_RE = re.compile(r"^\s*ready\b", re.IGNORECASE)

PAUSE_RE = re.compile(
    r"^\s*(?:"
    r"(?:afk|brb|bbiab)(?:\s|$)"
    r"|pause(?:\s+(?:until|for|while|'?til)\b|\s*$)"
    r"|break(?:\s+(?:until|for|'?til|in|after)\b|\s*$)"
    r"|stepping\s+(?:away|out)\b"
    r"|step\s+(?:away|out)\b"
    r"|going\s+(?:afk|away|out)\b"
    r"|going\s+to\s+(?:lunch|bed|sleep|the\s+\S+|grab\s+\S+|get\s+\S+|a\s+meeting|standup)\b"
    r"|out\s+(?:for|until|'?til|to\s+lunch)\b"
    r"|back\s+(?:in|at|by|until|'?til|after)\s+\S+"
    r"|gone\s+(?:for|until|'?til)\s+\S+"
    r"|(?:grabbing|getting|having)\s+(?:lunch|coffee|dinner|food)\b"
    r"|in\s+(?:standup|a\s+meeting|a\s+call)\b"
    r"|on\s+a\s+call\b"
    r"|taking\s+a\s+break\b"
    r"|lunch\s*$"
    r")",
    re.IGNORECASE,
)

VALID_STATUSES = {"idle", "working", "waiting", "paused"}
VALID_FIELDS = ("project", "task", "status", "url")

# Shell-native completion script — installed by `beacon completions zsh`.
ZSH_COMPLETION = r"""#compdef beacon

_beacon_statuses() { compadd idle working waiting paused }
_beacon_fields()   { compadd project task status url }

_beacon() {
  local -a commands=(
    'show:show resolved signals'
    'set:set an override (project|task|status)'
    'task:set task override'
    'status:set status override with optional description'
    'project:set project override'
    'clear:clear one or all overrides'
    'pause:set status=paused with optional description'
    'resume:clear all overrides (full reset to provider chain)'
    'reset:clear all per-session state'
    'render:re-render current state'
    'completions:install or print shell completions'
    'install:run all install steps (shell, wrapper, completions, profile)'
    'install-cli:install or refresh the beacon wrapper at ~/.local/bin/beacon'
    'exclusive-configuration:orchestrate iTerm2 quit+relaunch to apply prefs that require iTerm2 to be quit'
    'copy-url:copy the resolved URL to the clipboard'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  local command="${words[2]}"
  case "$command" in
    set)
      case "$CURRENT" in
        3) _beacon_fields ;;
        4)
          case "${words[3]}" in
            status) _beacon_statuses ;;
            *)      _message 'value' ;;
          esac
          ;;
      esac
      ;;
    status)
      case "$CURRENT" in
        3) _beacon_statuses ;;
        4) _message 'description (optional)' ;;
      esac
      ;;
    task|project) (( CURRENT == 3 )) && _message 'value' ;;
    clear)
      (( CURRENT == 3 )) && _beacon_fields
      ;;
    pause)
      (( CURRENT == 3 )) && _message 'description (optional)'
      ;;
    completions)
      (( CURRENT == 3 )) && compadd zsh
      ;;
    install-cli)
      (( CURRENT == 3 )) && compadd -- --dir
      ;;
    exclusive-configuration)
      (( CURRENT == 3 )) && compadd -- --yes -y
      ;;
  esac
}

_beacon "$@"
"""

# Logical status states → badge color hex (no leading #). Logical names are
# the contract (BADGE-09, BADGE-10); hex values come from the Dracula palette
# (THEME-01, THEME-02) and are tunable here without touching call sites.
# `paused` is de-emphasized (Dracula comment) so a parked session reads
# distinct from one blocked on the user (BADGE-10).
BADGE_COLOR_PALETTE = {
    "ready":        "50fa7b",
    "busy":         "ffb86c",
    "blocked":      "ff5555",
    "blocked-idle": "ff5555",
    "paused":       "6272a4",
}

STATUS_TO_BADGE_STATE = {
    "idle":    "ready",
    "working": "busy",
    "waiting": "blocked",
    "paused":  "paused",
}

# Static badge format. The task slot self-collapses when empty — beacon_task
# carries ": <task>" when set, "" when absent (BADGE-03). Both writers
# (this constant and shell/beacon.zsh) must stay in sync.
BADGE_FORMAT = r"\(user.beacon_project)\(user.beacon_task)"


def session_hash() -> str:
    seed = os.environ.get("ITERM_SESSION_ID") or _tty_name() or "default"
    return hashlib.sha1(seed.encode()).hexdigest()[:16]


def _tty_name() -> str | None:
    try:
        return os.ttyname(0)
    except OSError:
        return None


def find_project_root(cwd: Path) -> Path:
    # Treat $HOME as a boundary — markers at or above $HOME (stray package.json,
    # dotfiles .git, etc.) don't represent the user's "current project".
    p = cwd.resolve()
    home = Path.home().resolve()
    for d in (p, *p.parents):
        if d == home or home not in (d, *d.parents):
            break
        for marker in PROJECT_MARKERS:
            if (d / marker).exists():
                return d
    return p


# --- state files ---

def _state_path(field: str) -> Path:
    return STATE_DIR / f"{session_hash()}.{field}"


def read_state(field: str) -> str | None:
    try:
        v = _state_path(field).read_text().strip()
        return v or None
    except FileNotFoundError:
        return None
    except OSError:
        return None


def read_state_json(field: str, default):
    raw = read_state(field)
    if not raw:
        return default
    try:
        return json.loads(raw)
    except Exception:
        return default


def write_state(field: str, value: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    _state_path(field).write_text(value)


def remove_state(field: str) -> None:
    try:
        _state_path(field).unlink()
    except FileNotFoundError:
        pass


# --- providers ---

def p_override(field: str):
    return read_state(f"override.{field}")


def p_signal(field: str):
    return read_state(f"signal.{field}")


def p_package_name(cwd: Path):
    root = find_project_root(cwd)
    pkg = root / "package.json"
    if pkg.is_file():
        try:
            return (json.loads(pkg.read_text()).get("name") or "").strip() or None
        except Exception:
            pass
    cargo = root / "Cargo.toml"
    if cargo.is_file():
        try:
            m = re.search(r'(?ms)^\[package\][^\[]*?^\s*name\s*=\s*"([^"]+)"', cargo.read_text())
            if m:
                return m.group(1)
        except Exception:
            pass
    pyp = root / "pyproject.toml"
    if pyp.is_file():
        try:
            m = re.search(r'(?ms)^\[project\][^\[]*?^\s*name\s*=\s*"([^"]+)"', pyp.read_text())
            if m:
                return m.group(1)
        except Exception:
            pass
    return None


def p_git_remote(cwd: Path):
    """Repo basename from git remote (e.g. `beacon`, `auth-svc`) — the last
    path segment of the remote URL, dropping owner/group prefixes. The full
    owner-bearing identity lives in `_project_full_at` (status-bar chip);
    the badge wants a short, scannable label. Returns None when not in a
    git repo or no origin is configured."""
    root = find_project_root(cwd)
    out = subprocess.run(
        ["git", "config", "remote.origin.url"],
        cwd=root, capture_output=True, text=True, timeout=2,
    )
    if out.returncode != 0:
        return None
    url = out.stdout.strip()
    if not url:
        return None
    # Strip protocol/host. Two URL forms:
    #   ssh:   git@host:owner/path/to/repo.git
    #   https: https://host/owner/path/to/repo.git
    if "://" in url:
        path = url.split("://", 1)[1]
        path = path.split("/", 1)[1] if "/" in path else ""
    elif ":" in url:
        path = url.split(":", 1)[1]
    else:
        path = url
    path = path.rstrip("/")
    if path.endswith(".git"):
        path = path[:-4]
    parts = [p for p in path.split("/") if p]
    return parts[-1] if parts else None


def p_project_dir(cwd: Path):
    name = find_project_root(cwd).name
    return name or None


def p_branch(cwd: Path):
    root = find_project_root(cwd)
    out = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        cwd=root, capture_output=True, text=True, timeout=2,
    )
    if out.returncode != 0:
        return None
    branch = out.stdout.strip()
    return branch if branch and branch not in DEFAULT_BRANCHES else None


def p_pr_title(cwd: Path):
    if not _which("gh"):
        return None
    root = find_project_root(cwd)
    out = subprocess.run(
        ["gh", "pr", "view", "--json", "title", "-q", ".title"],
        cwd=root, capture_output=True, text=True, timeout=3,
    )
    if out.returncode != 0:
        return None
    return out.stdout.strip() or None


def _which(cmd):
    for p in os.environ.get("PATH", "").split(os.pathsep):
        if (Path(p) / cmd).exists():
            return True
    return False


# --- URL resolution (PROV-07) ---

def _git_remote_url_normalized(cwd: Path) -> str:
    """Return the project's git remote URL in https form, or empty.
    Normalizes ssh URLs (`git@host:owner/repo.git`) to https for browser use."""
    root = find_project_root(cwd)
    out = subprocess.run(
        ["git", "config", "remote.origin.url"],
        cwd=root, capture_output=True, text=True, timeout=2,
    )
    if out.returncode != 0:
        return ""
    url = out.stdout.strip()
    if not url:
        return ""
    if url.startswith("git@"):
        host_path = url[len("git@"):]
        host, _, path = host_path.partition(":")
        if host and path:
            url = f"https://{host}/{path}"
    if url.endswith(".git"):
        url = url[:-4]
    return url.rstrip("/")


def _remote_host(remote_url: str) -> str:
    """Lowercased host portion of a normalized https remote, or empty."""
    if "://" not in remote_url:
        return ""
    return remote_url.split("://", 1)[1].split("/", 1)[0].lower()


def _branch_url(cwd: Path, branch: str, remote: str) -> tuple[str, str]:
    """Return (url, branch) for the current non-default branch's tree, or empty."""
    if not branch or not remote:
        return "", ""
    # GitLab uses /-/tree/<branch>; GitHub and most others use /tree/<branch>.
    sep = "/-/tree/" if "gitlab" in _remote_host(remote) else "/tree/"
    return f"{remote}{sep}{branch}", branch


def _tack_url_for(cwd: Path, branch: str) -> tuple[str, str]:
    """Look up tack route by branch slug; return first useful URL via the
    in_progress-deliverable → done-deliverable → first-link sub-chain."""
    if not _which("tack") or not branch:
        return "", ""
    try:
        r = subprocess.run(["tack", "list", "--json"],
                           capture_output=True, text=True, timeout=2)
        if r.returncode != 0:
            return "", ""
        routes = json.loads(r.stdout)
    except (subprocess.SubprocessError, json.JSONDecodeError, OSError):
        return "", ""

    route = next((r for r in routes if r.get("slug") == branch), None)
    if not route:
        return "", ""
    tacks = route.get("tacks", []) or []

    # a. first in_progress with deliverable
    for t in tacks:
        if t.get("status") == "in_progress":
            d = t.get("deliverable") or {}
            if d.get("url"):
                return d["url"], d.get("label", "")

    # b. most-recently-completed done with deliverable
    done = [t for t in tacks if t.get("status") == "done"]
    done.sort(key=lambda t: t.get("done_at", ""), reverse=True)
    for t in done:
        d = t.get("deliverable") or {}
        if d.get("url"):
            return d["url"], d.get("label", "")

    # c. first link.url across any tack
    for t in tacks:
        for ln in (t.get("links") or []):
            if ln.get("url"):
                return ln["url"], ln.get("label", "")

    return "", ""


_FORGE_PROBES = {
    "github": {
        "cli": "gh",
        "argv": lambda b: ["gh", "pr", "list", "--head", b,
                           "--json", "url,number,title", "--limit", "1"],
        "url_key": "url",
        "label": lambda d: d.get("title") or f"#{d.get('number','')}",
    },
    "gitlab": {
        "cli": "glab",
        "argv": lambda b: ["glab", "mr", "list", "--source-branch", b,
                           "--output", "json", "--per-page", "1"],
        "url_key": "web_url",
        "label": lambda d: d.get("title") or f"!{d.get('iid','')}",
    },
}


def _forge_url(cwd: Path, branch: str, remote: str) -> tuple[str, str]:
    """Probe the forge for an open PR/MR matching the current branch. Returns
    empty when the host isn't recognized, the matching CLI isn't installed,
    or the call fails. Exceptions are swallowed because this runs on every
    branch change — a hiccup must not crash the chain or block the shell."""
    if not branch or not remote:
        return "", ""
    host = _remote_host(remote)
    probe = next((p for tag, p in _FORGE_PROBES.items() if tag in host), None)
    if not probe or not _which(probe["cli"]):
        return "", ""
    try:
        r = subprocess.run(
            probe["argv"](branch),
            cwd=str(cwd), capture_output=True, text=True, timeout=3,
        )
        if r.returncode != 0 or not r.stdout.strip():
            return "", ""
        items = json.loads(r.stdout)
    except (subprocess.SubprocessError, json.JSONDecodeError, OSError):
        return "", ""
    if not items:
        return "", ""
    item = items[0]
    return item.get(probe["url_key"], ""), probe["label"](item)


def resolve_url(cwd: Path | None = None) -> tuple[str, str]:
    """Implements PROV-07. Returns (url, label)."""
    cwd = cwd or Path.cwd()

    # 1. user override (short-circuits before any git work)
    o = p_override("url")
    if o:
        return o, o[:30]

    # Resolve branch and remote once; reused by every subsequent provider.
    # Either may be empty (default branch / no `origin`); helpers handle that.
    branch = p_branch(cwd)
    remote = _git_remote_url_normalized(cwd)

    # 2. tack-derived
    url, label = _tack_url_for(cwd, branch)
    if url:
        return url, label

    # 3. forge probe — cached by the shell's `cwd@branch` signal, so this
    # fires once per branch change, not per prompt.
    url, label = _forge_url(cwd, branch, remote)
    if url:
        return url, label

    # 4. branch URL
    url, label = _branch_url(cwd, branch, remote)
    if url:
        return url, label

    # 5. project URL
    if remote:
        label = p_git_remote(cwd) or p_project_dir(cwd) or ""
        return remote, label

    # 6. empty
    return "", ""


def cmd_resolve_url(_args):
    url, label = resolve_url()
    sys.stdout.write(f"{url}\t{label}\n")


def cmd_copy_url(_args):
    """Resolve the current URL (PROV-07) and pipe it through pbcopy."""
    url, _ = resolve_url()
    if not url:
        sys.exit("no URL resolved (no override, no tack route, no git remote)")
    try:
        r = subprocess.run(["pbcopy"], input=url, text=True, timeout=2)
        if r.returncode != 0:
            sys.exit(f"pbcopy failed (exit {r.returncode})")
    except FileNotFoundError:
        sys.exit("pbcopy not found — copy-url requires macOS")
    print(f"copied: {url}")


def cmd_open_url(_args):
    """Resolve the current URL (PROV-07) and open it in the default browser
    via `open`. Used by the status bar 'go' button via Send Text — runs in
    the user's interactive shell at the prompt, so the cwd is correct."""
    url, _ = resolve_url()
    if not url:
        sys.exit("no URL resolved (no override, no tack route, no git remote)")
    try:
        r = subprocess.run(["open", url], capture_output=True, timeout=2)
        if r.returncode != 0:
            sys.exit(f"open failed (exit {r.returncode}): {r.stderr.decode().strip()}")
    except FileNotFoundError:
        sys.exit("open not found — open-url requires macOS")
    print(f"opened: {url}")


def cmd_data_dir(_args):
    """Print the resolved data dir — consumed by shell/beacon.zsh to
    derive its cache path on source."""
    sys.stdout.write(f"{DATA_DIR}\n")


def cmd_json(_args):
    """Print the resolved session state as a JSON object — for handoff,
    cmd+click of the embedded URL, or piping into jq / your own tooling."""
    cwd = Path.cwd()
    state = resolve(cwd)
    url, _ = resolve_url(cwd)
    claude_sid = read_state("claude_session_id") or ""
    home = str(Path.home())
    cwd_str = str(cwd)
    if cwd_str == home or cwd_str.startswith(home + "/"):
        cwd_str = "~" + cwd_str[len(home):]
    payload = {
        "project": state["project"],
        "branch": p_branch(cwd) or "",
        "status": state["status"],
        "description": state.get("description", ""),
        "url": url,
        "cwd": cwd_str,
        "claude_session": claude_sid,
    }
    print(json.dumps(payload, indent=2))


# --- resolver ---

def chain(providers):
    for name, fn in providers:
        try:
            v = fn()
            if v:
                return v, name
        except Exception:
            continue
    return None, None


def resolve(cwd: Path | None = None) -> dict:
    cwd = cwd or Path.cwd()

    _recover_stale_red()

    project, p_proj = chain([
        ("override",   lambda: p_override("project")),
        ("package",    lambda: p_package_name(cwd)),
        ("git-remote", lambda: p_git_remote(cwd)),
        ("dir",        lambda: p_project_dir(cwd)),
    ])
    if not project:
        project, p_proj = _local_path_at(cwd), "pwd"

    task, p_task = chain([
        ("override", lambda: p_override("task")),
        ("pr",       lambda: p_pr_title(cwd)),
        ("branch",   lambda: p_branch(cwd)),
    ])

    status, p_status = chain([
        ("override", lambda: p_override("status")),
        ("signal",   lambda: p_signal("status")),
    ])
    if not status:
        status, p_status = "idle", "default"

    pending_attention_type = (read_state("pending-attention") or "").strip() or None
    description = (read_state("description") or "").strip()
    return {
        "project": project, "project_provider": p_proj,
        "task": task, "task_provider": p_task,
        "status": status, "status_provider": p_status,
        "description": description,
        "pending_attention": _state_path("pending-attention").exists(),
        "pending_attention_type": pending_attention_type,
    }


# --- CLI bridge ---

def _cli(*args, timeout: float = 5.0) -> None:
    """Invoke beacon-iterm. Failures are swallowed so the plugin never crashes
    a hook on display issues."""
    cmd = ["python3", str(BEACON_ITERM), *map(str, args)]
    try:
        subprocess.run(cmd, capture_output=True, timeout=timeout, check=False)
    except Exception:
        pass


# --- session anchor (mirrors shell/beacon.zsh _beacon_precmd) ---
#
# The navigational identity of a Claude session is the cwd Claude was invoked
# with. SessionStart captures that and publishes the full set of status-bar
# slots (project, project_full, branch×5, url) plus the per-session handoff
# files for the ↗ code / ↖ web buttons (HOOK-08). Those slots are not
# refreshed mid-session — they represent *which* session this is, not where
# Claude's current Bash subprocess happens to be. This duplicates
# project/branch/url resolution from shell/beacon.zsh — keep them in sync;
# in interactive (non-Claude) sessions the shell publishes the same slots
# on each prompt redraw and naturally tracks the user's actual PWD.

def _detect_branch_info(cwd: Path) -> tuple[str, str, str]:
    """Return (display, state, indicator). Empty triplet outside a repo."""
    try:
        r = subprocess.run(
            ["git", "symbolic-ref", "--short", "HEAD"],
            cwd=str(cwd), capture_output=True, text=True, timeout=2, check=False,
        )
    except Exception:
        return ("", "", "")
    name = r.stdout.strip()
    if r.returncode != 0 or not name:
        return ("", "", "")

    state = "untracked"
    indicator = ""
    try:
        u = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"],
            cwd=str(cwd), capture_output=True, timeout=2, check=False,
        )
        if u.returncode == 0:
            counts = subprocess.run(
                ["git", "rev-list", "--left-right", "--count", "@{u}...HEAD"],
                cwd=str(cwd), capture_output=True, text=True, timeout=2, check=False,
            )
            if counts.returncode == 0:
                parts = counts.stdout.split()
                if len(parts) == 2:
                    behind, ahead = int(parts[0]), int(parts[1])
                    if ahead == 0 and behind == 0:
                        state = "clean"
                    else:
                        state = "diverged"
                        if ahead > 0:
                            indicator += f"↑{ahead}"
                        if behind > 0:
                            indicator += f"↓{behind}"
    except Exception:
        pass

    display = f"{indicator} {name}" if state == "diverged" else name
    return (display, state, indicator)


def _project_root_at(cwd: Path) -> Path | None:
    """Mirror shell's `_beacon_project_root`: return the nearest ancestor (or
    cwd itself) holding a project marker, stopping at $HOME. Returns None
    when no marker is found within the search range — distinct from
    `find_project_root`, which falls back to cwd. Used by the anchor
    publisher to match the shell's "blank when not in a project" semantics."""
    home = Path.home().resolve()
    p = cwd.resolve()
    for d in (p, *p.parents):
        # Out of search scope when d reaches or steps outside $HOME's subtree.
        # Markers at or above $HOME (stray dotfiles `.git`, etc.) don't
        # represent the user's "current project".
        if d == home or home not in d.parents:
            return None
        for marker in PROJECT_MARKERS:
            if (d / marker).exists():
                return d
    return None


def _project_name_at(cwd: Path) -> str:
    """Owner/repo form when in a project (preferring git remote, falling
    back to root basename). Empty outside any recognized project."""
    root = _project_root_at(cwd)
    if not root:
        return ""
    name = p_git_remote(cwd)
    if name:
        return name
    return root.name or ""


_REMOTE_HOST_ABBREV = {
    "github.com": "gh",
    "gitlab.com": "gl",
    "bitbucket.org": "bb",
}


def _abbrev_remote_host(host_path: str) -> str:
    """`github.com/owner/repo` → `gh:owner/repo` for known forges; pass-through otherwise."""
    host, sep, rest = host_path.partition("/")
    if not sep:
        return host_path
    abbrev = _REMOTE_HOST_ABBREV.get(host)
    return f"{abbrev}:{rest}" if abbrev else host_path


# GitLab patterns appear first because their `/-/issues/` and `/-/merge_requests/`
# paths contain a literal `/issues/` substring that the GitHub patterns would
# also match — we want the GitLab sigil (`!` for MRs) to win on GitLab URLs.
_DELIVERABLE_PATTERNS = (
    (re.compile(r"/-/merge_requests/(\d+)"), "!"),
    (re.compile(r"/-/issues/(\d+)"),         "#"),
    (re.compile(r"/pull/(\d+)"),             "#"),
    (re.compile(r"/issues/(\d+)"),           "#"),
)


def _deliverable_suffix(url: str) -> str:
    """`#42` for issues/PRs, `!17` for GitLab MRs. Empty when the URL doesn't
    point at a forge issue/PR/MR. Used to contextualize the project_full chip
    when PROV-07 returns a deliverable URL (tack, user override) — bare repo
    or branch-tree URLs leave the chip showing only the project identity."""
    if not url:
        return ""
    for pat, sigil in _DELIVERABLE_PATTERNS:
        m = pat.search(url)
        if m:
            return f"{sigil}{m.group(1)}"
    return ""


def _project_full_at(cwd: Path) -> str:
    """Abbreviated remote identity, e.g. `gh:owner/repo`. Empty when there's
    no project or no remote. Mirrors shell's `_beacon_project_full`."""
    root = _project_root_at(cwd)
    if not root:
        return ""
    out = subprocess.run(
        ["git", "config", "remote.origin.url"],
        cwd=root, capture_output=True, text=True, timeout=2,
    )
    if out.returncode != 0 or not out.stdout.strip():
        return ""
    url = out.stdout.strip()
    if "://" in url:
        path = url.split("://", 1)[1]
        if "@" in path:
            path = path.split("@", 1)[1]
    elif ":" in url:
        host_path = url.split("@", 1)[1] if "@" in url else url
        host, _, p = host_path.partition(":")
        path = f"{host}/{p}" if host and p else url
    else:
        path = url
    path = path.rstrip("/")
    if path.endswith(".git"):
        path = path[:-4]
    return _abbrev_remote_host(path)


def _local_path_at(cwd: Path) -> str:
    """`~`-substituted display path. Mirrors shell's `_beacon_local_path`."""
    home = str(Path.home())
    s = str(cwd)
    if s == home:
        return "~"
    if s.startswith(home + "/"):
        return "~" + s[len(home):]
    return s


_LAST_CHIP_PAIRS: tuple[str, ...] | None = None


def _publish_chips(cwd: Path) -> None:
    """Refresh status-bar chips (project_full, branch*, url) + action-button
    handoff files from `cwd`. Does NOT touch beacon_project / beacon_task —
    those are owned by the engagement renderer.

    Called whenever the shell's precmd can't (mid-session, between turns) so
    chips reflect branch creation / tack-context changes that happened while
    the shell was blocked on Claude."""
    global _LAST_CHIP_PAIRS
    project_full = _project_full_at(cwd)
    display, state, _ind = _detect_branch_info(cwd)
    url, _label = resolve_url(cwd)

    if project_full:
        project_full = f"{project_full}{_deliverable_suffix(url)}"

    pairs = (
        f"beacon_project_full={project_full}",
        f"beacon_branch={display}",
        f"beacon_branch_state={state}",
        f"beacon_branch_clean={display if state == 'clean' else ''}",
        f"beacon_branch_diverged={display if state == 'diverged' else ''}",
        f"beacon_branch_untracked={display if state == 'untracked' else ''}",
        f"beacon_url={url}",
    )
    # Last-value gate (mirrors shell's precmd sentinels per CLAUDE.md hot
    # path policy): Stop fires once per turn, but most turns don't change
    # branch/url. Skip the CLI spawn + file writes when nothing differs.
    if pairs == _LAST_CHIP_PAIRS:
        return
    _LAST_CHIP_PAIRS = pairs
    _cli("uservar-batch", *pairs)

    iterm_id = os.environ.get("ITERM_SESSION_ID")
    if iterm_id:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        (CACHE_DIR / f"cwd-{iterm_id}.txt").write_text(f"{cwd}\n")
        (CACHE_DIR / f"url-{iterm_id}.txt").write_text(f"{url}\n")


def _publish_anchor(cwd: Path) -> None:
    """HOOK-08: pin the navigational identity of this Claude session.

    SessionStart-only: publishes chips via `_publish_chips`, then anchors
    `beacon_project` (badge text fallback) and clears `beacon_task` so a
    fresh session starts from a known state. The cwd and resolved project
    are persisted as `anchor.cwd` / `anchor.project` so the Stop hook
    (HOOK-08b) re-resolves chips from this fixed anchor rather than trusting
    each turn's payload cwd — the anchor is beacon's own record of where the
    session began, not an implicit property of Claude's hook payloads."""
    _publish_chips(cwd)

    project = _project_name_at(cwd)
    local_path = _local_path_at(cwd)
    # BADGE-04 + PROV-06: when SessionStart's cwd is outside any recognized
    # project, fall back to the abbreviated cwd so the badge always carries
    # spatial context.
    project_display = project or local_path
    write_state("anchor.cwd", str(cwd))
    write_state("anchor.project", project_display)
    _cli("uservar-batch", f"beacon_project={project_display}", "beacon_task=")


# --- pane sizing for note overlay ---

def detect_pane_pixels(default=(1440, 1080)) -> tuple[int, int]:
    cols = lines = 0
    try:
        cols = int(os.environ.get("COLUMNS") or 0)
        lines = int(os.environ.get("LINES") or 0)
    except ValueError:
        pass
    if cols == 0 or lines == 0:
        try:
            with open("/dev/tty", "rb") as tty:
                r = subprocess.run(["stty", "size"], stdin=tty,
                                   capture_output=True, text=True, timeout=2)
            if r.returncode == 0:
                parts = r.stdout.split()
                if len(parts) == 2:
                    lines, cols = int(parts[0]), int(parts[1])
        except Exception:
            pass
    if cols <= 0 or lines <= 0:
        return default
    try:
        cell_w = float(os.environ.get("BEACON_CELL_WIDTH") or "7")
        cell_h = float(os.environ.get("BEACON_CELL_HEIGHT") or "16")
    except ValueError:
        cell_w, cell_h = 7.0, 16.0
    w = max(640, min(3200, int(cols * cell_w)))
    h = max(480, min(2000, int(lines * cell_h)))
    return (w // 8) * 8, (h // 8) * 8


NOTE_POOL_SIZE = 8


def _next_note_slot() -> Path:
    """Pick the LRU slot from the fixed pool of note-NN.png files.

    Reusing a fixed pool of paths means iTerm2's trust prompt for
    SetBackgroundImageFile only fires N times ever (once per slot). After
    that, every pause reuses an already-trusted path.

    Avoid slots currently referenced by any active `note-image` state file —
    including our own session's current slot. iTerm2 caches the background
    image by path, so a second pause that landed on our previous slot would
    leave the prior overlay on screen even though the file was overwritten.
    Picking a different slot every pause forces a path change that iTerm2
    actually refreshes on. If every slot is in use (very unlikely with
    N=8), fall back to LRU and accept the race.
    """
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    slots = [CACHE_DIR / f"note-{i:02d}.png" for i in range(1, NOTE_POOL_SIZE + 1)]

    in_use: set[str] = set()
    for state_file in STATE_DIR.glob("*.note-image"):
        try:
            path = state_file.read_text().strip()
            if path:
                in_use.add(path)
        except OSError:
            pass

    def mtime(p: Path) -> float:
        try:
            return p.stat().st_mtime
        except OSError:
            return 0.0

    free = [s for s in slots if str(s) not in in_use]
    return min(free or slots, key=mtime)


def render_note_card(label: str, text: str) -> str | None:
    """Compose the marginalia overlay via beacon-iterm note --out, returning
    the path on success. Slot selected by LRU rotation across the fixed
    pool so iTerm2's trust prompt only fires N times ever."""
    out = _next_note_slot()
    cmd = ["python3", str(BEACON_ITERM), "note", label, text, "--out", str(out)]
    try:
        subprocess.run(cmd, capture_output=True, timeout=15, check=False)
    except Exception:
        return None
    return str(out) if out.exists() else None


# --- initialization ---

_initialized = False


def ensure_initialized():
    global _initialized
    if _initialized:
        return
    for d in (STATE_DIR, CACHE_DIR):
        d.mkdir(parents=True, exist_ok=True)
    ensure_per_pane_bg_image()
    _initialized = True


def _is_iterm_running() -> bool:
    # osascript is the reliable cross-macOS way to ask. pgrep can return
    # false negatives under sandboxing.
    try:
        r = subprocess.run(
            ["osascript", "-e", 'application "iTerm" is running'],
            capture_output=True, text=True, timeout=2,
        )
        return r.returncode == 0 and r.stdout.strip().lower() == "true"
    except Exception:
        return False


def _bg_paths_needing_approval() -> list[str]:
    """Pool slots, empty-string sentinel, and static state images
    (BADGE-15) not yet in iTerm2's AlwaysAllowBackgroundImage. Empty
    list ⇒ already fully approved.

    Match by quoted entry to avoid substring false-matches (e.g. `note-01`
    matching `note-010` in some hypothetical future)."""
    paths = ["", *(str(CACHE_DIR / f"note-{i:02d}.png")
                   for i in range(1, NOTE_POOL_SIZE + 1)),
             *(str(p) for p in STATE_IMAGE_PATHS.values())]
    try:
        out = subprocess.run(
            ["defaults", "read", "com.googlecode.iterm2",
             "AlwaysAllowBackgroundImage"],
            capture_output=True, text=True, timeout=2,
        )
        existing = out.stdout if out.returncode == 0 else ""
    except Exception:
        existing = ""
    return [p for p in paths if f'"{p}"' not in existing]


def _pre_approve_iterm_paths() -> tuple[bool, list[str]]:
    """Pre-approve the pool slots and the bg-image-clear sentinel (empty path)
    in iTerm2's AlwaysAllowBackgroundImage array so SetBackgroundImageFile
    never prompts the user.

    Skipped (returns False) if iTerm2 is currently running, because iTerm2
    holds prefs in memory and overwrites the plist on quit — any writes here
    would be silently undone.
    """
    if _is_iterm_running():
        return False, []

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    added: list[str] = []
    for path in _bg_paths_needing_approval():
        try:
            r = subprocess.run(
                ["defaults", "write", "com.googlecode.iterm2",
                 "AlwaysAllowBackgroundImage", "-array-add", path],
                capture_output=True, timeout=2,
            )
            if r.returncode == 0:
                added.append(path)
        except Exception:
            pass

    return True, added


BEACON_PROFILE_GUID = "ec2933e2-0e56-4d96-9a63-245d5ec7c527"

# Non-paused logical states (BADGE-09 / -09a) each map to a dynamic profile.
# Paused is exempt — pause is an OSC overlay (RENDER-04, §6.6) on top of
# whichever profile is currently active. `blocked` and `blocked-idle` share
# the red palette but ship distinct watermarks (`!` vs `?`) so a scan across
# panes can separate "permission needed now" from softer idle prompts.
PROFILE_STATES = ("ready", "busy", "blocked", "blocked-idle")

# Static state images (BADGE-15). The blocked state ships a translucent `!`
# watermark for permission prompts — the highest-urgency case where Claude
# is gated on a human answer. The blocked-idle state ships a `?` for the
# softer idle_prompt case (often a false positive while a background tool
# is in flight). Other states ship no image (None) for now.
STATE_IMAGE_PATHS = {
    "blocked":      PLUGIN_ROOT / "iterm" / "images" / "blocked.png",
    "blocked-idle": PLUGIN_ROOT / "iterm" / "images" / "blocked-idle.png",
}


def install_dynamic_profile() -> tuple[bool, str]:
    """Write the base beacon profile and the per-status state profiles
    (BADGE-09: ready/busy/blocked/blocked-idle) into iTerm2's DynamicProfiles
    directory. iTerm2 watches the directory and reloads on change without
    restart.

    Each profile is written from a `.template` in `iterm/`, with these
    substitutions:
      __BEACON_SCRIPT__            — script path for non-interactive coprocess
                                     shells that can't see the user's `beacon`
                                     alias (base profile only).
      __BEACON_CACHE_DIR__         — so the `↖ web` and `↗ code` action shells
                                     don't have to derive it themselves (base
                                     profile only).
      __BEACON_BLOCKED_IMAGE__     — absolute path to the `!` watermark PNG
                                     for permission prompts (BADGE-15;
                                     blocked profile only).
      __BEACON_BLOCKED_IDLE_IMAGE__ — absolute path to the `?` watermark PNG
                                     for idle prompts (BADGE-15; blocked-idle
                                     profile only).

    Always rewrites — iTerm2 re-serializes dynamic profiles back to disk
    with its own formatting and any GUI-edited values, so a "content
    matches" short-circuit silently lets stale state win.
    """
    target_dir = Path.home() / "Library" / "Application Support" / "iTerm2" / "DynamicProfiles"
    beacon_script = str(PLUGIN_ROOT / "scripts" / "beacon")
    blocked_image = str(STATE_IMAGE_PATHS["blocked"])
    blocked_idle_image = str(STATE_IMAGE_PATHS["blocked-idle"])

    plans: list[tuple[Path, Path]] = [
        (PLUGIN_ROOT / "iterm" / "profile.json.template", target_dir / "beacon.json"),
    ]
    for state in PROFILE_STATES:
        plans.append((
            PLUGIN_ROOT / "iterm" / f"profile-{state}.json.template",
            target_dir / f"beacon-{state}.json",
        ))

    try:
        target_dir.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        return False, f"failed to create {target_dir}: {e}"

    written: list[Path] = []
    for template, target in plans:
        if not template.is_file():
            return False, f"profile template not found: {template}"
        content = (template.read_text()
                   .replace("__BEACON_SCRIPT__", beacon_script)
                   .replace("__BEACON_CACHE_DIR__", str(CACHE_DIR))
                   .replace("__BEACON_BLOCKED_IMAGE__", blocked_image)
                   .replace("__BEACON_BLOCKED_IDLE_IMAGE__", blocked_idle_image))
        try:
            target.write_text(content)
            written.append(target)
        except OSError as e:
            return False, f"failed to write {target}: {e}"

    # Sweep leftover profile JSONs from retired state profiles so iTerm2 stops
    # loading them. Without this an upgrade carries forward beacon-drifted.json
    # (or any future-retired state) as orphaned profile rows in the UI.
    for retired in ("beacon-drifted.json",):
        stale = target_dir / retired
        try:
            stale.unlink(missing_ok=True)
        except OSError:
            pass

    return True, f"wrote {len(written)} profile files to {target_dir}"


def _is_beacon_already_default() -> bool:
    try:
        out = subprocess.run(
            ["defaults", "read", "com.googlecode.iterm2", "Default Bookmark Guid"],
            capture_output=True, text=True, timeout=2,
        )
        return out.returncode == 0 and out.stdout.strip() == BEACON_PROFILE_GUID
    except Exception:
        return False


def _write_default_profile_now() -> None:
    """Write the default-profile pref. Caller is responsible for ensuring
    iTerm2 is not running (otherwise the prefs cache will overwrite this)."""
    r = subprocess.run(
        ["defaults", "write", "com.googlecode.iterm2",
         "Default Bookmark Guid", "-string", BEACON_PROFILE_GUID],
        capture_output=True, timeout=2,
    )
    if r.returncode != 0:
        sys.exit(f"defaults write failed (exit {r.returncode})")


def ensure_per_pane_bg_image():
    """Force iTerm2 to scope SetBackgroundImageFile to the pane, not the window.
    Required for the pause overlay to appear only in the paused pane."""
    try:
        out = subprocess.run(
            ["defaults", "read", "com.googlecode.iterm2", "PerPaneBackgroundImage"],
            capture_output=True, text=True, timeout=2,
        )
        if out.returncode == 0 and out.stdout.strip() == "1":
            return
    except Exception:
        pass
    try:
        subprocess.run(
            ["defaults", "write", "com.googlecode.iterm2",
             "PerPaneBackgroundImage", "-bool", "true"],
            capture_output=True, timeout=2,
        )
        sys.stderr.write(
            "beacon: enabled iTerm2 'Separate background images per pane' "
            "(restart iTerm2 for this to take effect in existing windows)\n"
        )
    except Exception:
        pass


# --- apply ---

def _engagement_marker_path() -> Path | None:
    """BADGE-14: per-pane marker. Keyed by raw ITERM_SESSION_ID — not the
    session hash — so the shell snippet can probe existence with a plain
    `[[ -e ... ]]` test, no SHA-1 in the prompt hot path."""
    iterm_id = os.environ.get("ITERM_SESSION_ID")
    if not iterm_id:
        return None
    return CACHE_DIR / f"engaged-{iterm_id}"


def place_engagement_marker() -> None:
    p = _engagement_marker_path()
    if not p:
        return
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.touch(exist_ok=True)
    except OSError:
        pass


def remove_engagement_marker() -> None:
    p = _engagement_marker_path()
    if not p:
        return
    try:
        p.unlink()
    except (FileNotFoundError, OSError):
        pass


def _logical_state_for(state: dict) -> str:
    """Resolve the logical color state per BADGE-09a precedence:
    `status == paused` > `pending_attention` > `status` — pause is the
    most explicit user intent, pending attention demands action, status
    reflects what hooks have observed.

    - `paused` (BADGE-10): de-emphasized, distinct from waiting so a
      parked session doesn't compete with one blocked on the user.
    - `pending_attention` → `blocked` (`!` watermark) for permission prompts,
      `blocked-idle` (`?`) for idle prompts. Both share the red palette but
      ship distinct glyphs so a scan separates "must answer now" from
      softer idle signals (often spurious during background tools)."""
    if state.get("status") == "paused":
        return "paused"
    if state.get("pending_attention"):
        return "blocked-idle" if state.get("pending_attention_type") == "idle" else "blocked"
    return STATUS_TO_BADGE_STATE.get(state["status"], "ready")


def apply(state: dict):
    s = state["status"]

    prev = read_state_json("resolved", {})

    # BADGE-14: marker presence is the shell snippet's engagement gate.
    place_engagement_marker()

    # Backup for non-zsh / remote shells where shell/beacon.zsh hasn't run.
    if not prev:
        _cli("badge-format", BADGE_FORMAT)

    # BADGE-09 + -09a / RENDER-04. Each non-paused logical state owns its
    # color/tab/bg-image atomically via SetProfile. `paused` has no profile
    # (PROFILE_STATES) — it is painted via OSC badge-color/tab-color, with or
    # without a note. A description (overlay) likewise paints via OSC so the
    # marginalia card lands on top of whatever profile is active; per-note bg
    # images can't live in a static profile (OVERLAY-01).
    logical = _logical_state_for(state)
    prev_logical = prev.get("logical_state")
    note_image = state.get("note_image")
    prev_note_image = prev.get("note_image")
    has_overlay = bool(state.get("description")) and bool(note_image)
    prev_has_overlay = bool(prev.get("description")) and bool(prev_note_image)

    use_osc = has_overlay or logical == "paused"
    prev_use_osc = prev_has_overlay or prev_logical == "paused"

    if use_osc:
        if logical != prev_logical or not prev_use_osc:
            hex_color = BADGE_COLOR_PALETTE.get(logical, BADGE_COLOR_PALETTE["paused"])
            _cli("badge-color", hex_color)
            _cli("tab-color", hex_color)
        if has_overlay and (note_image != prev_note_image or not prev_has_overlay):
            _cli("bg-image", note_image)
            # iTerm2 bg images render *behind* terminal text. Clearing the
            # visible viewport gives the card a clean canvas; scrollback is
            # preserved so the user can still scroll back to pre-overlay
            # history.
            _cli("clear-screen")
        elif prev_has_overlay and not has_overlay:
            # Dropped the card while staying in an OSC state (paused → paused
            # without a note): no SetProfile fires to wipe the bg image, so
            # clear it explicitly or the previous card lingers on screen.
            _cli("bg-image", "clear")
    elif logical != prev_logical or prev_use_osc:
        # Profile path: atomic SetProfile wipes any prior OSC overrides
        # (color, tab, bg image), so coming back from an overlay or from
        # paused needs no explicit cleanup.
        _cli("set-profile", f"beacon-{logical}")

    # BADGE-02 / -12: plugin is sole writer of beacon_project. First render
    # must publish or CLI engagement leaves the badge empty (the shell no
    # longer republishes from cwd). SessionStart's _publish_anchor also
    # publishes; the duplicate is harmless.
    project_text = state["project"]
    if prev.get("project") != project_text:
        _cli("uservar", "beacon_project", project_text)

    # BADGE-03: the user-var value carries its own ": " separator so an
    # empty task collapses the slot without leaving a trailing colon on
    # the badge.
    task_text = state["task"]
    if prev.get("task") != task_text:
        _cli("uservar", "beacon_task", f": {task_text}" if task_text else "")

    snapshot = {
        "project": state["project"], "project_provider": state["project_provider"],
        "task": state["task"], "task_provider": state["task_provider"],
        "status": s, "status_provider": state["status_provider"],
        "description": state.get("description", ""),
        "pending_attention": state.get("pending_attention", False),
        "pending_attention_type": state.get("pending_attention_type"),
        "note_image": note_image,
        "logical_state": logical,
    }
    write_state("resolved", json.dumps(snapshot, indent=2))


def render():
    ensure_initialized()
    state = resolve()
    if state.get("description"):
        state["note_image"] = read_state("note-image")
    apply(state)


# --- subcommands ---

def cmd_show(_args):
    state = resolve()
    rows = []
    for field in ("project", "task", "status"):
        value = state[field]
        provider = state[f"{field}_provider"]
        if value and provider and provider != "default":
            rows.append((field, value, provider))
    if state.get("description"):
        rows.append(("description", state["description"], None))
    if state.get("pending_attention"):
        rows.append(("attention", "pending", None))
    if not rows:
        return
    width = max(len(v) for _, v, _ in rows)
    for field, value, provider in rows:
        suffix = f"  ({provider})" if provider else ""
        print(f"{field+':':<12} {value:<{width}}{suffix}")


def _set_field(field: str, value: str):
    if field not in VALID_FIELDS:
        sys.exit(f"unknown field: {field}")
    if field == "status" and value not in VALID_STATUSES:
        sys.exit(f"invalid status: {value} (allowed: {sorted(VALID_STATUSES)})")
    write_state(f"override.{field}", value)


def cmd_set(args):
    field = args.field
    _set_field(field, " ".join(args.value))
    if field == "status":
        # `set status <value>` is the orthogonal-field form. It carries no
        # description argument, so any previously-set description belongs
        # to an earlier status and is no longer relevant — drop it.
        _clear_description()
    render()


def cmd_task(args):
    _set_field("task", " ".join(args.value))
    render()


def cmd_project(args):
    _set_field("project", " ".join(args.value))
    render()


def cmd_clear(args):
    if args.field:
        remove_state(f"override.{args.field}")
        if args.field == "status":
            _clear_description()
        render()
        return

    # Full clear (BADGE-14 disengagement). Skipping render() at the end is
    # deliberate — render() would re-place the engagement marker.
    for f in VALID_FIELDS:
        remove_state(f"override.{f}")
    _clear_description()
    # Drop any sticky red markers — if the session is genuinely blocked,
    # the next Notification re-asserts both.
    remove_state("pending-attention")
    if read_state("signal.status") == "waiting":
        remove_state("signal.status")
    remove_engagement_marker()
    remove_state("resolved")
    _cli("uservar", "beacon_project", "")
    _cli("uservar", "beacon_task", "")
    _cli("set-profile", "beacon")


def _clear_description() -> None:
    """Drop the description text and the rendered note-image reference. The
    image file itself is part of the LRU pool (OVERLAY-03) and shared across
    sessions; leave it on disk so iTerm2's bg-image trust prompt doesn't
    re-fire on the next paint."""
    remove_state("description")
    remove_state("note-image")


def _label_for_status(status: str) -> str:
    """Uppercase status label for the marginalia card header. The compose
    layer renders this as the `PAUSED` / `WAITING` / `WORKING` / `IDLE`
    chip in pink at the top of the card."""
    return (status or "paused").upper()


def _apply_status(value: str, description: str) -> None:
    """Set `override.status = value` and the optional description. For
    `paused`, snapshot the current resolved project + task so the badge
    keeps its identity while the session is parked (STATE-03). For other
    values (e.g. `waiting "bg refresh"`), don't snapshot — the user is
    labeling current state, not parking.

    Renders the marginalia card if a description was provided."""
    if value == "paused":
        # Drop any prior overrides on project/task so we re-snapshot from
        # the resolved (live) values rather than stale entries.
        remove_state("override.project")
        remove_state("override.task")
        state = resolve()
        for field in ("project", "task"):
            if state[f"{field}_provider"] != "default" and state[field]:
                write_state(f"override.{field}", state[field])
    write_state("override.status", value)
    _clear_description()
    if description:
        write_state("description", description)
        ensure_initialized()
        path = render_note_card(_label_for_status(value), description)
        if path:
            write_state("note-image", path)


def cmd_status(args):
    description = " ".join(args.description).strip() if args.description else ""
    _apply_status(args.value, description)
    render()


def cmd_pause(args):
    note = " ".join(args.note).strip() if args.note else ""
    _apply_status("paused", note)
    render()


def cmd_resume(_args):
    for f in VALID_FIELDS:
        remove_state(f"override.{f}")
    _clear_description()
    render()


def _last_assistant_text() -> str | None:
    """Tail of the most recent assistant message text in this session's
    transcript. Returns None when no transcript is known or no assistant
    text exists yet. The transcript is JSONL — one entry per line, each a
    Claude Code conversation event. Assistant entries carry message.content
    as either a string or a list of content blocks; we want the trailing
    text block of the last assistant entry that has any text (skipping
    pure tool_use turns)."""
    path = read_state("transcript_path")
    if not path:
        return None
    p = Path(path)
    if not p.is_file():
        return None
    try:
        last_text = None
        with p.open() as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except Exception:
                    continue
                if obj.get("type") != "assistant":
                    continue
                content = (obj.get("message") or {}).get("content")
                if isinstance(content, str):
                    if content.strip():
                        last_text = content
                elif isinstance(content, list):
                    for block in content:
                        if isinstance(block, dict) and block.get("type") == "text":
                            t = (block.get("text") or "").strip()
                            if t:
                                last_text = t
        return last_text
    except Exception:
        return None


def _looks_idle(text: str | None) -> bool:
    if not text:
        return False
    head = text.lstrip().splitlines()[0] if text.strip() else ""
    return bool(IDLE_LOOK_RE.match(head))


def _recover_stale_red() -> None:
    """Stop / PreToolUse / UserPromptSubmit are responsible for clearing
    pending-attention and signal.status=waiting (HOOK-03b). When one of
    those hooks didn't fire — typically because the prior Claude session
    was killed mid-permission-prompt — the markers outlive the actual
    blocked state. Peek at the transcript: if the last assistant message
    reads as idle ("Ready..."), drop the stale markers so resolve() and
    apply() don't render red against a session that's actually idle."""
    if not (_state_path("pending-attention").exists()
            or read_state("signal.status") == "waiting"):
        return
    if not _looks_idle(_last_assistant_text()):
        return
    remove_state("pending-attention")
    if read_state("signal.status") == "waiting":
        remove_state("signal.status")


def _wipe_session_for_fresh_start() -> None:
    """Targeted state wipe so a freshly-started Claude (or `/recipe`,
    `/clear`) in a reused iTerm pane doesn't inherit signals from a prior
    tenant. Keeps `claude_session_id` (just written by the caller)."""
    for f in VALID_FIELDS:
        remove_state(f"override.{f}")
    remove_state("signal.status")
    remove_state("pending-attention")
    _clear_description()


def cmd_reset(_args):
    sh = session_hash()
    for p in STATE_DIR.glob(f"{sh}.*"):
        try:
            p.unlink()
        except OSError:
            pass
    # Don't delete pool slots — they're shared and persisting them keeps
    # iTerm2's bg-image trust intact across sessions.
    _cli("clear")


def cmd_render(_args):
    render()


def _is_active(line: str) -> bool:
    """A zshrc line is active if it isn't a comment and isn't blank."""
    stripped = line.strip()
    return bool(stripped) and not stripped.startswith("#")


def _has_active(content: str, needle: str) -> bool:
    return any(needle in line for line in content.splitlines() if _is_active(line))


def _install_completions(print_only: bool = False) -> None:
    if print_only:
        sys.stdout.write(ZSH_COMPLETION)
        return

    target_dir = Path.home() / ".zsh" / "completions"
    target = target_dir / "_beacon"
    target_dir.mkdir(parents=True, exist_ok=True)
    target.write_text(ZSH_COMPLETION)
    print(f"  ✓ wrote {target}")

    zshrc = Path.home() / ".zshrc"
    fpath_line = "fpath=(~/.zsh/completions $fpath)"

    if not zshrc.exists():
        print(f"  ! {zshrc} doesn't exist; create it and add:")
        print(f"      {fpath_line}")
        print("      autoload -Uz compinit && compinit")
        return

    content = zshrc.read_text()

    # Only consider uncommented lines — a stale `# fpath=…` shouldn't pass.
    if _has_active(content, ".zsh/completions"):
        print(f"  ✓ {zshrc} already configures fpath")
        return

    if _has_active(content, "compinit"):
        lines = content.splitlines(keepends=True)
        out_lines = []
        inserted = False
        for line in lines:
            if not inserted and "compinit" in line and _is_active(line):
                indent = line[: len(line) - len(line.lstrip())]
                out_lines.append(f"{indent}{fpath_line}\n")
                inserted = True
            out_lines.append(line)
        zshrc.write_text("".join(out_lines))
        print(f"  ✓ inserted fpath line before compinit in {zshrc}")
    else:
        with zshrc.open("a") as f:
            if not content.endswith("\n"):
                f.write("\n")
            f.write(f"{fpath_line}\nautoload -Uz compinit && compinit\n")
        print(f"  ✓ appended fpath + compinit to {zshrc}")


_SHELL_SENTINEL = "# beacon: project · branch · status badging"


def _install_shell_source() -> None:
    # Upgrade-safe: if the marketplace bumps the plugin version, the cache path
    # changes. Detect any prior beacon source line via the sentinel comment and
    # rewrite it to point at this PLUGIN_ROOT.
    snippet = PLUGIN_ROOT / "shell" / "beacon.zsh"
    if not snippet.is_file():
        print(f"  ! shell snippet not found at {snippet}")
        return

    zshrc = Path.home() / ".zshrc"
    source_line = f'source "{snippet}"  {_SHELL_SENTINEL}'

    if not zshrc.exists():
        print(f"  ! {zshrc} doesn't exist; create it and add:")
        print(f"      {source_line}")
        return

    content = zshrc.read_text()
    lines = content.splitlines(keepends=True)
    existing_idx = next(
        (i for i, line in enumerate(lines)
         if _SHELL_SENTINEL in line and _is_active(line)),
        None,
    )

    if existing_idx is not None:
        if str(snippet) in lines[existing_idx]:
            print(f"  ✓ {zshrc} already sources beacon.zsh from this path")
            return
        old = lines[existing_idx].rstrip("\n")
        lines[existing_idx] = source_line + "\n"
        zshrc.write_text("".join(lines))
        print(f"  ✓ updated source line in {zshrc} (path changed)")
        print(f"      old: {old}")
        print(f"      new: {source_line}")
        return

    with zshrc.open("a") as f:
        if not content.endswith("\n"):
            f.write("\n")
        f.write(f"\n{source_line}\n")
    print(f"  ✓ appended source line to {zshrc}")


def cmd_completions(args):
    if args.shell != "zsh":
        sys.exit(f"only zsh is supported (got: {args.shell})")
    _install_completions(print_only=args.print_only)
    if not args.print_only:
        print("restart your shell (or run 'exec zsh') to activate completions")


def _path_contains(target_dir: Path) -> bool:
    target = target_dir.resolve()
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry:
            continue
        try:
            if Path(entry).expanduser().resolve() == target:
                return True
        except OSError:
            continue
    return False


def _install_cli_wrapper(target_dir: Path | None = None) -> Path:
    # Drops a wrapper at <target_dir>/beacon that execs the source script.
    # The source path is hardcoded into the wrapper at install time — plugin
    # upgrades don't auto-refresh it. The plugin's SessionStart hook
    # (hooks/cli-freshness.sh) compares `beacon --version` against
    # plugin.json#version and nudges the user to re-run install-cli on drift.
    source = (PLUGIN_ROOT / "scripts" / "beacon").resolve()
    target_dir = target_dir or (Path.home() / ".local" / "bin")
    target = target_dir / "beacon"
    target_dir.mkdir(parents=True, exist_ok=True)

    wrapper = f'#!/usr/bin/env bash\nexec python3 "{source}" "$@"\n'

    if target.exists() and target.read_text() == wrapper:
        print(f"  ✓ already installed: {target} -> {source}")
    else:
        target.write_text(wrapper)
        target.chmod(0o755)
        print(f"  ✓ wrote {target} -> {source}")

    if not _path_contains(target_dir):
        print(f"  ! {target_dir} is not on $PATH — add it to your shell rc")

    return target


def cmd_install_cli(args):
    target_dir = Path(args.dir).expanduser() if args.dir else None
    _install_cli_wrapper(target_dir)
    _install_completions()


def cmd_install(_args):
    print("beacon install")
    print("==============")
    print()
    deferred: list[str] = []

    print("[1/7] shell integration")
    _install_shell_source()
    print()
    print("[2/7] CLI wrapper on PATH")
    _install_cli_wrapper()
    print()
    print("[3/7] tab completion")
    _install_completions()
    print()
    print("[4/7] iTerm2 'separate background images per pane'")
    ensure_per_pane_bg_image()
    print("  ✓ defaults set (PerPaneBackgroundImage = true)")
    print()
    print("[5/7] iTerm2 bg-image trust pre-approval")
    ok, added = _pre_approve_iterm_paths()
    if not ok:
        for line in (
            "  ! DEFERRED — iTerm2 is currently running.",
            "    iTerm2 caches prefs in memory and overwrites the plist on quit,",
            "    so this write must happen with iTerm2 fully exited. Without it,",
            "    iTerm2 prompts once per pool slot the first time it's used.",
        ):
            print(_color("33", line))
        deferred.append("[5/7] bg-image trust pre-approval")
    elif added:
        print(f"  ✓ added {len(added)} entries to AlwaysAllowBackgroundImage:")
        for p in added:
            print(f"      {p or '(empty — bg-image clear)'}")
    else:
        print("  ✓ all bg-image paths already pre-approved")
    print()
    print("[6/7] iTerm2 dynamic profile (status bar layout)")
    _, msg = install_dynamic_profile()
    print(f"  ✓ {msg}")
    print()
    print("[7/7] iTerm2 default profile")
    if _is_beacon_already_default():
        print("  ✓ 'beacon' is already the default profile")
    else:
        for line in (
            "  ! DEFERRED — requires iTerm2 quit (caches prefs in memory).",
            "    Set via: iTerm2 → Settings → Profiles → 'beacon' → Other Actions ▾ → Set as Default",
        ):
            print(_color("33", line))
        deferred.append("[7/7] default profile")
    print()
    if deferred:
        label = "deferred step" if len(deferred) == 1 else "deferred steps"
        print(_color("1;33", f"ACTION REQUIRED — {label}:"))
        for s in deferred:
            print(_color("33", f"  • {s}"))
        print()
        tail = "it" if len(deferred) == 1 else "all of them at once"
        print(_color("1;33",
            f"  Run `beacon exclusive-configuration` to apply {tail}."))
        print(_color("33",
            "  It confirms before quitting iTerm2, applies the deferred writes"))
        print(_color("33",
            "  while iTerm2 is dead, and relaunches it."))
    else:
        print("Next: exec zsh, then open a fresh iTerm2 tab.")


def cmd_exclusive_configuration(args):
    """Apply iTerm2 prefs that require iTerm2 to be fully quit. iTerm2 caches
    prefs in memory and overwrites the plist on quit, so the writes only stick
    when iTerm2 is not running.

    Currently covers:
      - bg-image trust (AlwaysAllowBackgroundImage array — pool slots + the
        bg-image-clear sentinel)
      - default profile (Default Bookmark Guid → beacon)

    Two execution paths:
      - iTerm2 not running: do the writes directly, then relaunch.
      - iTerm2 running: spawn a detached helper that polls for iTerm2 to
        fully exit, then re-invokes this same command (which then takes
        the not-running path). Send `quit` via AppleScript. The detached
        helper survives our process being SIGHUP'd by iTerm2.
    """
    needs_default = not _is_beacon_already_default()
    missing_bg = _bg_paths_needing_approval()

    if not needs_default and not missing_bg:
        print("nothing to do — already configured")
        return

    if not _is_iterm_running():
        ok, added = _pre_approve_iterm_paths()
        if added:
            print(f"pre-approved {len(added)} bg-image path(s):")
            for p in added:
                print(f"  {p or '(empty — bg-image clear)'}")
        if needs_default:
            _write_default_profile_now()
            print("set 'beacon' as default profile")
        subprocess.run(["open", "-a", "iTerm"], capture_output=True, timeout=5)
        return

    if not args.yes:
        print("This will quit iTerm2 (closing all windows and panes including this one)")
        print("and relaunch it after applying:")
        if needs_default:
            print("  - default profile → 'beacon'")
        if missing_bg:
            print(f"  - bg-image trust for {len(missing_bg)} path(s)")
        try:
            with open("/dev/tty") as tty:
                sys.stdout.write("Continue? [y/N] ")
                sys.stdout.flush()
                response = tty.readline().strip().lower()
        except OSError:
            sys.exit("no controlling tty; re-run with --yes to skip the prompt")
        if response not in ("y", "yes"):
            print("aborted")
            return

    log_path = Path(tempfile.gettempdir()) / "beacon-exclusive-configuration.log"
    self_path = Path(__file__).resolve()
    # Re-invoke ourselves once iTerm2 is dead — single source of truth for the
    # writes. The detached process survives our SIGHUP because of nohup +
    # start_new_session.
    helper = (
        f"while pgrep -x iTerm2 >/dev/null; do sleep 0.5; done; "
        f"python3 {shlex.quote(str(self_path))} exclusive-configuration --yes"
    )
    with open(log_path, "w") as log:
        subprocess.Popen(
            ["nohup", "zsh", "-c", helper],
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    print(f"helper logged to {log_path}")
    print("quitting iTerm2 — it will relaunch with the new configuration")
    subprocess.run(
        ["osascript", "-e", 'tell application "iTerm" to quit'],
        capture_output=True, timeout=10,
    )


def cmd_hook(args):
    payload = {}
    try:
        raw = sys.stdin.read()
        if raw.strip():
            payload = json.loads(raw)
    except Exception:
        payload = {}
    event = args.event

    # Capture the Claude session ID for cross-session handoff. It's stable
    # for the lifetime of the Claude conversation; a colleague can resume it
    # via `claude --resume <id>`.
    claude_sid = payload.get("session_id") or ""
    if claude_sid:
        write_state("claude_session_id", claude_sid)
    transcript_path = payload.get("transcript_path") or ""
    if transcript_path:
        write_state("transcript_path", transcript_path)

    if event == "SessionStart":
        cwd_str = payload.get("cwd") or os.getcwd()
        # State files key on ITERM_SESSION_ID, which is the iTerm pane and
        # outlives any single Claude session. A fresh `claude` invocation
        # (source=startup) or `/clear` (source=clear) in a pane that hosted
        # a prior session would otherwise inherit that session's stale
        # `signal.status=waiting` / `pending-attention` and render red. A
        # resumed session (source=resume) continues prior state by design.
        source = (payload.get("source") or "").lower()
        if source != "resume":
            _wipe_session_for_fresh_start()
        _publish_anchor(Path(cwd_str))

    elif event == "UserPromptSubmit":
        prompt_text = (payload.get("prompt") or "").strip()
        if prompt_text and PAUSE_RE.match(prompt_text):
            # NL pause-intent: the prompt itself becomes the description.
            # Don't touch signal.status — _apply_status writes override.status=paused.
            _apply_status("paused", prompt_text)
        else:
            if prompt_text and FRESH_START_RE.match(prompt_text):
                # In-session commands like /recipe re-bootstrap context;
                # treat them like SessionStart non-resume and drop stale
                # signals before the prompt lands.
                _wipe_session_for_fresh_start()
            elif read_state("override.status") == "paused":
                # STATE-04 auto-resume: a returning prompt clears the paused
                # override and its description. Other user-set statuses
                # (waiting "bg refresh") are deliberate labels and survive
                # prompt submission.
                remove_state("override.status")
                _clear_description()
            write_state("signal.status", "working")
        # The user just submitted, so any pending Notification is resolved.
        remove_state("pending-attention")

    elif event == "Stop":
        if not payload.get("stop_hook_active"):
            # HOOK-02: a finished turn is calm, not blocking. Red is reserved
            # for active Notification (permission/idle prompt) so glancing
            # across many panes distinguishes calm sessions from sessions
            # truly waiting on user input.
            write_state("signal.status", "idle")
        # Turn ended: any pending permission/idle notification is no longer in flight.
        remove_state("pending-attention")
        # Refresh chips that may have drifted during the turn (branch the
        # agent created, tack context the user set). The shell's precmd
        # can't run while Claude holds the prompt, so the plugin covers
        # the gap once per turn. HOOK-08b: resolve from the SessionStart
        # anchor cwd (persisted by HOOK-08), not this turn's payload cwd —
        # the anchor is fixed for the session even as chip values evolve.
        cwd_str = read_state("anchor.cwd") or payload.get("cwd") or os.getcwd()
        _publish_chips(Path(cwd_str))

    elif event == "Notification":
        write_state("signal.status", "waiting")
        # Sticky marker: takes precedence over a stale PostToolUse working signal
        # that may arrive after this Notification due to out-of-order delivery.
        # The stored value carries the prompt type so the renderer picks the
        # right watermark (BADGE-15): `permission` → `!`, `idle` → `?`.
        attention_type = getattr(args, "type", None) or "permission"
        write_state("pending-attention", attention_type)

    elif event == "PreToolUse":
        # Tool activity means the agent is working, not waiting. This
        # transitions out of `waiting` after a permission_prompt Notification
        # is granted — without this, the badge would stay red for the rest of
        # the turn.
        write_state("signal.status", "working")
        # PreToolUse fires when a tool is starting — past any permission gate.
        # Clear the sticky marker so the badge can flip back to working.
        remove_state("pending-attention")

    elif event == "PostToolUse":
        # Re-assert working between tool calls — a tool just returned and the
        # agent is back to thinking, even if no further matching PreToolUse
        # fires before the next Notification or Stop. Deliberately does NOT
        # clear pending-attention: a late PostToolUse arriving after a fresh
        # Notification must not undo the sticky waiting marker.
        write_state("signal.status", "working")

    render()


# --- argparse ---

def main(argv=None):
    parser = argparse.ArgumentParser(prog="beacon", description=__doc__)
    parser.add_argument("--version", "-v", action="version",
                        version=f"beacon {_plugin_version()}")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("show", help="show resolved signal state")

    sp = sub.add_parser("set", help="set an override")
    sp.add_argument("field", choices=list(VALID_FIELDS))
    sp.add_argument("value", nargs="+")

    sp = sub.add_parser("task", help="set task override")
    sp.add_argument("value", nargs="+")

    sp = sub.add_parser(
        "status",
        help="set status override with optional description",
    )
    sp.add_argument("value", choices=sorted(VALID_STATUSES))
    sp.add_argument("description", nargs="*")

    sp = sub.add_parser("project", help="set project override")
    sp.add_argument("value", nargs="+")

    sp = sub.add_parser("clear", help="clear overrides")
    sp.add_argument("field", nargs="?", choices=list(VALID_FIELDS))

    sp = sub.add_parser("pause", help="set status=paused with optional description")
    sp.add_argument("note", nargs="*")

    sub.add_parser("resume", help="clear all overrides (full reset to provider chain)")
    sub.add_parser("reset", help="clear all session state")
    sub.add_parser("render", help="re-render current state")

    sp = sub.add_parser("hook", help="(internal) handle a Claude Code hook event")
    sp.add_argument("event")
    sp.add_argument("--type", choices=["permission", "idle"], default=None,
                    help="Notification prompt subtype (set per-matcher in hooks.json)")

    sp = sub.add_parser("completions", help="install or print shell completions")
    sp.add_argument("shell", choices=["zsh"], nargs="?", default="zsh")
    sp.add_argument("--print", dest="print_only", action="store_true",
                    help="print the script to stdout instead of installing")

    sub.add_parser("install", help="run all install steps (shell, wrapper, completions, profile)")

    sp = sub.add_parser("install-cli",
                        help="install or refresh the beacon wrapper at ~/.local/bin/beacon (+ completions)")
    sp.add_argument("--dir", default=None,
                    help="directory to install into (default: ~/.local/bin)")

    sp = sub.add_parser("exclusive-configuration",
                        help="orchestrate iTerm2 quit + relaunch to apply prefs that require iTerm2 to be quit (bg-image trust, default profile)")
    sp.add_argument("--yes", "-y", action="store_true",
                    help="skip the confirmation prompt")

    sub.add_parser("resolve-url", help="(internal) print resolved url+label as TAB-separated text")

    sub.add_parser("copy-url", help="copy the resolved URL to the clipboard via pbcopy")

    sub.add_parser("open-url", help="open the resolved URL in the default browser via `open`")

    sub.add_parser("json", help="print the resolved session state as JSON")

    sub.add_parser("data-dir", help="print the resolved data dir (consumed by shell/beacon.zsh on source)")

    args = parser.parse_args(argv)

    handlers = {
        "show": cmd_show, "set": cmd_set, "task": cmd_task,
        "status": cmd_status, "project": cmd_project, "clear": cmd_clear,
        "pause": cmd_pause, "resume": cmd_resume, "reset": cmd_reset,
        "render": cmd_render, "hook": cmd_hook,
        "completions": cmd_completions, "install": cmd_install,
        "install-cli": cmd_install_cli,
        "exclusive-configuration": cmd_exclusive_configuration,
        "resolve-url": cmd_resolve_url, "copy-url": cmd_copy_url,
        "open-url": cmd_open_url, "json": cmd_json,
        "data-dir": cmd_data_dir,
    }
    if not args.cmd:
        return cmd_show(args)
    handlers[args.cmd](args)


if __name__ == "__main__":
    main()
