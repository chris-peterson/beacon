#!/usr/bin/env python3
"""beacon — at-a-glance session awareness for Claude Code in iTerm2.

Resolves a session's signals — `project` and `task` via chain-of-responsibility
providers, plus the two independent state axes `mode` and `activity` — then
invokes bin/beacon-iterm to surface them. The CLI is the only writer to iTerm2.

`activity` (idle / working / waiting) is what the hooks observe, written several
times a turn. `mode` (pause / release / retro / done, absent = dev) is
what a user or skill declares, and carries an optional note as a tuple with it:
`pause [<note>]`. The two resolve independently, so entering a mode no longer
discards the one signal meant to interrupt you.
"""
from __future__ import annotations

import argparse
import copy
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import textwrap
import time
import unicodedata
from datetime import datetime, timezone
from pathlib import Path

# --- paths and identity ---

PLUGIN_ROOT = Path(os.environ.get("CLAUDE_PLUGIN_ROOT") or Path(__file__).resolve().parent.parent)


def _plugin_version() -> str:
    """Read the plugin's version from .claude-plugin/plugin.json. Single source
    of truth — never hardcode a version constant in code."""
    return json.loads((PLUGIN_ROOT / ".claude-plugin" / "plugin.json").read_text())["version"]


def _data_dir_pointer() -> Path:
    """Where a hook records the data dir Claude Code handed it, so the contexts
    that get no `CLAUDE_PLUGIN_DATA` can read the answer instead of guessing at
    it. Sits beside the user config (`_config_file`); the XDG base is recomputed
    here because this runs at module-load time, before that helper exists."""
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "beacon" / "data-dir"


def _read_data_dir_pointer() -> Path | None:
    """The recorded data dir, or None when nothing usable is recorded. Empty,
    unreadable, or naming a directory that no longer exists all read as absent:
    the PLUGIN_ROOT derivation still lands somewhere usable, where a dead pointer
    would strand every env-less context on a path nothing writes — the failure
    this whole resolution exists to prevent. Raising is not an option either; it
    would take down every invocation in the session."""
    try:
        recorded = _data_dir_pointer().read_text().strip()
    except (FileNotFoundError, OSError):
        return None
    if not recorded:
        return None
    path = Path(recorded)
    return path if path.is_dir() else None


def _record_data_dir(resolved: str) -> None:
    """Stamp the data dir a hook was handed, so the env-less contexts converge on
    it. Written only when it changed: this runs on every hook, and the common
    case is a value already correct. Creates the directory it records, so a
    prompt reading the pointer between this write and the hook's first
    `write_state` doesn't see it as the dead path above."""
    if _read_data_dir_pointer() == Path(resolved):
        return
    Path(resolved).mkdir(parents=True, exist_ok=True)
    pointer = _data_dir_pointer()
    pointer.parent.mkdir(parents=True, exist_ok=True)
    pointer.write_text(f"{resolved}\n")


def _default_data_dir() -> Path:
    """The data dir for an invocation Claude Code gave no `CLAUDE_PLUGIN_DATA` —
    slash commands, the on-PATH wrapper, the serve service. Without convergence
    those contexts write to a different directory than hooks read from and every
    state change is invisible across them, which is what a `wip` that can't see
    a live session looks like.

    The recorded pointer (`_data_dir_pointer`, stamped by the last hook that ran)
    is the authority, because only a hook is *told* which install is loaded.
    Absent one — a fresh machine where `install` runs before any hook — derive it
    from PLUGIN_ROOT the way Claude Code names the directory itself: a plugin
    under `plugins/cache/<marketplace>/<plugin>/<version>` is
    `<plugin>-<marketplace>`, and a plugin root anywhere else was loaded from a
    local directory, which Claude Code buckets as `<plugin>-inline`."""
    recorded = _read_data_dir_pointer()
    if recorded:
        return recorded
    base = Path.home() / ".claude" / "plugins"
    try:
        rel = PLUGIN_ROOT.relative_to(base / "cache")
        return base / "data" / f"{rel.parts[1]}-{rel.parts[0]}"
    except (ValueError, IndexError):
        return base / "data" / f"{PLUGIN_ROOT.name}-inline"


DATA_DIR = Path(os.environ.get("CLAUDE_PLUGIN_DATA") or str(_default_data_dir()))
STATE_DIR = DATA_DIR / "state"
CACHE_DIR = DATA_DIR / "cache"

BEACON_ITERM = PLUGIN_ROOT / "bin" / "beacon-iterm"
DASHBOARD_HTML = PLUGIN_ROOT / "dashboard" / "index.html"


# Set by the global --color flag (always/never); None means auto-detect.
_COLOR_OVERRIDE: bool | None = None


def _color_enabled() -> bool:
    """Color on when stdout is a TTY, overridable so wrappers that pipe
    stdout (e.g. `watch`, which hides the TTY behind a pipe) can still get
    color. Precedence: the --color flag (_COLOR_OVERRIDE) wins, then the
    de-facto env-var standard (NO_COLOR forces off, FORCE_COLOR /
    CLICOLOR_FORCE force on), then stdout.isatty()."""
    if _COLOR_OVERRIDE is not None:
        return _COLOR_OVERRIDE
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("FORCE_COLOR") or os.environ.get("CLICOLOR_FORCE"):
        return True
    return sys.stdout.isatty()


def _color(code: str, s: str) -> str:
    """Wrap `s` in an ANSI SGR sequence when color is enabled; passthrough
    otherwise so logs and pipes stay clean."""
    return f"\x1b[{code}m{s}\x1b[0m" if _color_enabled() else s


DEFAULT_BRANCHES = {"main", "master", "develop", "trunk", "HEAD"}

PROJECT_MARKERS = [".git", "package.json", "Cargo.toml", "pyproject.toml",
                   "go.mod", ".hg", "pom.xml", "Gemfile"]

# Where a project keeps its favicon/icon (PROV-08), most-specific first. SVG
# wins over raster for crispness; docs/ and the web framework public roots are
# the conventional homes. Surfaced in the fleet view to distinguish work
# streams visually — recall context only, never painted on a pane.
ICON_CANDIDATES = [
    "docs/favicon.svg", "docs/favicon.png", "docs/favicon.ico",
    "favicon.svg", "favicon.png", "favicon.ico",
    "public/favicon.svg", "public/favicon.ico", "public/favicon.png",
    "static/favicon.svg", "static/favicon.ico", "static/favicon.png",
    "app/favicon.ico",
    "assets/favicon.svg", "assets/favicon.png",
    ".github/logo.png",
    "icon.svg", "icon.png", "logo.svg", "logo.png",
]

# Extensions the /icon route (WIP-08) will stream, mapped to their content
# type. Doubles as the allowlist: a resolved icon path with any other suffix
# is refused, so the loopback route can't be steered into serving arbitrary
# files (e.g. a user override pointing at ~/.ssh/id_rsa).
ICON_CONTENT_TYPES = {
    ".svg": "image/svg+xml",
    ".png": "image/png",
    ".ico": "image/x-icon",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".gif": "image/gif",
    ".webp": "image/webp",
}

# Slash commands that should reset stale per-session state when invoked
# mid-session. `/recipe` re-bootstraps a session from scratch (it loads a
# playbook), so signals from the prior task — pending attention, a stale
# user-set status, lingering overrides — would otherwise contaminate the
# new context. SessionStart already covers fresh-launch and `/clear`; this
# catches the in-session commands Claude Code does not surface as a hook
# event.
FRESH_START_COMMANDS = ("recipe",)
FRESH_START_RE = re.compile(
    r"^\s*/(?:" + "|".join(FRESH_START_COMMANDS) + r")\b",
    re.IGNORECASE,
)

# Last-assistant-text idle pattern. When pending-attention or `activity =
# waiting` would paint the tab red but the transcript shows Claude's most recent
# reply was an idle "Ready..." (final, awaiting-user message), the markers are
# stale (the prior Stop hook never fired or arrived after the next session
# reused the pane). The heuristic forgives the missing Stop and clears them.
IDLE_LOOK_RE = re.compile(r"^\s*ready\b", re.IGNORECASE)

# Harness-injected prompts that aren't a human turn: a finished background task
# waking the agent (<task-notification>), an out-of-band <system-reminder>, and
# the like. They all arrive on UserPromptSubmit wrapped in an angle-bracket tag,
# and a genuine human turn is prose or a /slash-command — never a leading tag
# (slash commands reach the hook as plain "/cmd" text, per FRESH_START_RE). So
# matching any leading XML-style tag, rather than a fixed allowlist, drops the
# raw wrapper from latest_turn (WIP-11) and covers wrappers added later too.
# Anchored at the start so a real prompt that merely *ends* with a trailing
# reminder still counts as a turn.
SYNTHETIC_PROMPT_RE = re.compile(r"^\s*<[a-z][a-z0-9-]*>")

# The two axes a session's state resolves on, independently (RES-06). They were
# one field until 2.5.0, merged by a provider chain that let a declared mode
# discard observed activity — so a releasing session could not report that it was
# blocked on the user, the one signal meant to interrupt.
#
# activity is what the hooks observe and is written several times a turn; mode is
# what a user or skill declares and is rare (~4% of rendered states). That ratio
# is why they take the tab surfaces they do: activity paints the tab *color*,
# always present; mode paints the tab *glyph*, absent by default (MODE_SPECS).
# The activity values, single-sourced from the color mapping below rather than
# listed twice — a value in one and not the other resolves to a default silently.
DEFAULT_ACTIVITY = "idle"

# The absence of a mode. `dev` is not stored — it *is* the empty mode file — so
# it names the default in argument lists and reads back out of resolve(), and
# `beacon status dev` is how you leave a mode. The modes themselves are the keys
# of MODE_SPECS below, which is also where MODES comes from.
DEV_MODE = "dev"

# Modes that auto-clear on the next prompt (STATE-04). The others are
# deliberate declarations that persist until explicitly left.
AUTO_RESUME_MODES = {"pause"}

# Overrides remain only where a signal has a real provider chain beneath them,
# so the `override.` prefix still distinguishes a tier from its alternatives.
# `url` and `icon` had one each and no live session in three months carried
# either, so both retired in 2.5.0 (OVR-01 / OVR-05).
VALID_FIELDS = ("project", "task")

# Shell-native completion script — installed by `beacon completions zsh`.
ZSH_COMPLETION = r"""#compdef beacon

_beacon_modes()  { compadd dev pause release retro done }
_beacon_fields() { compadd project task }

_beacon() {
  local -a commands=(
    'show:show resolved signals'
    'set:set an override (project|task)'
    'task:set task override'
    'status:enter a mode with an optional note, or dev to leave one'
    'project:set project override'
    'clear:clear one or all overrides'
    'pause:enter pause mode with an optional note'
    'release:enter release mode (ship-it flow in progress) with an optional note'
    'retro:enter retro mode (post-work follow-up) with an optional note'
    'done:enter done mode (session complete, ready to hand off) with an optional note'
    'resume:drop the overrides and leave any mode'
    'reset:clear all per-session state'
    'render:re-render current state'
    'wip:list active work streams across all beacon sessions'
    'watch:live, person-facing work-stream view (recency feed; q to quit)'
    'serve:serve the wip payload over localhost, or manage the always-on unit'
    'prune:remove per-session state for long-idle sessions'
    'forget:remove per-session state for one session, by its per-pane hash'
    'drop:remove one deliverable from the status-line row'
    'export:emit a lossless JSON backup of all per-session state'
    'import:restore per-session state from a beacon export file'
    'completions:install or print shell completions'
    'install:run all install steps (wrapper, completions, + iTerm2 adapter if present)'
    'refresh-iterm-profiles:re-render the iTerm2 dynamic profiles from config'
    'copy-url:copy the resolved URL to the clipboard'
    'open-url:open the resolved URL in the default browser'
    'open-code:open a directory in the configured editor'
    'json:print the resolved session state as JSON'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  local command="${words[2]}"
  case "$command" in
    set)
      case "$CURRENT" in
        3) _beacon_fields ;;
        4) _message 'value' ;;
      esac
      ;;
    status)
      case "$CURRENT" in
        3) _beacon_modes ;;
        4) _message 'note (optional)' ;;
      esac
      ;;
    task|project) (( CURRENT == 3 )) && _message 'value' ;;
    clear)
      (( CURRENT == 3 )) && _beacon_fields
      ;;
    pause|release|retro|done)
      (( CURRENT == 3 )) && _message 'note (optional)'
      ;;
    wip)
      compadd -- --json --since --all
      ;;
    watch)
      compadd -- --interval --since --all
      ;;
    serve)
      (( CURRENT == 3 )) && compadd run install uninstall status
      compadd -- --port
      ;;
    prune)
      compadd -- --since --keep
      ;;
    forget)
      (( CURRENT == 3 )) && _message 'session hash'
      ;;
    drop)
      (( CURRENT == 3 )) && _message 'deliverable ref or URL'
      ;;
    export)
      compadd -- --out-file --compress
      ;;
    import)
      if (( CURRENT == 3 )); then
        _files
      else
        compadd -- --force
      fi
      ;;
    completions)
      (( CURRENT == 3 )) && compadd zsh
      ;;
    install)
      (( CURRENT == 3 )) && compadd -- --dir
      ;;
  esac
}

_beacon "$@"
"""

# Logical color states → hex (no leading #). Logical names are the contract
# (BADGE-09); hex values come from the Dracula palette (THEME-01, THEME-02) and
# are tunable here without touching call sites.
#
# Three entries, because the tab color answers one question — does this session
# need me right now — and answers it the same way in every pane. A mode used to
# own a hue here too, which meant the tab spent its only always-painted channel
# on the 4% axis and had nothing left for the 96% one. The mode is legible from
# another tab as its glyph and, once focused, as its pane
# background (MODE_SPECS).
#
# Green is deliberately absent: `ready` is a calm neutral gray so a fresh session
# has a known default before its first turn, and green stays the "go / good" hue
# the branch chip owns (THEME-01, THEME-03).
COLOR_PALETTE = {
    "ready":    "8b8fa0",
    "busy":     "ffb86c",
    "blocked":  "ff5555",
}

ACTIVITY_TO_COLOR_STATE = {
    "idle":     "ready",
    "working":  "busy",
    "waiting":  "blocked",
}

# Every activity has a color, so this mapping is also the list of valid values.
ACTIVITIES = tuple(ACTIVITY_TO_COLOR_STATE)

# Static badge format. The task slot self-collapses when empty — beacon_task
# carries " · <task>" when set, "" when absent (BADGE-03). Both writers
# (this constant and shell/beacon.zsh) must stay in sync.
BADGE_FORMAT = r"\(user.beacon_project)\(user.beacon_task)"

# Two-line tab/window-title Name (TITLE-05): the project sits on line 1, the
# task on an indented line 2 via beacon_task_nl (a leading newline when set, ""
# when absent) so the tab reads project over task while the single-line OS
# window title shows line 1. beacon_title_prefix leads line 1 with the current
# mode's glyph (MODE_SPECS, TITLE-06), "" in the dev cycle. The project is
# wrapped in <b> as the one sparing HTML accent so the identity reads as the
# title (needs iTerm2 HTML tab titles, CLI-18); the task stays plain. Distinct
# from BADGE_FORMAT so the badge (when enabled, BADGE-15) keeps its single-line
# " · " form.
TITLE_FORMAT = r"<b>\(user.beacon_title_prefix)\(user.beacon_project)</b>\(user.beacon_task_nl)"

# The name an *unmanaged* pane carries (TITLE-04): `beacon_title`, the shell's
# "project else abbreviated cwd", republished every precmd and so never empty.
# The shell sets this same template once on source, and skips it when the pane is
# already Claude-owned — so disengagement is what hands the name back. Must stay
# in step with the set-name call in shell/beacon.zsh.
INTERACTIVE_TITLE_FORMAT = r"\(user.beacon_title)"

# The prefix beacon claims in iTerm2's shared DynamicProfiles directory. Install
# writes only names in it, and sweeps only names in it (_make_profiles).
PROFILE_NAMESPACE = "beacon"
BASE_PROFILE_NAME = f"{PROFILE_NAMESPACE}-dev"

# Every mode, and everything that renders one. This dict is the canonical list —
# `MODES` below is its keys, in the order the CLI offers them — so a mode exists
# exactly once and cannot be half-declared. Each entry:
#   glyph      — tab glyph leading line 1 of the session name (TITLE-06)
#   profile    — the dynamic-profile name switched into via set-profile (CLI-14)
#   guid       — fixed Guid so re-installs replace the profile in place
#   background — distinct pane background hex (no leading #)
#   image      — faint background-image watermark (file under iterm/resources)
#   blend      — iTerm2 Blend for that image (lower = fainter)
#
# Mode profiles exist (RENDER-05) because a mode's second cue is a pane
# background — a color and a faint watermark — and no OSC sets one. Entering or
# leaving a mode swaps the session's profile; the dev cycle has no profile of its
# own and stays an OSC overlay on the base.
#
# The glyph is the mode's *stronger* surface: the background is visible only in
# the focused pane, and a session running many tabs shows one pane at a time,
# so the glyph is what carries a mode across tabs. Each glyph matches its mode's
# watermark so the tab and the pane say the same thing. `dev` is absent — the
# default carries no mark, so a glyph always means "this session declared
# something". Hexes are tunable here without touching call sites (THEME-01).
MODE_SPECS = {
    "pause": {
        "glyph": "⏸",
        "profile": f"{PROFILE_NAMESPACE}-pause",
        "guid": "7f3d8a1c-2b6e-4c5a-9f01-3e8d4a2b6c5f",
        "background": "3c3357",
        "image": "pause-bg.png",
        "blend": 0.35,
    },
    # `release` is the one active mode: a ship-it flow is in progress. A deep
    # "launch-sky" navy (darkened Dracula `comment` #6272a4, so it stays on-palette
    # per THEME-01) carries a faint rocket watermark rising through the pane — a
    # launch in flight, not a session set aside.
    "release": {
        "glyph": "🚀",
        "profile": f"{PROFILE_NAMESPACE}-release",
        "guid": "c5f9a3d8-7e4b-4a2c-9d1f-6b0e8c3a5d72",
        "background": "212c45",
        "image": "release-bg.png",
        "blend": 0.30,
    },
    # `retro` is the post-work follow-up phase: a muted green pane carrying a
    # ticked-clipboard watermark — work looked back over. Blend is higher than the
    # illustration it replaced needed: flat geometry carries far less ink, so the
    # 0.15 that kept a detailed drawing from reading as noise left this one
    # invisible.
    "retro": {
        "glyph": "📋",
        "profile": f"{PROFILE_NAMESPACE}-retro",
        "guid": "9c1e7b42-5a3d-4e8f-b06c-1d2a4f7e9b30",
        "background": "2c4636",
        "image": "retro-bg.png",
        "blend": 0.25,
    },
    # `done` is the terminal "session complete, ready to hand off" mode a
    # closing-out skill reaches for instead of pause: a near-black "powered off"
    # background with a faint checkered-flag (finish-line) watermark, the dimmest
    # mode so a finished pane reads as lights-out — half the others' blend to hold
    # that. Also suppresses the task slot (STATE-12).
    "done": {
        "glyph": "🏁",
        "profile": f"{PROFILE_NAMESPACE}-done",
        "guid": "b4e2f6a0-1c3d-4e5f-8a90-2b6c7d8e9f01",
        "background": "1a1622",
        "image": "done-bg.png",
        "blend": 0.15,
    },
}

# Every mode has a spec, so this mapping is also the list of valid values —
# the same single-sourcing ACTIVITIES gets from ACTIVITY_TO_COLOR_STATE.
MODES = tuple(MODE_SPECS)


def _mode_glyph(mode: str | None) -> str:
    """A mode's tab glyph, "" in the dev cycle (which carries no mark)."""
    spec = MODE_SPECS.get(mode)
    return spec["glyph"] if spec else ""


def _wip_display_name(record: dict, mode: str) -> str:
    """`<glyph> project (branch)` — the identity column both fleet renderers
    show, composed once so a row and its tab carry the same mark."""
    branch = f" ({record['branch']})" if record.get("branch") else ""
    return f"{_mode_glyph_for({'mode': mode})}{record['project']}{branch}"


def _first_line(text: str) -> str:
    """The first line of a mode note. The fleet views give a note one line, and
    a multi-line note would otherwise break the row grid."""
    return text.splitlines()[0] if text else ""


def session_hash() -> str:
    seed = _session_seed() or "default"
    return hashlib.sha1(seed.encode()).hexdigest()[:16]


def _session_seed() -> str | None:
    # Per-pane on iTerm2; elsewhere fall back to Claude Code's session id, which
    # every in-session tool subprocess carries as CLAUDE_CODE_SESSION_ID on any
    # platform. cmd_hook synthesizes the same `claude-session:<id>` form into
    # ITERM_SESSION_ID, so a bare in-session `beacon set` and the hooks that run
    # alongside it resolve to one bucket on non-iTerm terminals (Windows, plain
    # Linux). A real tty is the last resort; the shared "default" only when none
    # of these exist — without this, concurrent windows cross-wire their state.
    iterm = os.environ.get("ITERM_SESSION_ID")
    if iterm:
        # Real iTerm ids are `wNtNpN:GUID`; seed on the GUID, not the full id.
        # iTerm2 rewrites the `wNtNpN` positional prefix when a pane is moved
        # between windows/tabs/splits, so hashing the full id fragments a pane's
        # state into a fresh bucket on every move (the fleet view then shows the
        # pane as a new/duplicate session). The GUID is stable for the pane's
        # life — the same handle focus / set-name target and the cache files key
        # on (_iterm_cache_key). The synthesized `claude-session:<id>` form
        # (cmd_hook, non-iTerm) is kept whole so a bare in-session `beacon set`
        # and the hooks converge on it — stripping it would split them from the
        # raw CLAUDE_CODE_SESSION_ID branch below.
        if iterm.startswith("claude-session:"):
            return iterm
        return iterm.rsplit(":", 1)[-1]
    claude_sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if claude_sid:
        return f"claude-session:{claude_sid}"
    return _tty_name()


def _tty_name() -> str | None:
    # os.ttyname is absent on Windows (AttributeError) and raises OSError when
    # fd 0 isn't a tty; either way there's no tty-derived id to offer.
    try:
        return os.ttyname(0)
    except (OSError, AttributeError):
        return None


def _iterm_cache_key() -> str | None:
    """Stable per-pane key for the handoff cache files (cwd / url) and the
    engagement marker. ITERM_SESSION_ID is `wNtNpN:GUID`; the `wNtNpN`
    positional prefix changes when the pane is moved between windows, tabs, or
    splits, but the GUID after the last colon is stable for the pane's life.
    Keying on the full id meant a moved pane's status-bar buttons read a file
    the hook had written under the old prefix — so the ↖ web button hit its
    fallback and the ↗ code button silently no-op'd. Mirror the GUID the CLI's
    focus / set-name already target (rsplit on ':'), and the focus handle keyed
    on (FOCUS-02). None when no pane id is set. The synthesized non-iTerm form
    `claude-session:<id>` has no positional prefix, so the same strip leaves it
    intact — a stable key there too."""
    iterm_id = os.environ.get("ITERM_SESSION_ID")
    if not iterm_id:
        return None
    return iterm_id.rsplit(":", 1)[-1]


def _project_root(cwd: Path) -> Path | None:
    # The nearest ancestor (within $HOME) holding a PROJECT_MARKER, or None when
    # cwd is inside no recognized project — a bare scratch dir like a mktemp
    # /tmp path, or anywhere outside $HOME. Treat $HOME as a boundary: markers at
    # or above $HOME (stray package.json, dotfiles .git, etc.) don't represent
    # the user's "current project".
    p = cwd.resolve()
    home = Path.home().resolve()
    for d in (p, *p.parents):
        if d == home or home not in (d, *d.parents):
            break
        for marker in PROJECT_MARKERS:
            if (d / marker).exists():
                return d
    return None


def find_project_root(cwd: Path) -> Path:
    return _project_root(cwd) or cwd.resolve()


# --- state files ---

def _state_path(field: str) -> Path:
    return STATE_DIR / f"{session_hash()}.{field}"


def read_state(field: str) -> str | None:
    try:
        v = _state_path(field).read_text().strip()
        return v or None
    except FileNotFoundError:
        return None
    except OSError:
        return None


def read_state_json(field: str, default):
    raw = read_state(field)
    if not raw:
        return default
    try:
        return json.loads(raw)
    except Exception:
        return default


def write_state(field: str, value: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    _state_path(field).write_text(value)


def remove_state(field: str) -> None:
    try:
        _state_path(field).unlink()
    except FileNotFoundError:
        pass


# --- providers ---

def p_override(field: str):
    return read_state(f"override.{field}")


def read_mode() -> tuple[str, str]:
    """The declared mode and its note, as the tuple they are written as.

    Mode and note are one value with one writer: only entering a mode sets
    either, and leaving one drops both. Storing them together is what makes that
    structural — a note cannot outlive the mode it annotates, or exist without
    one, so no caller has to remember to clear it. Absent file, unreadable file,
    or a mode name this version doesn't know all read as the dev cycle.
    """
    return _mode_tuple(read_state_json("mode", {}))


def _mode_tuple(raw: object) -> tuple[str, str]:
    """`(name, note)` out of a stored mode object. Every reader goes through
    here — the pane's own, the fleet scan, and the wip record — so an unknown
    mode name cannot mean the dev cycle on one surface and itself on another.
    """
    if not isinstance(raw, dict):
        return DEV_MODE, ""
    name = str(raw.get("name") or "")
    if name not in MODES:
        return DEV_MODE, ""
    return name, str(raw.get("note") or "")


def write_mode(name: str, note: str = "") -> None:
    """Enter `name` (a MODES member) with an optional note, or return to the dev
    cycle when `name` is DEV_MODE — which removes the file rather than storing a
    sentinel, so "no mode" has exactly one representation on disk."""
    if name == DEV_MODE:
        remove_state("mode")
        return
    write_state("mode", json.dumps({"name": name, "note": note}, indent=2))


def read_activity() -> str:
    """What the hooks last observed. Unlike mode there is no declared tier: an
    activity pinned above the hooks is a value that goes stale the moment the
    session moves on, and every instance of it found in three months of live
    state was contradicting the hooks it outranked."""
    return _normalize_activity(read_state("activity"))


def _normalize_activity(raw: object) -> str:
    """A stored activity, floored to the default when absent or unknown."""
    return raw if raw in ACTIVITIES else DEFAULT_ACTIVITY


def p_package_name(cwd: Path):
    root = find_project_root(cwd)
    pkg = root / "package.json"
    if pkg.is_file():
        try:
            return (json.loads(pkg.read_text()).get("name") or "").strip() or None
        except Exception:
            pass
    cargo = root / "Cargo.toml"
    if cargo.is_file():
        try:
            m = re.search(r'(?ms)^\[package\][^\[]*?^\s*name\s*=\s*"([^"]+)"', cargo.read_text())
            if m:
                return m.group(1)
        except Exception:
            pass
    pyp = root / "pyproject.toml"
    if pyp.is_file():
        try:
            m = re.search(r'(?ms)^\[project\][^\[]*?^\s*name\s*=\s*"([^"]+)"', pyp.read_text())
            if m:
                return m.group(1)
        except Exception:
            pass
    return None


_ORIGIN_URL_CACHE: dict[str, str] = {}


def _origin_url_at(root) -> str:
    """`remote.origin.url` for `root`, memoized for the process. Empty when
    there's no repo or no origin.

    A single `_publish_chips` wants it four times over — the route lookup's
    project name, the chip's, the forge identity, and the URL resolver's — and
    every caller runs in a short-lived hook process, far too short for the
    remote to change underneath them. Only the one-shot command paths reach
    this; `serve`'s request loop reads state files and never resolves a URL."""
    key = str(root)
    if key not in _ORIGIN_URL_CACHE:
        out = subprocess.run(
            ["git", "config", "remote.origin.url"],
            cwd=root, capture_output=True, text=True, timeout=2, check=False,
        )
        _ORIGIN_URL_CACHE[key] = out.stdout.strip() if out.returncode == 0 else ""
    return _ORIGIN_URL_CACHE[key]


def p_git_remote(cwd: Path):
    """Repo basename from git remote (e.g. `beacon`, `auth-svc`) — the last
    path segment of the remote URL, dropping owner/group prefixes. The full
    owner-bearing identity lives in `_project_full_at` (status-bar chip);
    the badge wants a short, scannable label. Returns None when not in a
    git repo or no origin is configured."""
    url = _origin_url_at(find_project_root(cwd))
    if not url:
        return None
    # Strip protocol/host. Two URL forms:
    #   ssh:   git@host:owner/path/to/repo.git
    #   https: https://host/owner/path/to/repo.git
    if "://" in url:
        path = url.split("://", 1)[1]
        path = path.split("/", 1)[1] if "/" in path else ""
    elif ":" in url:
        path = url.split(":", 1)[1]
    else:
        path = url
    path = path.rstrip("/")
    if path.endswith(".git"):
        path = path[:-4]
    parts = [p for p in path.split("/") if p]
    return parts[-1] if parts else None


def p_project_dir(cwd: Path):
    name = find_project_root(cwd).name
    return name or None


def p_branch(cwd: Path):
    root = find_project_root(cwd)
    out = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        cwd=root, capture_output=True, text=True, timeout=2,
    )
    if out.returncode != 0:
        return None
    branch = out.stdout.strip()
    return branch if branch and branch not in DEFAULT_BRANCHES else None


def p_pr_title(cwd: Path):
    if not _which("gh"):
        return None
    root = find_project_root(cwd)
    out = subprocess.run(
        ["gh", "pr", "view", "--json", "title", "-q", ".title"],
        cwd=root, capture_output=True, text=True, timeout=3,
    )
    if out.returncode != 0:
        return None
    return out.stdout.strip() or None


def _which(cmd):
    for p in os.environ.get("PATH", "").split(os.pathsep):
        if (Path(p) / cmd).exists():
            return True
    return False


# --- URL resolution (PROV-07) ---

def _git_remote_url_normalized(cwd: Path) -> str:
    """Return the project's git remote URL in https form, or empty.
    Normalizes ssh URLs (`git@host:owner/repo.git`) to https for browser use."""
    root = find_project_root(cwd)
    out = subprocess.run(
        ["git", "config", "remote.origin.url"],
        cwd=root, capture_output=True, text=True, timeout=2,
    )
    if out.returncode != 0:
        return ""
    url = out.stdout.strip()
    if not url:
        return ""
    if url.startswith("git@"):
        host_path = url[len("git@"):]
        host, _, path = host_path.partition(":")
        if host and path:
            url = f"https://{host}/{path}"
    if url.endswith(".git"):
        url = url[:-4]
    return url.rstrip("/")


def _remote_host(remote_url: str) -> str:
    """Lowercased host portion of a normalized https remote, or empty."""
    if "://" not in remote_url:
        return ""
    return remote_url.split("://", 1)[1].split("/", 1)[0].lower()


def _branch_url(cwd: Path, branch: str, remote: str) -> tuple[str, str]:
    """Return (url, branch) for the current non-default branch's tree, or empty."""
    if not branch or not remote:
        return "", ""
    # GitLab uses /-/tree/<branch>; GitHub and most others use /tree/<branch>.
    sep = "/-/tree/" if "gitlab" in _remote_host(remote) else "/tree/"
    return f"{remote}{sep}{branch}", branch


_TACK_ROUTES_UNSET = object()
_TACK_ROUTES_CACHE = _TACK_ROUTES_UNSET


def _tack_routes() -> list:
    """`tack list --json`, memoized for the life of the process. Every hook is
    its own process, so the memo never spans a turn — it exists because a single
    invocation asks tack the same question twice (the URL chain and the
    landed-deliverable filter), and one subprocess is enough for both. Empty
    list when tack is absent or unreadable."""
    global _TACK_ROUTES_CACHE
    if _TACK_ROUTES_CACHE is not _TACK_ROUTES_UNSET:
        return _TACK_ROUTES_CACHE
    _TACK_ROUTES_CACHE = []
    if _which("tack"):
        try:
            r = subprocess.run(["tack", "list", "--json"],
                               capture_output=True, text=True, timeout=2)
            if r.returncode == 0:
                parsed = json.loads(r.stdout)
                if isinstance(parsed, list):
                    _TACK_ROUTES_CACHE = parsed
        except (subprocess.SubprocessError, json.JSONDecodeError, OSError):
            pass
    return _TACK_ROUTES_CACHE


def _tack_landed_urls() -> set[str]:
    """Deliverable URLs whose tack is `done` or `dropped`. STATUSLINE-03
    promotes these to the delivered line — shipping is rare enough to be worth
    keeping on screen, and it is what the session has to show for itself.

    Read from the same `tack list` payload the URL chain already consumes, so it
    costs nothing extra. It drifts from forge truth when a tack isn't kept
    current; the forge is authoritative but only over the network, which the
    per-turn hook budget rules out. A session with no tack route gets an empty
    set and treats everything it touched as still open."""
    return {
        url
        for route in _tack_routes()
        for t in (route.get("tacks") or [])
        if t.get("status") in ("done", "dropped")
        and (url := (t.get("deliverable") or {}).get("url"))
    }


# Open statuses only — a completed tack reaches the row through the `done_at`
# window in _tack_in_session_scope instead. Both open statuses count: a route is
# commonly kept with its tack filed `pending` and marked done at ship time, so
# `in_progress` alone left the row empty for as long as the work was underway.
_OPEN_TACK_STATUSES = frozenset({"in_progress", "pending"})


def _iso_epoch(s: str) -> float | None:
    """Epoch seconds for an ISO-8601 stamp, or None when it can't be read. tack
    writes `…Z` and beacon writes `…+00:00`, so the two can't be compared as
    strings."""
    if not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def _session_started_at() -> str:
    """When the current Claude session began, stamped at every fresh-start
    boundary (SessionStart other than `resume`, and the in-session commands that
    re-bootstrap context).

    STATUSLINE-03's row is scoped to one Claude session while the tack route it
    reads from is scoped to the project, so the row needs a window of its own
    rather than inheriting the route's lifetime. Held in beacon's own state
    rather than read from the route's `sessions[]`: tack records a session only
    on the route it is pinned to, and how ephemeral the row is shouldn't depend
    on that bookkeeping."""
    return read_state("session_started_at") or ""


def _tack_in_session_scope(tack: dict, started_at: float | None) -> bool:
    """Whether a tack belongs on *this* session's row (STATUSLINE-03): the
    route's open work, plus whatever it landed since the session started.

    What the scope exists to exclude is the project's shipping log — a route
    carries months of `done` tacks, and offering those made a fresh session's
    row read as a release of work it never touched, which HOOK-08a's wipe cannot
    prevent on its own since acquisition re-offers the whole route on the next
    hook. Open work is the opposite case: a `pending` tack's issue link is
    exactly the "what am I shipping it for" the row's trailing line is for, and
    routes are commonly kept with the tack marked `done` only at ship time, so
    gating on `in_progress` alone left the row empty for whole sessions.

    With no session stamp (a pane engaged before the stamp existed) only the
    open tacks qualify: a thin row beats a stale one."""
    if tack.get("status") in _OPEN_TACK_STATUSES:
        return True
    done = _iso_epoch(tack.get("done_at") or "")
    return bool(started_at and done and done >= started_at)


def _url_delivered_before_session(cwd: Path, branch: str, url: str,
                                  project: str | None = None) -> bool:
    """True when `url` is a bound-route deliverable whose tack finished before
    this session started.

    PROV-07 answers *where this session's work lives* and falls back to the
    most-recently-completed deliverable when no tack is active (`_tack_url_for`
    step b), so on a route with nothing open it keeps naming something that
    shipped in an earlier session. That is a serviceable click target for
    `↖ web`, but it is not an accomplishment: recording it on the row credits
    this session with work it never touched."""
    if not url:
        return False
    route = _bound_tack_route(cwd, branch, project)
    if not route:
        return False
    started = _iso_epoch(_session_started_at())
    for t in route.get("tacks") or []:
        if (t.get("deliverable") or {}).get("url") == url:
            return not _tack_in_session_scope(t, started)
    return False


def _bound_tack_route(cwd: Path, branch: str, project: str | None = None) -> dict | None:
    """The tack route this session is working, or None.

    Route selection mirrors the dashboard's _resolve_session so the ↖ web
    button and the fleet-view reference chip never diverge: the session→route
    pin (`sessions[].id`) is authoritative — matching the branch slug alone
    missed a route pinned to the session whose slug differs from the branch.
    Location correlation (`.tack` pin / branch / project, via _tack_route_for)
    is the fallback when no pin binds this session."""
    routes = _tack_routes()
    if not routes:
        return None

    sid = read_state("claude_session_id") or os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    slug = None
    if sid:
        def _pin_started(route):
            return max((s.get("started_at", "") for s in (route.get("sessions") or [])
                        if s.get("id") == sid), default="")
        pinned = [r for r in routes
                  if any(s.get("id") == sid for s in (r.get("sessions") or []))]
        if pinned:
            # On several routes, the most recently started wins (the pane's
            # current work) — mirrors _tack_session_index.
            pinned.sort(key=_pin_started, reverse=True)
            slug = pinned[0].get("slug")
    if not slug:
        slug, _group = _tack_route_for(cwd, branch, project)
    if not slug:
        return None
    return next((r for r in routes if r.get("slug") == slug), None)


def _tack_route_urls(cwd: Path, branch: str, project: str | None = None) -> list[str]:
    """Every deliverable and tracker link the bound route holds, in route
    order, deduped. STATUSLINE-03's acquisition path.

    PROV-07 answers a narrower question — *which one* URL this branch points at
    — so it surfaces a single ref out of everything a well-kept route records.
    The status line wants the set: the issue the work answers, the CR that
    lands it, the release that ships it. Work with no branch to be found by (an
    issue filed from the default branch, another project's deliverable the
    session crossed) reaches the row only through here.

    Within a tack the deliverable precedes its links, and tacks come in route
    order, so the most recent work sorts last and survives DELIVERABLES_MAX.

    Scoped to the current session (`_tack_in_session_scope`): a route's
    lifetime is the project's, the row's is one Claude session, so offering the
    whole route here is what let a fresh session's row read as a release log of
    work it never touched."""
    route = _bound_tack_route(cwd, branch, project)
    if not route:
        return []
    started = _iso_epoch(_session_started_at())
    urls = []
    for t in route.get("tacks") or []:
        if not _tack_in_session_scope(t, started):
            continue
        candidates = [(t.get("deliverable") or {}).get("url")]
        candidates += [ln.get("url") for ln in (t.get("links") or [])]
        urls += [u for u in candidates if u and u not in urls]
    return urls


def _tack_url_for(cwd: Path, branch: str, project: str | None = None) -> tuple[str, str]:
    """URL for the session's tack route via the in_progress-deliverable →
    done-deliverable → first-link sub-chain."""
    route = _bound_tack_route(cwd, branch, project)
    if not route:
        return "", ""
    tacks = route.get("tacks", []) or []

    # a. first in_progress with deliverable
    for t in tacks:
        if t.get("status") == "in_progress":
            d = t.get("deliverable") or {}
            if d.get("url"):
                return d["url"], d.get("label", "")

    # b. most-recently-completed done with deliverable
    done = [t for t in tacks if t.get("status") == "done"]
    done.sort(key=lambda t: t.get("done_at", ""), reverse=True)
    for t in done:
        d = t.get("deliverable") or {}
        if d.get("url"):
            return d["url"], d.get("label", "")

    # c. first link.url across any tack
    for t in tacks:
        for ln in (t.get("links") or []):
            if ln.get("url"):
                return ln["url"], ln.get("label", "")

    return "", ""


_FORGE_PROBES = {
    "github": {
        "cli": "gh",
        "argv": lambda b: ["gh", "pr", "list", "--head", b,
                           "--json", "url,number,title", "--limit", "1"],
        "url_key": "url",
        "label": lambda d: d.get("title") or f"#{d.get('number','')}",
    },
    "gitlab": {
        "cli": "glab",
        "argv": lambda b: ["glab", "mr", "list", "--source-branch", b,
                           "--output", "json", "--per-page", "1"],
        "url_key": "web_url",
        "label": lambda d: d.get("title") or f"!{d.get('iid','')}",
    },
}


def _forge_url(cwd: Path, branch: str, remote: str) -> tuple[str, str]:
    """Probe the forge for an open PR/MR matching the current branch. Returns
    empty when the host isn't recognized, the matching CLI isn't installed,
    or the call fails. Exceptions are swallowed because this runs on every
    branch change — a hiccup must not crash the chain or block the shell."""
    if not branch or not remote:
        return "", ""
    host = _remote_host(remote)
    probe = next((p for tag, p in _FORGE_PROBES.items() if tag in host), None)
    if not probe or not _which(probe["cli"]):
        return "", ""
    try:
        r = subprocess.run(
            probe["argv"](branch),
            cwd=str(cwd), capture_output=True, text=True, timeout=3,
        )
        if r.returncode != 0 or not r.stdout.strip():
            return "", ""
        items = json.loads(r.stdout)
    except (subprocess.SubprocessError, json.JSONDecodeError, OSError):
        return "", ""
    if not items:
        return "", ""
    item = items[0]
    return item.get(probe["url_key"], ""), probe["label"](item)


def _location_url(cwd: Path, branch: str, remote: str) -> tuple[str, str]:
    """PROV-07's location tiers — an open PR/MR for the branch, else the branch
    tree, else the project. Named separately from `resolve_url` because the
    status line substitutes them when the tack tier answers with a delivery that
    predates the session (STATUSLINE-02)."""
    # 3. forge probe — cached by the shell's `cwd@branch` signal, so this
    # fires once per branch change, not per prompt.
    url, label = _forge_url(cwd, branch, remote)
    if url:
        return url, label

    # 4. branch URL
    url, label = _branch_url(cwd, branch, remote)
    if url:
        return url, label

    # 5. project URL
    if remote:
        return remote, p_git_remote(cwd) or p_project_dir(cwd) or ""

    # 6. empty
    return "", ""


def _location_url_at(cwd: Path) -> tuple[str, str]:
    """`_location_url` resolving branch and remote the way `resolve_url` does —
    notably `p_branch`, which reports no branch on the default one, so the
    default branch lands on the project URL rather than a tree URL."""
    return _location_url(cwd, p_branch(cwd), _git_remote_url_normalized(cwd))


def resolve_url(cwd: Path | None = None) -> tuple[str, str]:
    """Implements PROV-07. Returns (url, label)."""
    cwd = cwd or Path.cwd()

    # 1. user override (short-circuits before any git work)
    o = p_override("url")
    if o:
        return o, o[:30]

    # Resolve branch and remote once; reused by every subsequent provider.
    # Either may be empty (default branch / no `origin`); helpers handle that.
    branch = p_branch(cwd)
    remote = _git_remote_url_normalized(cwd)

    # 2. tack-derived
    url, label = _tack_url_for(cwd, branch, _project_name_at(cwd))
    if url:
        return url, label

    return _location_url(cwd, branch, remote)


def cmd_copy_url(_args):
    """Resolve the current URL (PROV-07) and pipe it through pbcopy."""
    url, _ = resolve_url()
    if not url:
        sys.exit("no URL resolved (no override, no tack route, no git remote)")
    try:
        r = subprocess.run(["pbcopy"], input=url, text=True, timeout=2)
        if r.returncode != 0:
            sys.exit(f"pbcopy failed (exit {r.returncode})")
    except FileNotFoundError:
        sys.exit("pbcopy not found — copy-url requires macOS")
    print(f"copied: {url}")


# The two status-bar action buttons and their defaults (STATUS-BAR-09). An
# empty `web` cmd is not a missing value — it selects beacon's own PROV-07
# resolution, which is the default the button ships with.
#
# The `code` default carries no startup option on purpose. VS Code's CLI
# forwards an option it doesn't recognize to Electron/Chromium, and on a cold
# start (nothing running yet) that makes it drop the directory positional and
# open a Welcome window — the button lands nowhere. `--maximized`, the 2.0
# default, was such an option, and it never maximized either: VS Code has no CLI
# flag for window state, only the `window.newWindowDimensions` setting.
STATUSBAR_BUTTON_DEFAULTS = {
    "web": {"label": "↖ web", "cmd": ""},
    "code": {"label": "↗ code", "cmd": "code"},
}


def _statusbar_button(name: str) -> dict:
    """One action button's `label` and `cmd` — the user's
    `statusbar.buttons.<name>` block layered over the defaults above.

    The two halves reach the button by different routes, which is why they read
    at different times despite living in one config block. `cmd` is read here,
    on the click, so a new command applies with no reinstall. `label` is baked
    into the dynamic profile at render time: an action component's title is a
    static knob and cannot interpolate a user var the way the text chips do
    (§6.10), so a changed label needs a `refresh-iterm-profiles` re-render.

    A blank or absent `cmd` means the button's default — for `code` that is a
    bare `code`, and for `web` it is the empty string that selects PROV-07. One
    rule covers both, so there is no third "explicitly disabled" state for a
    caller to interpret."""
    default = STATUSBAR_BUTTON_DEFAULTS[name]
    section = _load_config().get("statusbar")
    buttons = section.get("buttons") if isinstance(section, dict) else None
    cfg = buttons.get(name) if isinstance(buttons, dict) else None
    if not isinstance(cfg, dict):
        return dict(default)
    label, cmd = cfg.get("label"), cfg.get("cmd")
    return {
        "label": label.strip() if isinstance(label, str) and label.strip() else default["label"],
        "cmd": cmd.strip() if isinstance(cmd, str) and cmd.strip() else default["cmd"],
    }


def _code_launch_argv() -> list[str]:
    """STATUS-BAR-07: the editor invocation for the `↗ code` button — its
    configured `cmd`, shell-split, else a bare `code`."""
    return shlex.split(_statusbar_button("code")["cmd"])


# Placeholders a button's `cmd` may position (STATUS-BAR-09). `{{` / `}}` are
# literal braces, so a command needing one isn't locked out; `{}` (empty) is not
# a placeholder, which keeps `find -exec … {} \;` working verbatim.
STATUSBAR_CMD_TOKENS = ("dir", "project", "branch")
_CMD_TOKEN_RE = re.compile(r"\{\{|\}\}|\{([a-z_]+)\}")


def _cmd_token_values(cwd: Path) -> dict:
    """The placeholder values for a click in `cwd`. Resolved here rather than
    persisted: a button is correct in a pane beacon isn't tracking, which is the
    same reason the URL is resolved at click time (STATUS-BAR-08)."""
    return {
        "dir": str(cwd),
        "project": _project_name_at(cwd) or "",
        "branch": p_branch(cwd) or "",
    }


def _substitute_cmd_tokens(argv: list[str], cwd: Path) -> tuple[list[str], bool]:
    """Expand placeholders in each argument, returning the new argv and whether
    `{dir}` appeared.

    Substitution is **per-argument, after the shlex split** — expanding into the
    command string and re-splitting is what would turn a `/My Repo` path into two
    arguments. That also means a value never introduces new argv entries, so a
    directory name can't smuggle in a flag.

    The `{dir}` flag is what suppresses `cmd_open_code`'s automatic append: a
    command that places the directory itself must not receive it twice. Only
    `{dir}` does that — `{branch}` and `{project}` say nothing about where the
    path goes, so a `cmd` using them still gets the directory appended."""
    if not any("{" in a for a in argv):
        return argv, False
    values = _cmd_token_values(cwd)
    saw_dir = False

    def repl(m):
        nonlocal saw_dir
        if m.group(0) in ("{{", "}}"):
            return m.group(0)[0]
        name = m.group(1)
        if name not in values:
            known = ", ".join(f"{{{t}}}" for t in STATUSBAR_CMD_TOKENS)
            sys.exit(f"unknown placeholder {{{name}}} in the button's cmd — "
                     f"known placeholders are {known} (use {{{{ for a literal brace)")
        saw_dir = saw_dir or name == "dir"
        return values[name]

    out = []
    for arg in argv:
        expanded = _CMD_TOKEN_RE.sub(repl, arg)
        # An argument that expanded to nothing — `{branch}` outside a repo — is
        # dropped rather than passed as an empty string, which a program reads as
        # a positional argument the user never wrote.
        if expanded or not arg:
            out.append(expanded)
    return out, saw_dir


def _resolve_editor(app: str) -> str | None:
    """Absolute path to `app`, or None when it cannot be found.

    `shutil.which` alone is not enough here. A status-bar action shell inherits
    iTerm2's `PATH`, not the login shell's (§6.10 caveat 3), so the lookup runs
    against roughly `/usr/bin:/bin:/usr/sbin:/sbin` — which excludes
    `/opt/homebrew/bin` and `/usr/local/bin`, the very places an editor CLI
    installs. Substituting an absolute interpreter fixed reaching Python; it did
    nothing for the binary Python then goes looking for.

    So when `PATH` comes up empty, ask the user's login shell, which is the
    thing that actually knows where their tools are. That is one subprocess on a
    click — never a hot path — and it resolves the *configured* editor rather
    than quietly launching a different one."""
    # Both separators, not just `os.path.sep`: Windows accepts `/` in paths, so
    # keying on the native separator alone would send `/Apps/ed` down the
    # bare-command lookup and never find it.
    if os.path.sep in app or "/" in app:
        return app if os.access(app, os.X_OK) else None
    found = shutil.which(app)
    if found:
        return found
    shell = os.environ.get("SHELL") or "/bin/sh"
    try:
        r = subprocess.run([shell, "-lc", f"command -v {shlex.quote(app)}"],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    lines = [ln for ln in r.stdout.splitlines() if ln.strip()]
    path = lines[-1].strip() if lines else ""
    return path if path and os.access(path, os.X_OK) else None


def cmd_open_code(args):
    """STATUS-BAR-07: open a directory in the configured editor. Backs the
    `↗ code` status-bar button, which invokes this rather than launching the
    editor from its own shell: an iTerm2 action shell has no interactive `PATH`
    (§6.10 caveat 3), and resolving the binary is exactly what that costs. It
    also puts the config read at click time, so changing editors needs no
    reinstall."""
    target = args.dir or str(Path.cwd())
    argv, positioned = _substitute_cmd_tokens(_code_launch_argv(), Path(target))
    exe = _resolve_editor(argv[0])
    if not exe:
        sys.exit(f"editor not found: {argv[0]!r} is not on PATH, and your login "
                 f'shell could not find it either — set an absolute path in '
                 f'"statusbar.buttons.code.cmd" in {_config_file()}')
    # `{dir}` in the cmd means the user placed the path themselves (STATUS-BAR-09).
    tail = [] if positioned else [target]
    try:
        r = subprocess.run([exe, *argv[1:], *tail], capture_output=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as e:
        sys.exit(f"failed to launch {argv[0]}: {e}")
    if r.returncode != 0:
        detail = r.stderr.decode(errors="replace").strip()
        sys.exit(f"{argv[0]} exited {r.returncode}{': ' + detail if detail else ''}")
    print(f"opened: {target}")


def cmd_open_url(args):
    """Open the session's web view. Backs the `↖ web` status-bar button
    (STATUS-BAR-08) and is usable from any shell.

    Two paths, chosen by config. The button's `cmd` runs the user's own command
    in the target directory — the point being that plenty of people already have
    one (`git web` and friends), and beacon has no business relitigating where it
    should go. Unset, beacon resolves the URL itself through PROV-07, which
    knows about tack deliverables and open CRs and so lands on the *thing you
    are working on* rather than the repo's front page.

    Resolution happens at click time against the directory it is given. That is
    what makes this correct in a pane beacon isn't tracking — a shell you are
    just poking around in — and it is why there is no URL handoff file: nothing
    is cached, so nothing can go stale (the #5 failure)."""
    target = Path(args.dir) if getattr(args, "dir", None) else Path.cwd()

    cmd = _statusbar_button("web")["cmd"]
    if cmd:
        # No append to suppress here — the directory reaches this command as its
        # cwd — so the `{dir}` flag is not consulted, only the expansion.
        argv, _ = _substitute_cmd_tokens(shlex.split(cmd), target)
        exe = _resolve_editor(argv[0])
        if not exe:
            sys.exit(f"web command not found: {argv[0]!r} is not on PATH, and your "
                     f"login shell could not find it either — check "
                     f'"statusbar.buttons.web.cmd" in {_config_file()}')
        try:
            r = subprocess.run([exe, *argv[1:]], cwd=str(target),
                               capture_output=True, text=True, timeout=20)
        except (OSError, subprocess.SubprocessError) as e:
            sys.exit(f"failed to run {cmd!r}: {e}")
        if r.returncode != 0:
            sys.exit(f"{cmd!r} exited {r.returncode}"
                     f"{': ' + r.stderr.strip() if r.stderr.strip() else ''}")
        print(f"ran: {cmd}")
        return

    url, _ = resolve_url(target)
    if not url:
        sys.exit("no URL resolved (no override, no tack route, no git remote)")
    try:
        r = subprocess.run(["open", url], capture_output=True, timeout=10)
        if r.returncode != 0:
            sys.exit(f"open failed (exit {r.returncode}): {r.stderr.decode().strip()}")
    except FileNotFoundError:
        sys.exit("open not found — open-url requires macOS")
    print(f"opened: {url}")


def _default_branch_ref(root: Path) -> str | None:
    """The branch a reviewer diffs against — `origin/HEAD` (symbolic), else the
    conventional `origin/main` / `origin/master`. Returns the remote-qualified
    ref (`origin/main`) or None when none resolves."""
    out = subprocess.run(
        ["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"],
        cwd=root, capture_output=True, text=True, timeout=2, check=False,
    )
    head = out.stdout.strip()
    if head and _git_rev_ok(root, head):
        return head
    for candidate in ("origin/main", "origin/master"):
        if _git_rev_ok(root, candidate):
            return candidate
    return None


def _git_rev_ok(root: Path, ref: str) -> bool:
    return subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", ref],
        cwd=root, capture_output=True, timeout=2, check=False,
    ).returncode == 0


def cmd_data_dir(_args):
    """Print the resolved data dir — consumed by shell/beacon.zsh to
    derive its cache path on source."""
    sys.stdout.write(f"{DATA_DIR}\n")


def cmd_config_get(args):
    """Print a single user-config value (empty when unset) — consumed by
    shell/beacon.zsh on source to gate the opt-in badge (BADGE-15). A list
    value prints shell-quoted and space-joined, so a caller can word-split it
    without re-parsing JSON."""
    val = _load_config().get(args.key)
    if val is None:
        sys.stdout.write("")
        return
    if isinstance(val, (list, tuple)):
        val = " ".join(shlex.quote(str(v)) for v in val)
    sys.stdout.write(f"{val}\n")


def cmd_json(_args):
    """Print the resolved session state as a JSON object (CMD-15) — for handoff
    to another tool, or piping into jq.

    Every resolved signal ships with the provider that supplied it, which is what
    lets a consumer tell a real label from a fallback. `task` in particular can be
    byte-identical to `branch` in the same payload, because the branch name is the
    task chain's third tier (PROV-02); a consumer rendering both wants to drop the
    duplicate, and `task_provider == "branch"` says so exactly where a string
    comparison only guesses.

    `mode` is a nested tuple rather than two flat keys because mode and note are
    one value with one writer: only entering a mode sets either, and leaving one
    drops both. The two state axes carry no provider — one writer each, so naming
    a tier would invent a distinction that doesn't exist.
    """
    cwd = Path.cwd()
    state = resolve(cwd)
    url, _ = resolve_url(cwd)
    home = str(Path.home())
    cwd_str = str(cwd)
    if cwd_str == home or cwd_str.startswith(home + "/"):
        cwd_str = "~" + cwd_str[len(home):]
    payload = {
        "project": state["project"],
        "project_provider": state["project_provider"],
        # null, not "", when nothing supplied one: an absent task is the common
        # case (PROV-02 has no default tier) and it is not the same thing as a
        # task resolved to an empty string.
        "task": state["task"] or None,
        "task_provider": state["task_provider"] if state["task"] else None,
        "mode": {"name": state["mode"], "note": state["note"],
                 "glyph": _mode_glyph(state["mode"])},
        "activity": state["activity"],
        # Not a signal, and not resolved through a chain: empty means "on the
        # repo's default branch", not "unknown" and not "detached".
        "branch": p_branch(cwd) or "",
        "url": url,
        "cwd": cwd_str,
        "claude_session": read_state("claude_session_id") or "",
    }
    print(json.dumps(payload, indent=2))


# --- cross-session introspection (wip / serve) ---
#
# `wip` and `serve` are read-only export surfaces: they enumerate *every*
# beacon session's stored state — not just the current pane — and correlate
# each to its tack route, so the goals dashboard can show which planned work
# has a live session attached right now. They paint no iTerm surface (see
# docs/spec.md "Introspection / export"). Unlike resolve()/read_state, which
# operate on the current session_hash(), these read state for explicit hashes
# and use the *anchored* project/cwd (HOOK-08) rather than re-running the live
# git/pwd providers — those need a live per-pane cwd and would be costly across
# N sessions; the anchor already records where each session lives.

TACK_HOME = Path(os.environ.get("TACK_HOME") or (Path.home() / ".tack"))

# Default `wip` / `serve` window when the caller gives no explicit `--since`.
# Without it the command dumps every session ever recorded (weeks of stale
# panes); a day keeps the bare command to recent, legible work. `--all` opts
# back into the full history.
DEFAULT_WINDOW_SECONDS = 86400


def _all_session_hashes() -> list[str]:
    """Distinct session hashes with state on disk. Filenames are
    `<hash>.<field>`; the hash is dot-free hex while fields (e.g.
    `override.task`) carry dots, so the hash is everything before the
    first dot."""
    hashes = set()
    try:
        for p in STATE_DIR.glob("*"):
            if p.is_file():
                hashes.add(p.name.split(".", 1)[0])
    except OSError:
        pass
    return sorted(hashes)


def _read_state_for(sh: str, field: str) -> str | None:
    try:
        v = (STATE_DIR / f"{sh}.{field}").read_text().strip()
        return v or None
    except (FileNotFoundError, OSError):
        return None


def _read_mode_for(sh: str) -> tuple[str, str]:
    """read_mode() for an arbitrary hash — the fleet-scan counterpart, reading
    the same tuple the pane's own resolver does."""
    raw = _read_state_for(sh, "mode")
    if not raw:
        return DEV_MODE, ""
    try:
        return _mode_tuple(json.loads(raw))
    except (ValueError, TypeError):
        return DEV_MODE, ""


def _session_last_activity(sh: str) -> float:
    """Newest mtime across this hash's state files — the session's last
    observed activity, since hooks rewrite state on every Claude event."""
    latest = 0.0
    try:
        for p in STATE_DIR.glob(f"{sh}.*"):
            try:
                latest = max(latest, p.stat().st_mtime)
            except OSError:
                continue
    except OSError:
        pass
    return latest


def _session_mtimes() -> dict[str, float]:
    """Map session hash → newest state-file mtime, from a single scan of the
    state dir. Equivalent to calling _session_last_activity for every hash, but
    one pass (O(files)) instead of one whole-dir glob per hash
    (O(sessions × files)) — the dominant cost once a fleet accumulates hundreds
    of sessions and thousands of state files."""
    out: dict[str, float] = {}
    try:
        with os.scandir(STATE_DIR) as it:
            for entry in it:
                if not entry.is_file():
                    continue
                h = entry.name.split(".", 1)[0]
                try:
                    mt = entry.stat().st_mtime
                except OSError:
                    continue
                if mt > out.get(h, 0.0):
                    out[h] = mt
    except OSError:
        pass
    return out


def _branch_for(cwd_path: Path, cache: dict | None) -> str | None:
    """`_raw_branch` memoized by cwd for the span of one fleet scan. Branch is
    a property of the directory, but a long-lived fleet has many sessions per
    repo (e.g. 219 sessions across 51 cwds), so without this the scan spawns a
    git subprocess per session instead of per directory — the bulk of `wip`
    latency. The cache is per-scan, so a branch switch is still seen next call."""
    if cache is None:
        return _raw_branch(cwd_path)
    key = str(cwd_path)
    if key not in cache:
        cache[key] = _raw_branch(cwd_path)
    return cache[key]


def _raw_branch(cwd: Path) -> str | None:
    """Unfiltered branch name at cwd (keeps default branches, unlike
    p_branch — for tack slug matching and display)."""
    try:
        r = subprocess.run(
            ["git", "symbolic-ref", "--short", "HEAD"],
            cwd=str(cwd), capture_output=True, text=True, timeout=2, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    name = r.stdout.strip()
    return name if (r.returncode == 0 and name) else None


def _tack_pin_slug(cwd: Path) -> str | None:
    try:
        for line in (cwd / ".tack").read_text().splitlines():
            m = re.match(r"\s*slug:\s*(\S+)", line)
            if m:
                return m.group(1).strip().strip("\"'")
    except (FileNotFoundError, OSError):
        pass
    return None


def _read_route(name: str) -> tuple[str, str | None] | None:
    """(canonical_slug, group) from $TACK_HOME/routes/<name>.yaml, or None when
    no such route. The in-file `slug:` is authoritative — filename casing can
    drift on case-insensitive filesystems, but the dashboard joins on tack's
    canonical slug."""
    if not name:
        return None
    try:
        text = (TACK_HOME / "routes" / f"{name}.yaml").read_text()
    except (FileNotFoundError, OSError):
        return None
    slug, group = name, None
    for line in text.splitlines():
        m = re.match(r"\s*slug:\s*(\S+)", line)
        if m:
            slug = m.group(1).strip().strip("\"'")
        m = re.match(r"\s*group:\s*(\S+)", line)
        if m:
            group = m.group(1).strip().strip("\"'")
    return (slug, group)


# A tack is "existing" (vs "emerging") when it carries a forge PR/MR/issue
# reference — the signal that the work was already tracked before a session
# picked it up. Mirrors tack's CL-37 forge recognition (GitHub /pull|/issues,
# GitLab /-/merge_requests|/-/issues). A deliverable is always such a reference,
# so its mere presence counts; a plain link counts only when its URL matches.
_TRACKER_URL_RE = re.compile(r"/(pull|issues)/\d+|/-/(merge_requests|issues)/\d+")

# Finer classification for the fleet view (WIP-09): a change request (GitHub
# pull / GitLab merge request) ranks above an issue, above anything else — the
# order the dashboard emphasizes tack references in.
_CR_URL_RE = re.compile(r"/pull/\d+|/-/merge_requests/\d+")
_ISSUE_URL_RE = re.compile(r"/issues/\d+")  # matches GitHub /issues/ and GitLab /-/issues/


def _is_tracker_url(url: str) -> bool:
    return bool(_TRACKER_URL_RE.search(url))


def _ref_type(url: str) -> str:
    """Classify a tack reference URL as a change request, an issue, or other."""
    if _CR_URL_RE.search(url):
        return "cr"
    if _ISSUE_URL_RE.search(url):
        return "issue"
    return "other"


def _yv(s: str) -> str:
    """A scalar YAML value with surrounding whitespace and quotes stripped."""
    return s.strip().strip("\"'")


def _parse_route_index(text: str):
    """Parse one route YAML into (slug, group, tacks, sessions) for the
    session→tack join. tacks: {tid: {summary, status, kind, refs}} where kind
    is `existing` (carries a deliverable or forge tracker link) or `emerging`,
    and refs is the tack's reference URLs each classified `cr` / `issue` /
    `other` (WIP-09), in appearance order.
    sessions: [{id, started_at, tacks: [tid,...]}] — the bound tacks per
    RT-11, in touch order. Hand-rolled line scan rather than `tack … --json`:
    beacon reads the source-of-record files directly so the join never depends
    on the installed tack CLI being a version that knows the `tacks` field."""
    slug = group = None
    tacks: dict[str, dict] = {}
    has_deliverable: dict[str, bool] = {}
    has_tracker: dict[str, bool] = {}
    refs: dict[str, list] = {}
    sessions: list[dict] = []
    section = None          # "tacks" | "sessions" | None
    cur_tid = None
    cur_sess = None
    sub = None              # nested block: "deliverable" | "links" | "session_tacks"

    for line in text.splitlines():
        if not line.strip():
            continue
        if re.match(r"^\S", line):
            cur_tid = cur_sess = sub = None
            m = re.match(r"slug:\s*(\S+)", line)
            if m:
                slug = _yv(m.group(1))
            m = re.match(r"group:\s*(\S+)", line)
            if m:
                group = _yv(m.group(1))
            section = ("tacks" if line.startswith("tacks:")
                       else "sessions" if line.startswith("sessions:") else None)
            continue

        if section == "tacks":
            m = re.match(r"\s{2}-\s*id:\s*(\S+)", line)
            if m:
                cur_tid = _yv(m.group(1))
                tacks[cur_tid] = {"summary": "", "status": ""}
                has_deliverable[cur_tid] = has_tracker[cur_tid] = False
                refs[cur_tid] = []
                sub = None
                continue
            if cur_tid is None:
                continue
            m = re.match(r"\s{4}(\w+):\s*(.*)", line)
            if m:
                key, val = m.group(1), _yv(m.group(2))
                if key == "summary":
                    tacks[cur_tid]["summary"] = val
                    sub = None
                elif key == "status":
                    tacks[cur_tid]["status"] = val
                    sub = None
                elif key == "deliverable":
                    has_deliverable[cur_tid] = True
                    sub = "deliverable"
                    if val:  # inline `deliverable: <url>` form
                        refs[cur_tid].append({"type": _ref_type(val), "url": val})
                elif key == "links":
                    sub = "links"
                else:
                    sub = None
                continue
            m = re.match(r"\s{6,}.*url:\s*(\S+)", line)
            if m and sub in ("deliverable", "links"):
                url = _yv(m.group(1))
                refs[cur_tid].append({"type": _ref_type(url), "url": url})
                if _is_tracker_url(url):
                    has_tracker[cur_tid] = True
            continue

        if section == "sessions":
            m = re.match(r"\s{2}-\s*id:\s*(\S+)", line)
            if m:
                cur_sess = {"id": _yv(m.group(1)), "started_at": "", "tacks": []}
                sessions.append(cur_sess)
                sub = None
                continue
            if cur_sess is None:
                continue
            m = re.match(r"\s{4}started_at:\s*(\S+)", line)
            if m:
                cur_sess["started_at"] = _yv(m.group(1))
                sub = None
                continue
            if re.match(r"\s{4}tacks:\s*$", line):
                sub = "session_tacks"
                continue
            m = re.match(r"\s{6}-\s*(\S+)", line)
            if m and sub == "session_tacks":
                cur_sess["tacks"].append(_yv(m.group(1)))
                continue
            if re.match(r"\s{4}\w+:", line):
                sub = None

    meta = {
        tid: {
            "summary": m["summary"],
            "status": m["status"],
            "kind": "existing" if (has_deliverable[tid] or has_tracker[tid]) else "emerging",
            "refs": refs[tid],
        }
        for tid, m in tacks.items()
    }
    return slug, group, meta, sessions


def _tack_session_index() -> dict:
    """Map Claude session id → {route, group, tacks[]}, built from every
    route's `sessions:` block. This is the authoritative beacon↔tack join:
    Claude Code issues the session id, beacon stores it per pane, and tack
    records it on the route — and now the tack(s) — the session worked.
    `tacks` is the route-qualified list the session is driving (WIP-09), in
    touch order; the last is its current focus. When a session was registered
    on multiple routes, the most recently started wins (the pane's current
    work). Scanned once per `wip` call."""
    index: dict[str, dict] = {}
    chosen: dict[str, str] = {}
    try:
        files = list((TACK_HOME / "routes").glob("*.yaml"))
    except OSError:
        return index
    for path in files:
        try:
            text = path.read_text()
        except OSError:
            continue
        slug, group, meta, sessions = _parse_route_index(text)
        if slug is None:
            slug = path.stem
        for sess in sessions:
            sid = sess["id"]
            started = sess["started_at"]
            if sid in chosen and started <= chosen[sid]:
                continue
            qualified = []
            for tid in sess["tacks"]:
                tm = meta.get(tid)
                if tm is None:
                    continue
                qualified.append({
                    "id": f"{slug}/{tid}",
                    "tack_id": tid,
                    "summary": tm["summary"],
                    "status": tm["status"],
                    "kind": tm["kind"],
                    "refs": tm["refs"],
                })
            chosen[sid] = started
            index[sid] = {"route": slug, "group": group, "tacks": qualified}
    return index


def _tack_route_for(cwd: Path | None, branch: str | None,
                    project: str | None) -> tuple[str | None, str | None]:
    """(route_slug, route_group) for a session. Candidate route names, most to
    least authoritative: a `.tack` pin file at cwd (tack's own primary), the
    branch name, then the resolved project name (exact or lowercased). The
    project tier is the common case for work on a default branch with no pin —
    route slugs are typically the project name. Returns the first candidate
    that resolves to a real route; (None, None) if none do."""
    pin = _tack_pin_slug(cwd) if cwd is not None else None
    candidates = [pin, branch]
    if project:
        # Match the project both whole and as its last path segment, each
        # cased and lowercased: a project resolved as `cpeterson/ai-sdlc`
        # (git-remote form) should still correlate to route `ai-sdlc`.
        for p in (project, project.rsplit("/", 1)[-1]):
            candidates += [p, p.lower()]
    for name in candidates:
        route = _read_route(name)
        if route:
            return route
    return (None, None)


def _icon_local_path(sh: str) -> Path | None:
    """The on-disk icon file for a session: the icon discovered at the anchor
    (PROV-08). None when the file is gone or its suffix isn't an allowed image
    type. That extension check is the /icon route's exfil guard (WIP-08): the
    request supplies only a hash, so the served path is beacon's own discovery
    rather than anything a caller named."""
    raw = _read_state_for(sh, "anchor.icon")
    if not raw:
        return None
    p = Path(raw).expanduser()
    if p.is_file() and p.suffix.lower() in ICON_CONTENT_TYPES:
        return p
    return None


def _session_icon_ref(sh: str) -> str | None:
    """The `icon` field for a wip record (PROV-08): the serve route reference
    `/icon/<hash>`, which the live dashboard resolves against the loopback
    endpoint it already polls (WIP-08). None when no icon resolves — the
    record's `icon` field is then null."""
    return f"/icon/{sh}" if _icon_local_path(sh) else None


def _resolve_session(sh: str, session_index: dict | None = None,
                     branch_cache: dict | None = None,
                     epoch: float | None = None,
                     compute_branch: bool = True) -> dict | None:
    """Point-in-time state for one session from stored fields only (no live
    providers). None when the hash carries no real beacon session.
    session_index (session id → {route, group, tacks}) supplies the
    authoritative tack join; cwd/branch/project correlation is the fallback
    when tack never registered the session. branch_cache memoizes the per-cwd
    git branch probe across a fleet scan; epoch supplies the precomputed
    last-activity mtime (from _session_mtimes) so a fleet scan needn't re-glob
    per hash. compute_branch=False skips the git branch probe (and the
    branch tier of the route fallback) — used for the cheap first pass of a
    fleet scan, since branch feeds neither the dedup nor the activity window,
    so it is filled in only for the sessions actually emitted."""
    project = _read_state_for(sh, "anchor.project") or _read_state_for(sh, "override.project")
    cwd = _read_state_for(sh, "anchor.cwd")
    cwd_path = Path(cwd).expanduser() if cwd else None
    display_cwd = _local_path_at(cwd_path) if cwd_path else None
    project = project or display_cwd
    # A work stream needs a location. A hash with only a claude_session_id and
    # no project/cwd anchor (e.g. a session that never reached SessionStart)
    # carries no signal for the dashboard — drop it.
    if not project:
        return None

    mode, note = _read_mode_for(sh)
    activity = _normalize_activity(_read_state_for(sh, "activity"))
    pending = (STATE_DIR / f"{sh}.pending-attention").exists()
    # The fleet reads the axes the way a tab paints them, so a glance at either
    # surface answers the same question: color for activity, glyph for mode.
    color_state = _color_state_for({"activity": activity, "pending_attention": pending})

    claude_session = _read_state_for(sh, "claude_session_id") or ""
    branch = (_branch_for(cwd_path, branch_cache) if compute_branch else None) if cwd_path else None
    route, route_group, tacks = (None, None, [])
    if session_index and claude_session in session_index:
        entry = session_index[claude_session]
        route, route_group, tacks = entry["route"], entry["group"], entry["tacks"]
    else:
        # Location-correlated (WIP-02 tiers 2-4) — route only, no recorded
        # session→tack binding, so the bound-tack list stays empty (WIP-09).
        route, route_group = _tack_route_for(cwd_path, branch, project)

    # task (PROV-02) isn't anchored like project; take the last-rendered value
    # from the resolved snapshot — it already folds in the override / PR-title /
    # branch chain — preferring a fresher explicit override when one is set.
    # STATE-12: the done cycle shows no task, even if an override.task is set.
    task = _read_state_for(sh, "override.task")
    if not task:
        raw = _read_state_for(sh, "resolved")
        if raw:
            try:
                task = (json.loads(raw) or {}).get("task") or None
            except (ValueError, TypeError):
                task = None
    if mode == "done":
        task = None

    lt_raw = _read_state_for(sh, "latest_turn")
    latest_turn = None
    if lt_raw:
        try:
            latest_turn = json.loads(lt_raw)
        except (ValueError, TypeError):
            latest_turn = None

    return {
        "session": claude_session,
        "hash": sh,
        "project": project,
        "task": task or None,
        "latest_turn": latest_turn,
        "route": route,
        "route_group": route_group,
        "tacks": tacks,
        # Nested, matching `beacon json` (CMD-15): mode and note are one value
        # with one writer, so a consumer can't reach the note without the mode it
        # annotates. Both published payloads carry the tuple in the same shape —
        # a flat top-level `note` here is the shape that let the old
        # `description` drift into claiming to be session-level recall context.
        "mode": {"name": mode, "note": note, "glyph": _mode_glyph(mode)},
        "activity": activity,
        # The color a tab in this state is painted, so the dashboard dot and the
        # tab agree without the browser re-deriving the mapping.
        "color_state": color_state,
        "icon": _session_icon_ref(sh),
        "cwd": display_cwd,
        "branch": branch,
        "_epoch": epoch if epoch is not None else _session_last_activity(sh),
        "pending_attention": pending,
        "focusable": bool(_read_state_for(sh, "iterm_session_id")),
        "agent_color": _read_state_for(sh, "cc.agent_color") or None,
    }


def _iso(epoch: float) -> str:
    return datetime.fromtimestamp(epoch, timezone.utc).isoformat()


_DURATION_RE = re.compile(r"^\s*(\d+)\s*([smhdw])\s*$", re.IGNORECASE)
_DURATION_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}


def _parse_since(s: str | None, strict: bool) -> float | None:
    """Resolve a `--since` value to epoch seconds. Accepts a relative duration
    (`90s`, `30m`, `2h`, `1d`, `1w` → that long ago) or an ISO-8601 timestamp.
    strict (CLI) exits on bad input; lenient (the HTTP server) returns None so
    one bad query can't take it down."""
    if not s:
        return None
    m = _DURATION_RE.match(s)
    if m:
        return time.time() - int(m.group(1)) * _DURATION_UNITS[m.group(2).lower()]
    try:
        dt = datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        if strict:
            sys.exit(f"invalid time value: {s!r} (expected a duration like 1d/2h/30m or an ISO-8601 timestamp)")
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.timestamp()


def collect_sessions(since_epoch: float | None = None, timing: bool = False) -> dict:
    # Sessions in a mode are exempt from the activity window: a declared mode is
    # deliberate and stays relevant however long it sits, so it
    # survives past since_epoch where an idle/working session of the same age
    # would be dropped. (The fleet view pins these to the right.)
    now = time.time()
    t = time.perf_counter
    t0 = t()
    session_index = _tack_session_index()
    t_index = t()
    mtimes = _session_mtimes()
    t_mtimes = t()
    # Phase A — cheap resolve (no per-cwd git branch). branch feeds neither the
    # dedup nor the activity window below, so the emitted set is determined
    # first and git is probed only for survivors (Phase B). On a long-lived
    # fleet the window drops the vast majority, so this avoids hundreds of
    # subprocess spawns to surface a handful of recent sessions.
    resolved = []
    for sh, epoch in mtimes.items():
        s = _resolve_session(sh, session_index, epoch=epoch, compute_branch=False)
        if s:
            resolved.append(s)
    t_cheap = t()
    # WIP-01: one record per Claude session. A session that moved panes
    # (e.g. `claude --resume` in a new pane) leaves its prior pane's state
    # bucket behind, so two hashes can carry the same Claude session id —
    # the most recently active bucket wins. Records with no session id are
    # distinct panes, not joinable duplicates; keep them all.
    newest_by_sid: dict[str, dict] = {}
    no_sid = []
    for s in resolved:
        sid = s["session"]
        if not sid:
            no_sid.append(s)
        elif sid not in newest_by_sid or s["_epoch"] > newest_by_sid[sid]["_epoch"]:
            newest_by_sid[sid] = s
    survivors = []
    for s in no_sid + list(newest_by_sid.values()):
        epoch = s["_epoch"]
        if (since_epoch is not None and epoch < since_epoch
                and _record_mode(s)[0] == DEV_MODE):
            continue
        survivors.append(s)
    # Phase B — fill the per-cwd git branch (and the branch-dependent route
    # fallback) for the emitted set only, memoized so a repo with many surviving
    # sessions is still probed once. Re-resolving the survivor reuses the one
    # code path, so the record is identical to a single-pass resolve.
    branch_cache: dict[str, str | None] = {}
    sessions = []
    for s in survivors:
        epoch = s.pop("_epoch", 0.0)
        full = _resolve_session(s["hash"], session_index, branch_cache=branch_cache,
                                epoch=epoch, compute_branch=True) or s
        full.pop("_epoch", None)
        full["last_activity"] = _iso(epoch) if epoch else None
        full["age_seconds"] = int(now - epoch) if epoch else None
        sessions.append(full)
    sessions.sort(key=lambda s: (s["route"] or "~", s["project"] or "", s["session"]))
    t_done = t()
    if timing:
        sys.stderr.write(
            "beacon wip timing: "
            f"total={t_done - t0:.3f}s "
            f"tack-index={t_index - t0:.3f}s "
            f"mtimes={t_mtimes - t_index:.3f}s "
            f"cheap-resolve={t_cheap - t_mtimes:.3f}s "
            f"branch-fill={t_done - t_cheap:.3f}s | "
            f"hashes={len(mtimes)} resolved={len(resolved)} "
            f"emitted={len(sessions)} git-probes={len(branch_cache)}\n"
        )
    return {
        "generated_at": _iso(now),
        "window_since": _iso(since_epoch) if since_epoch else None,
        "sessions": sessions,
    }


# The fleet dot mirrors the tab: activity, three colors, and nothing else. A
# mode reads as its glyph in the same row, exactly as it does on a tab.
_WIP_DOT_COLOR = {"ready": "37", "busy": "33", "blocked": "31"}


def _record_mode(record: dict) -> tuple[str, str]:
    """The `(name, note)` tuple out of a wip record's nested `mode` (WIP-01).
    One accessor so the fleet renderers don't each reach two levels in, and so
    the payload's shape has exactly one place to change."""
    return _mode_tuple(record.get("mode"))


def _wip_state_cell(mode: str, activity: str) -> str:
    """The fleet row's state column: `release·waiting` when a mode is declared,
    the bare activity otherwise. Both axes, because a moded session that is
    blocked on the user has to read as blocked — the merged field could show only
    one of the two, and the mode was the one that won."""
    return f"{mode}·{activity}" if mode != DEV_MODE else activity


def _wip_note_segment(note: str) -> str:
    """WIP-12: a mode's note, with a `—` lead-in, present only when set."""
    return f"— {note}" if note else ""


def _display_width(s: str) -> int:
    """Terminal columns `s` occupies, not characters. The mode glyphs are the
    reason: 🚀 📋 🏁 are one character but two columns wide (East Asian `W`), so
    padding a column by len() leaves every glyph-bearing row one short and the
    grid visibly ragged. `⏸` and `…` are single-width, so the set is mixed and
    a flat per-glyph fudge would not do either."""
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def _ljust(s: str, width: int) -> str:
    """str.ljust by display width (see _display_width)."""
    return s + " " * max(0, width - _display_width(s))


def _fmt_age(secs: int | None) -> str:
    if secs is None:
        return ""
    if secs < 60:
        return f"{secs}s ago"
    if secs < 3600:
        return f"{secs // 60}m ago"
    if secs < 86400:
        return f"{secs // 3600}h ago"
    return f"{secs // 86400}d ago"


def _print_wip_human(payload: dict) -> None:
    sessions = payload["sessions"]
    if not sessions:
        print("No active beacon sessions.")
        return
    by_route: dict[str, list] = {}
    for s in sessions:
        by_route.setdefault(s["route"] or "(unrouted)", []).append(s)
    # Routed work is the signal; park the catch-all "(unrouted)" group last.
    routes = sorted(r for r in by_route if r != "(unrouted)") + (
        ["(unrouted)"] if "(unrouted)" in by_route else [])
    for route in routes:
        group = by_route[route]
        grp = group[0].get("route_group")
        print(_color("1", route + (f"  [{grp}]" if grp else "")))
        modes = {s["hash"]: _record_mode(s) for s in group}
        cells = {s["hash"]: _wip_state_cell(modes[s["hash"]][0], s["activity"])
                 for s in group}
        cellw = max(len(c) for c in cells.values())
        names = {s["hash"]: _wip_display_name(s, modes[s["hash"]][0]) for s in group}
        namew = max(_display_width(n) for n in names.values())
        for s in group:
            dot = _color(_WIP_DOT_COLOR.get(s["color_state"], "37"), "●")
            mode_note = modes[s["hash"]][1]
            seg = _wip_note_segment(_first_line(mode_note))
            note = f"  {seg}" if seg else ""
            # Current focus is the last bound tack (WIP-09); tag it
            # existing/emerging so a glance distinguishes resumed tracked work
            # from work spun up this session.
            tk = ""
            if s.get("tacks"):
                cur = s["tacks"][-1]
                tk = _color("2", f"  {cur['tack_id']}·{cur['kind']}")
            print(f"  {dot} {_ljust(names[s['hash']], namew)}  "
                  f"{cells[s['hash']]:<{cellw}}  {_fmt_age(s['age_seconds'])}{tk}{note}")
    if payload.get("window_since"):
        print()
        print(_color("2", f"window: since {payload['window_since']} — pass --all for full history"))


def _window_since(all_flag: bool, since_arg: str | None, strict: bool) -> float | None:
    """Resolve the activity window: `--all` → no filter; explicit `--since` →
    that time; otherwise the default trailing window."""
    if all_flag:
        return None
    if since_arg:
        return _parse_since(since_arg, strict=strict)
    return time.time() - DEFAULT_WINDOW_SECONDS


def cmd_wip(args):
    since = _window_since(getattr(args, "all", False), getattr(args, "since", None), strict=True)
    payload = collect_sessions(since, timing=getattr(args, "timing", False))
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2))
    else:
        _print_wip_human(payload)


def _watch_frame_lines(payload: dict, cols: int) -> list[str]:
    """Render the live work-stream view as a flat recency feed: most-recently
    active session on top, so a pane that transitions (working / waiting) rises
    to the head of the list. Distinct from _print_wip_human's route grouping —
    here motion *is* the signal."""
    sessions = sorted(
        payload["sessions"],
        key=lambda s: (s["age_seconds"] is None, s["age_seconds"] or 0),
    )
    win = payload.get("window_since")
    hint = (f"since {win} · " if win else "") + "q to quit"
    lines = [_color("1", "beacon · live work streams"), _color("2", hint), ""]
    if not sessions:
        lines.append("No active beacon sessions.")
        return lines

    rows = []
    for s in sessions:
        # Show the route only when it carries signal the project name doesn't.
        # A route resolved by matching the project (the tier-3 case in
        # _tack_route_for) just echoes it; a pin- or branch-derived route does
        # not, so keep those.
        proj = s.get("project") or ""
        route_slug = s.get("route") or ""
        echoes_project = not route_slug or route_slug.lower() in {proj.lower(), proj.rsplit("/", 1)[-1].lower()}
        mode, mode_note = _record_mode(s)
        rows.append({
            "dot": _color(_WIP_DOT_COLOR.get(s["color_state"], "37"), "●"),
            "name": _wip_display_name(s, mode),
            "state": _wip_state_cell(mode, s["activity"]),
            "age": _fmt_age(s["age_seconds"]),
            "route": "" if echoes_project else f"[{route_slug}]",
            "note": _first_line(mode_note),
        })
    namew = max(_display_width(r["name"]) for r in rows)
    statew = max(len(r["state"]) for r in rows)
    agew = max(len(r["age"]) for r in rows)
    routew = max(len(r["route"]) for r in rows)

    # Every column is padded to a fixed width, so the visible prefix width
    # (dot + space + columns + separators) is the same for every row.
    used = 2 + namew + 2 + statew + 2 + agew
    if routew:
        used += 2 + routew

    for r in rows:
        cells = f"{_ljust(r['name'], namew)}  {r['state'].ljust(statew)}  {r['age'].rjust(agew)}"
        if routew:
            cells += "  " + _color("2", r["route"].ljust(routew))
        note = ""
        if r["note"]:
            avail = cols - used - 4
            if avail > 1:
                d = r["note"] if len(r["note"]) <= avail else r["note"][: avail - 1] + "…"
                seg = _wip_note_segment(d)
                if seg:
                    note = _color("2", f"  {seg}")
        lines.append(f"{r['dot']} {cells}{note}")
    return lines


def _watch_paint(lines: list[str], last: list[str] | None) -> None:
    """Repaint only the rows that changed since the last frame, addressing each
    by absolute position so an idle fleet writes nothing. No full clear between
    frames — that's what makes it flicker-free where `watch beacon wip` isn't."""
    out: list[str] = []
    if last is None:
        out.append("\x1b[H\x1b[J")
        out.append("\r\n".join(f"{ln}\x1b[K" for ln in lines))
    else:
        for i, ln in enumerate(lines):
            if i >= len(last) or ln != last[i]:
                out.append(f"\x1b[{i + 1};1H{ln}\x1b[K")
        for i in range(len(lines), len(last)):
            out.append(f"\x1b[{i + 1};1H\x1b[K")
    sys.stdout.write("".join(out))
    sys.stdout.flush()


def cmd_watch(args):
    """Live, person-facing work-stream view. Interactive by definition, so it
    requires a TTY and always colors — the scriptable/pipeable surface is
    `beacon wip`."""
    if not sys.stdout.isatty():
        sys.exit("beacon watch needs an interactive terminal; pipe `beacon wip` instead")
    global _COLOR_OVERRIDE
    if _COLOR_OVERRIDE is None:  # an explicit --color flag still wins
        _COLOR_OVERRIDE = True
    interval = max(0.2, getattr(args, "interval", 1.0) or 1.0)
    since = _window_since(getattr(args, "all", False), getattr(args, "since", None), strict=True)
    if _watch_supports_raw():
        _watch_raw(since, interval)
    else:
        _watch_polling(since, interval)


def _watch_supports_raw() -> bool:
    # The single-keypress loop needs POSIX terminal control. Windows has no
    # termios/tty and select() can't wait on stdin there, so it polls instead.
    try:
        import termios  # noqa: F401
        import tty  # noqa: F401
        import select  # noqa: F401
    except ImportError:
        return False
    try:
        sys.stdin.fileno()
    except (OSError, ValueError):
        return False
    return True


def _watch_frame(since, cols: int, rows: int) -> list[str]:
    lines = _watch_frame_lines(collect_sessions(since), cols)
    if len(lines) > rows:
        lines = lines[: rows - 1] + [_color("2", f"…+{len(lines) - (rows - 1)} more")]
    return lines


def _watch_raw(since, interval):
    import termios
    import tty
    import select
    import signal

    fd = sys.stdin.fileno()
    old_attrs = termios.tcgetattr(fd)
    resized = {"flag": True}
    cols = rows = 0
    try:
        signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__("flag", True))
        tty.setcbreak(fd)
        sys.stdout.write("\x1b[?1049h\x1b[?25l")
        last: list[str] | None = None
        while True:
            if resized["flag"]:
                cols, rows = os.get_terminal_size()
                last = None
                resized["flag"] = False
            lines = _watch_frame(since, cols, rows)
            _watch_paint(lines, last)
            last = lines
            ready, _, _ = select.select([sys.stdin], [], [], interval)
            if ready and sys.stdin.read(1) in ("q", "Q"):
                break
    except KeyboardInterrupt:
        pass
    finally:
        signal.signal(signal.SIGWINCH, signal.SIG_DFL)
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)


def _watch_polling(since, interval):
    # Fallback for terminals without POSIX control (Windows Terminal, VS Code):
    # no single-key quit and no SIGWINCH, so poll terminal size each tick and
    # exit on Ctrl-C. The alternate screen + hidden cursor and the per-row diff
    # in _watch_paint are honored by any VT-capable terminal, so it stays
    # flicker-free; a column change resets the diff for a clean repaint.
    sys.stdout.write("\x1b[?1049h\x1b[?25l")
    last: list[str] | None = None
    prev_cols = -1
    try:
        while True:
            try:
                cols, rows = os.get_terminal_size()
            except OSError:
                cols, rows = 80, 24
            if cols != prev_cols:
                last = None
                prev_cols = cols
            lines = _watch_frame(since, cols, rows)
            _watch_paint(lines, last)
            last = lines
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()


def _prune_cache(cutoff: float) -> int:
    """Sweep the per-pane handoff files and engagement markers (WIP-06). These
    are keyed by pane GUID, not session hash, and the hash is a one-way SHA-1 of
    the GUID — so a pruned session's cache files cannot be derived from its
    state files, and the sweep goes by the file's own mtime instead. Both writers
    rewrite on every prompt (`cwd-*.txt`) or re-touch on every hook
    (`engaged-*`), so mtime tracks the pane's activity the same way
    `_session_last_activity` does. The current pane is always kept, matching the
    state sweep. Without this the cache grew without bound: files accumulated for
    every pane ever opened, long after the matching state was pruned."""
    key = _iterm_cache_key()
    keep = {f"cwd-{key}.txt", f"engaged-{key}"} if key else set()
    removed = 0
    # `url-*.txt` is the URL handoff file 2.0 retired (STATUS-BAR-08 resolves at
    # click time now). No writer creates one, but every pane that ran an earlier
    # version left one behind and nothing has ever collected them — so the sweep
    # names it explicitly rather than leaving thousands of files no code reads.
    # Patterns are enumerated, not inferred, because the cache dir also holds
    # non-per-pane files the sweep must not touch.
    for pattern in ("cwd-*.txt", "engaged-*", "url-*.txt"):
        for p in CACHE_DIR.glob(pattern):
            if p.name in keep:
                continue
            try:
                if p.stat().st_mtime >= cutoff:
                    continue
                p.unlink()
                removed += 1
            except OSError:
                pass
    return removed


def cmd_prune(args):
    """Remove per-session state for sessions idle longer than the threshold —
    a GC for the panes beacon has accumulated state for. The current session is
    always kept; pruned sessions simply repaint on their next hook event."""
    raw = getattr(args, "keep", None) or "30d"
    cutoff = _parse_since(raw, strict=True)
    current = session_hash()
    sessions = files = 0
    for sh in _all_session_hashes():
        if sh == current or _session_last_activity(sh) >= cutoff:
            continue
        for p in STATE_DIR.glob(f"{sh}.*"):
            try:
                p.unlink()
                files += 1
            except OSError:
                pass
        sessions += 1
    cached = _prune_cache(cutoff)
    print(f"pruned {sessions} session(s) idle longer than {raw} "
          f"({files} state files, {cached} cache files removed)")


def _forget_session(sh: str) -> tuple[bool, int]:
    """Delete all per-session state for one session, addressed by its per-pane
    hash (FORGET-01). Returns (valid, files_removed); valid is False only when
    the hash is malformed — the hex guard keeps the glob from escaping the
    state bucket, the same defense _focus_session uses. Forgetting a session
    with no state on disk is a no-op that still reports valid: forget is
    idempotent, so a double-click or a stale dashboard card resolves the same
    way. Unlike prune (age sweep, always keeps the current session), forget
    targets one named session — the caller decides which."""
    if not re.fullmatch(r"[0-9a-f]{8,}", sh or ""):
        return False, 0
    files = 0
    for p in STATE_DIR.glob(f"{sh}.*"):
        try:
            p.unlink()
            files += 1
        except OSError:
            pass
    return True, files


def cmd_forget(args):
    """Delete all per-session state for a single session, addressed by its
    per-pane hash (the `hash` field of a `wip --json` record). The targeted
    form of `prune`: prune sweeps by age, forget removes one named stale
    session. The fleet dashboard's close button drives the `POST /forget`
    route (FORGET-01); this is the CLI equivalent."""
    sh = (getattr(args, "hash", "") or "").strip()
    valid, files = _forget_session(sh)
    if not valid:
        print(f"not a session hash: {sh!r}", file=sys.stderr)
        sys.exit(2)
    print(f"forgot session {sh} ({files} state file(s) removed)")


# --- full-fidelity export / import (DUMP) ---
#
# Unlike `wip` (a derived, windowed, tack-joined *view*), export is a
# lossless backup: every `<hash>.<field>` file's raw text, verbatim, so import
# reconstructs byte-for-byte what the plugin reads. The envelope mirrors tack's
# backup shape (schemaVersion / exportedAt / generator / sessions[]) and surfaces
# `claude_session_id` per record — the join key tack records as `sessions[].id`,
# so a beacon dump and a tack dump correlate on that field without guessing.

EXPORT_SCHEMA_VERSION = 1


def _export_payload() -> dict:
    """Lossless snapshot of every per-session state file (DUMP-01). Each record
    carries the raw text of every `<hash>.<field>` and the session's newest
    mtime, so import restores both content and the activity-window signal
    (WIP-03) the fleet scan reads. cache/ is excluded — it is regenerable shell
    handoff, not source-of-record state."""
    sessions = []
    for sh in _all_session_hashes():
        fields: dict[str, str] = {}
        newest = 0.0
        for p in sorted(STATE_DIR.glob(f"{sh}.*")):
            if not p.is_file():
                continue
            field = p.name.split(".", 1)[1]
            try:
                fields[field] = p.read_text(encoding="utf-8")
                newest = max(newest, p.stat().st_mtime)
            except OSError:
                continue
        if not fields:
            continue
        sessions.append({
            "hash": sh,
            "claude_session_id": (fields.get("claude_session_id") or "").strip() or None,
            "last_activity": _iso(newest) if newest else None,
            "mtime": newest or None,
            "fields": fields,
        })
    return {
        "schemaVersion": EXPORT_SCHEMA_VERSION,
        "exportedAt": _iso(time.time()),
        "generator": f"beacon {_plugin_version()}",
        "dataDir": str(DATA_DIR),
        "sessions": sessions,
    }


def cmd_export(args):
    """Emit a lossless JSON backup of all per-session state (DUMP-01/02) — to
    stdout by default, or to `--out-file FILE` (gzip when `--compress` is given
    or the path ends `.gz`, matching the tack-backup convention)."""
    payload = _export_payload()
    data = json.dumps(payload, indent=2)
    out = getattr(args, "out_file", None)
    if not out:
        sys.stdout.write(data + "\n")
        return
    dest = Path(out).expanduser()
    if getattr(args, "compress", False) or dest.suffix == ".gz":
        import gzip
        with gzip.open(dest, "wt", encoding="utf-8") as fh:
            fh.write(data)
    else:
        dest.write_text(data, encoding="utf-8")
    n = len(payload["sessions"])
    print(f"exported {n} session{'s' if n != 1 else ''} to {dest}", file=sys.stderr)


def _read_maybe_gzip(path: Path) -> str:
    """Text of a file that may be gzip-compressed — detected by magic bytes, so
    a `.json` or `.json.gz` (or misnamed) backup both read correctly."""
    raw = path.read_bytes()
    if raw[:2] == b"\x1f\x8b":
        import gzip
        return gzip.decompress(raw).decode("utf-8")
    return raw.decode("utf-8")


def cmd_import(args):
    """Restore per-session state from an export (DUMP-03). Non-destructive by
    default: a session already present on disk is skipped (so a restore can't
    clobber a live fleet) unless `--force` overwrites it; state files not named
    in the export are never touched. Refuses an unrecognized schemaVersion
    rather than guessing at a format it can't faithfully restore."""
    src = Path(args.file).expanduser()
    try:
        raw = _read_maybe_gzip(src)
    except OSError as e:
        sys.exit(f"import: cannot read {src} ({e})")
    try:
        payload = json.loads(raw)
    except ValueError as e:
        sys.exit(f"import: {src} is not valid JSON ({e})")
    ver = payload.get("schemaVersion")
    if ver != EXPORT_SCHEMA_VERSION:
        sys.exit(f"import: unsupported schemaVersion {ver!r} — this beacon reads "
                 f"{EXPORT_SCHEMA_VERSION} (refusing to guess at the format)")

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    written = skipped = bad = 0
    for rec in payload.get("sessions") or []:
        sh = (rec.get("hash") or "").strip()
        fields = rec.get("fields") or {}
        if not re.fullmatch(r"[0-9a-f]{8,}", sh) or not fields:
            bad += 1
            continue
        if any(STATE_DIR.glob(f"{sh}.*")) and not args.force:
            skipped += 1
            continue
        mtime = rec.get("mtime")
        wrote = 0
        for field, value in fields.items():
            name = f"{sh}.{field}"
            # State files are flat, single-segment names; a field carrying a
            # path separator is a crafted export trying to write outside the
            # bucket (a `x/../y` name even normalizes back inside it). Reject it.
            if "/" in name or "\\" in name or "\x00" in name:
                bad += 1
                continue
            p = STATE_DIR / name
            p.write_text(value if isinstance(value, str) else json.dumps(value),
                         encoding="utf-8")
            if mtime:
                try:
                    os.utime(p, (mtime, mtime))
                except OSError:
                    pass
            wrote += 1
        if wrote:
            written += 1
    tail = "" if args.force else " (pass --force to overwrite)"
    msg = f"imported {written} session(s); skipped {skipped} already present{tail}"
    if bad:
        msg += f"; {bad} malformed record(s)/field(s) rejected"
    print(msg, file=sys.stderr)


# Browser origins allowed to POST the mutating routes /focus and /forget
# (FOCUS-04, FORGET-03), beyond loopback origins
# (which origin_allowed permits unconditionally). The built-in entry is the
# public dashboard's Pages origin; a foreign page's Origin is rejected.
FOCUS_ORIGIN_ALLOWLIST = {
    "https://chris-peterson.github.io",
}


def _config_file() -> Path:
    """The user config path: $XDG_CONFIG_HOME/beacon/config.json, else
    ~/.config/beacon/config.json — the same ~/.config base the systemd unit
    lives under."""
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "beacon" / "config.json"


def _load_config() -> dict:
    """Parse the user config file, or {} when it's absent or unreadable. The
    file is optional, so a missing one is the common path, not an error; a
    malformed one degrades to defaults rather than taking the daemon down."""
    path = _config_file()
    try:
        data = json.loads(path.read_text())
    except (FileNotFoundError, ValueError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


def _badge_enabled() -> bool:
    """BADGE-15: the pane badge is opt-in and off by default. The tab (color +
    two-line project/task identity) now carries what the badge used to, so
    painting it too is redundant in a tabs workflow. The machinery is retained —
    BADGE_FORMAT, COLOR_PALETTE, the badge-color / badge-format CLI verbs —
    and `"badge": "on"` in the user config re-enables it, so a later
    lifecycle-phase repurposing reuses the same gate."""
    val = _load_config().get("badge")
    return val is not None and str(val).strip().lower() in ("1", "true", "on", "yes")


def _focus_origins() -> set[str]:
    """The origin allowlist for the mutating routes /focus and /forget
    (FOCUS-04, FORGET-03): the built-in public dashboard origin plus the
    `focus_origins` list in the user config file. A private deployment (e.g. a
    GitLab Pages host) adds its origin to the config rather than editing this
    source, so internal hostnames stay out of the public tree. Read at serve
    startup — edit the config and restart to apply."""
    extra = _load_config().get("focus_origins") or []
    if isinstance(extra, str):
        extra = [extra]
    return set(FOCUS_ORIGIN_ALLOWLIST) | {o.strip() for o in extra if isinstance(o, str) and o.strip()}


def _focus_session(sh: str) -> tuple[bool, str]:
    """FOCUS-01: resolve a per-pane hash to its recorded iTerm2 focus handle
    (FOCUS-02) and bring that session forward via `beacon-iterm focus`. The
    GUID never leaves the server — the dashboard sends only the hash. Returns
    (ok, detail)."""
    if not re.fullmatch(r"[0-9a-f]{8,}", sh or ""):
        return False, "bad hash"
    guid = _read_state_for(sh, "iterm_session_id")
    if not guid:
        return False, "not focusable"
    try:
        r = subprocess.run(
            ["python3", str(BEACON_ITERM), "focus", guid],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError) as e:
        return False, f"focus failed: {e}"
    if r.returncode != 0:
        return False, (r.stderr.strip() or "focus failed")
    return True, "focused"


POST_BODY_MAX = 64 * 1024


def wip_http_server(port: int):
    """Build (don't start) the localhost fleet server, bound to 127.0.0.1 only.

    GET / — the bundled reference dashboard (dashboard/index.html), so a
    coworker with no dashboard of their own just runs `beacon serve` and opens
    the page. It polls /wip.json from this same origin.

    GET /wip.json — the read-only wip payload (WIP-04), CORS-open so a
    dashboard on file:// or the deployed Pages origin can fetch it.

    GET /icon/<hash> — the session's project icon bytes (WIP-08), CORS-open
    like wip.json. The `icon` field of a record points here when the icon is
    a local file; an online (http) icon is in the field directly.

    GET /turn/<hash> — the session's most recent turn with its *full* text
    (WIP-14), the on-demand enrichment the dashboard fetches when a card is
    expanded. The bulk /wip.json carries only the single-line excerpt (WIP-11);
    this reads the companion `latest_turn_full` state, CORS-open like wip.json.

    GET /mode-bg/<mode> — the mode watermark PNG a moded card renders (WIP-17):
    the very asset the iTerm2 pane paints (iterm/resources/<mode>-bg.png), so the
    card and pane can't drift. The filename is resolved from MODE_SPECS by mode
    name, never from the URL, so there's nothing to traverse. CORS-open like
    wip.json.

    POST /forget — delete a session's per-session state (FORGET-01), the
    dashboard's close button on a timed-out card. Mutating, so it shares the
    FOCUS-04 access model with /focus.

    POST /focus — bring a session's window forward (FOCUS-01). Mutating, so it
    carries the tighter FOCUS-04 access model: the Host header must be the
    loopback endpoint (DNS-rebind defense) and a present Origin must be on the
    dashboard allowlist — not the `*` the read route uses.

    Returns the HTTPServer; the caller drives it (serve_forever, or a single
    handle_request in tests)."""
    from http.server import BaseHTTPRequestHandler, HTTPServer
    from urllib.parse import urlparse, parse_qs

    allowed_origins = _focus_origins()

    def origin_allowed(origin: str) -> bool:
        # A missing Origin (curl, same-origin, some file:// browsers) is not
        # the threat — only a *foreign* browser origin is. A present Origin
        # must be loopback or an allowlisted dashboard.
        if not origin or origin == "null":
            return True
        try:
            host = urlparse(origin).hostname
        except ValueError:
            return False
        if host in ("127.0.0.1", "localhost"):
            return True
        return origin in allowed_origins

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code: int, body: str, origin: str = "*") -> None:
            data = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Access-Control-Allow-Origin", origin)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def _host_ok(self) -> bool:
            # DNS-rebind defense: the Host header's hostname must be loopback.
            # Port-agnostic — the bound port is ours, the hostname is the attack
            # surface (a rebound evil.com resolves to 127.0.0.1 but sends its
            # own name in Host).
            host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
            return host.strip("[]").lower() in ("127.0.0.1", "localhost", "::1")

        def _read_body(self) -> bytes:
            # Every POST reply path reads the body first, the rejections
            # included: HTTP/1.0 closes the connection after each response, and
            # closing a socket that still holds unread bytes makes Windows
            # abort it (WinError 10053) instead of delivering what was written
            # — so a 403 sent over an undrained buffer reaches the caller as a
            # connection error rather than as the rejection FOCUS-04 /
            # FORGET-03 specify. Reading at the top of do_POST rather than per
            # reply path is deliberate: an early return added later can't forget
            # the drain. The payload is one small JSON object, so the cap is far
            # above anything legitimate — a caller declaring more than that has
            # its body left partly unread and gets the abort, which is the same
            # answer as the 400 its payload would earn.
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                return b""
            if length <= 0:
                return b""
            try:
                return self.rfile.read(min(length, POST_BODY_MAX))
            except OSError:
                return b""

        def _send_icon(self, sh: str) -> None:
            # The path segment is only ever a state-file lookup key; constrain
            # it to a slash/dot-free token so it can't traverse outside the
            # state bucket (session hashes are hex, a subset of this).
            p = _icon_local_path(sh) if re.fullmatch(r"[A-Za-z0-9_-]+", sh or "") else None
            try:
                data = p.read_bytes() if p else None
            except OSError:
                data = None
            if not data:
                self._send(404, json.dumps({"error": "not found"}))
                return
            ctype = ICON_CONTENT_TYPES.get(p.suffix.lower(), "application/octet-stream")
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def _send_mode_bg(self, mode: str) -> None:
            # The mark file comes from our own MODE_SPECS constant keyed by the
            # mode name — never from the URL — so there is no path to traverse.
            spec = MODE_SPECS.get(mode)
            img = spec.get("image") if spec else None
            p = (PLUGIN_ROOT / "iterm" / "resources" / img) if img else None
            try:
                data = p.read_bytes() if p else None
            except OSError:
                data = None
            if not data:
                self._send(404, json.dumps({"error": "not found"}))
                return
            self.send_response(200)
            self.send_header("Content-Type", "image/png")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def _send_turn(self, sh: str) -> None:
            # Same slash/dot-free token guard as /icon — the segment is only a
            # state-file lookup key, never a path.
            if not re.fullmatch(r"[A-Za-z0-9_-]+", sh or ""):
                self._send(404, json.dumps({"error": "not found"}))
                return
            lt_raw = _read_state_for(sh, "latest_turn")
            try:
                lt = json.loads(lt_raw) if lt_raw else None
            except Exception:
                lt = None
            if not lt:
                self._send(404, json.dumps({"error": "no turn"}))
                return
            # Full text when present; fall back to the excerpt so a turn stored
            # before this field existed still enriches to *something*.
            full = _read_state_for(sh, "latest_turn_full")
            self._send(200, json.dumps({
                "hash": sh,
                "role": lt.get("role"),
                "text": full or lt.get("text") or "",
                "at": lt.get("at"),
            }))

        def _send_dashboard(self) -> None:
            try:
                data = DASHBOARD_HTML.read_bytes()
            except OSError:
                self._send(404, json.dumps({"error": "dashboard not found"}))
                return
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            parsed = urlparse(self.path)
            if parsed.path in ("/", "/index.html"):
                self._send_dashboard()
            elif parsed.path == "/wip.json":
                q = parse_qs(parsed.query)
                all_flag = q.get("all", ["0"])[0] in ("1", "true")
                since = _window_since(all_flag, q.get("since", [None])[0], strict=False)
                self._send(200, json.dumps(collect_sessions(since)))
            elif parsed.path.startswith("/icon/"):
                self._send_icon(parsed.path[len("/icon/"):])
            elif parsed.path.startswith("/turn/"):
                self._send_turn(parsed.path[len("/turn/"):])
            elif parsed.path.startswith("/mode-bg/"):
                self._send_mode_bg(parsed.path[len("/mode-bg/"):])
            else:
                self._send(404, json.dumps({"error": "not found"}))

        def do_OPTIONS(self):
            origin = self.headers.get("Origin") or ""
            if (urlparse(self.path).path in ("/focus", "/forget")
                    and self._host_ok() and origin_allowed(origin)):
                self.send_response(204)
                self.send_header("Access-Control-Allow-Origin", origin or "*")
                self.send_header("Access-Control-Allow-Methods", "POST, OPTIONS")
                self.send_header("Access-Control-Allow-Headers", "Content-Type")
                self.send_header("Access-Control-Max-Age", "600")
                self.end_headers()
            else:
                self.send_response(403)
                self.end_headers()

        def do_POST(self):
            origin = self.headers.get("Origin") or ""
            path = urlparse(self.path).path
            raw = self._read_body()
            if path not in ("/focus", "/forget"):
                self._send(404, json.dumps({"error": "not found"}))
                return
            if not self._host_ok() or not origin_allowed(origin):
                self._send(403, json.dumps({"error": "forbidden"}), origin or "*")
                return
            try:
                sh = (json.loads(raw or b"{}").get("hash") or "").strip()
            except (ValueError, AttributeError):
                sh = ""
            if path == "/focus":
                ok, msg = _focus_session(sh)
                code = 200 if ok else (404 if msg == "not focusable" else 400)
                self._send(code, json.dumps({"focused": ok, "detail": msg}), origin or "*")
            else:
                valid, files = _forget_session(sh)
                self._send(200 if valid else 400,
                           json.dumps({"forgotten": valid, "files": files}), origin or "*")

    return HTTPServer(("127.0.0.1", port), Handler)


def cmd_serve(args):
    """Serve the wip payload over localhost, or manage the always-on unit that
    keeps that server running. Bare `serve` runs in the foreground (so a
    locally-opened dashboard can poll for near-realtime signal); `install` /
    `uninstall` / `status` manage the launchd/systemd supervised process."""
    action = getattr(args, "action", None) or "run"
    port = getattr(args, "port", None) or DEFAULT_SERVE_PORT
    if action == "install":
        sys.exit(0 if _service_install(port) else 1)
    if action == "uninstall":
        sys.exit(0 if _service_uninstall() else 1)
    if action == "status":
        _service_status()
        return
    _serve_foreground(port)


def _serve_foreground(port: int):
    server = wip_http_server(port)
    try:
        print(f"beacon serve → http://127.0.0.1:{port}/  dashboard, /wip.json data  (Ctrl-C to stop)")
        server.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        server.server_close()


# --- managed serve service ---
#
# Keeps `beacon serve` always running so an external dashboard has a stable
# endpoint to poll. The state files remain the source of record; the server is
# a stateless projection (it re-reads them on every GET), so it can die and
# respawn between two polls without losing anything. The unit invokes the
# stable wrapper (~/.local/bin/beacon), not the version-pinned script path, so
# a plugin upgrade that refreshes the wrapper keeps the service working without
# rewriting the unit.

SERVICE_LABEL = "com.beacon.serve"
DEFAULT_SERVE_PORT = 8787


def _wrapper_path() -> Path:
    return Path.home() / ".local" / "bin" / "beacon"


def _launchd_plist_path() -> Path:
    return Path.home() / "Library" / "LaunchAgents" / f"{SERVICE_LABEL}.plist"


def _systemd_unit_path() -> Path:
    return Path.home() / ".config" / "systemd" / "user" / "beacon-serve.service"


def _render_launchd_plist(wrapper: Path, port: int, log: Path, errlog: Path) -> str:
    args = "".join(f"        <string>{a}</string>\n"
                   for a in (str(wrapper), "serve", "--port", str(port)))
    return (
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
        '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
        '<plist version="1.0">\n'
        '<dict>\n'
        f'    <key>Label</key>\n    <string>{SERVICE_LABEL}</string>\n'
        f'    <key>ProgramArguments</key>\n    <array>\n{args}    </array>\n'
        '    <key>RunAtLoad</key>\n    <true/>\n'
        '    <key>KeepAlive</key>\n    <true/>\n'
        f'    <key>StandardOutPath</key>\n    <string>{log}</string>\n'
        f'    <key>StandardErrorPath</key>\n    <string>{errlog}</string>\n'
        '</dict>\n</plist>\n'
    )


def _render_systemd_unit(wrapper: Path, port: int) -> str:
    return (
        "[Unit]\n"
        "Description=beacon fleet dashboard (serve)\n"
        "After=default.target\n\n"
        "[Service]\n"
        f"ExecStart={wrapper} serve --port {port}\n"
        "Restart=always\n"
        "RestartSec=2\n\n"
        "[Install]\n"
        "WantedBy=default.target\n"
    )


def _run_supervisor(cmd: list[str]) -> subprocess.CompletedProcess:
    """Run a launchctl/systemctl command, turning a missing binary or a hang
    into a non-zero result instead of an exception. `serve` is user-facing,
    so call sites surface r.stderr as a `! ...` line; an uncaught TimeoutExpired
    / FileNotFoundError would replace that with a traceback."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as e:
        return subprocess.CompletedProcess(cmd, 1, "", str(e))


def _launchctl(*args) -> subprocess.CompletedProcess:
    return _run_supervisor(["launchctl", *args])


def _systemctl(*args) -> subprocess.CompletedProcess:
    return _run_supervisor(["systemctl", "--user", *args])


def _service_supervisor() -> str:
    """Which init system manages the service here: 'launchd' on macOS,
    'systemd' on Linux when the systemctl binary is present, else 'none'.
    The systemd probe is `systemctl --user --version` (binary present); a
    user instance that isn't actually running surfaces later, when
    `enable --now` fails in _service_install."""
    if sys.platform == "darwin":
        return "launchd"
    if _systemctl("--version").returncode == 0:
        return "systemd"
    return "none"


def _service_install(port: int, indent: str = "") -> bool:
    wrapper = _wrapper_path()
    if not wrapper.exists():
        print(f"{indent}! wrapper not found at {wrapper} — run `beacon install` first")
        return False
    sup = _service_supervisor()

    if sup == "launchd":
        logs = DATA_DIR / "logs"
        logs.mkdir(parents=True, exist_ok=True)
        plist = _launchd_plist_path()
        plist.parent.mkdir(parents=True, exist_ok=True)
        plist.write_text(_render_launchd_plist(
            wrapper, port, logs / "serve.out.log", logs / "serve.err.log"))
        domain = f"gui/{os.getuid()}"
        _launchctl("bootout", domain, str(plist))  # clear any prior load
        r = _launchctl("bootstrap", domain, str(plist))
        if r.returncode != 0:
            legacy = _launchctl("load", "-w", str(plist))  # older launchctl
            if legacy.returncode != 0:
                # Prefer bootstrap's stderr — the load retry's is usually empty
                # or a deprecation notice on modern macOS, so it would mask the
                # actionable diagnostic.
                err = r.stderr.strip() or legacy.stderr.strip()
                print(f"{indent}! launchctl could not load {plist}: {err}")
                return False
        print(f"{indent}✓ launchd agent loaded → http://127.0.0.1:{port}/")
        return True

    if sup == "systemd":
        unit = _systemd_unit_path()
        unit.parent.mkdir(parents=True, exist_ok=True)
        unit.write_text(_render_systemd_unit(wrapper, port))
        _systemctl("daemon-reload")
        r = _systemctl("enable", "--now", "beacon-serve")
        if r.returncode == 0:
            print(f"{indent}✓ systemd user unit enabled → http://127.0.0.1:{port}/")
            return True
        print(f"{indent}! systemctl could not enable beacon-serve: {r.stderr.strip()}")
        return False

    print(f"{indent}! no supervised-process manager (launchd/systemd) here")
    print(f"{indent}  run it yourself: beacon serve --port {port} &")
    return False


def _service_uninstall() -> bool:
    """Tear down the unit and report on the teardown, not just the file. A
    `bootout`/`disable` that fails (service wedged, permissions) while the unit
    file unlinks fine would otherwise read as a clean removal."""
    sup = _service_supervisor()
    if sup == "launchd":
        plist = _launchd_plist_path()
        if not plist.exists():
            print("✓ no launchd agent installed")
            return True
        r = _launchctl("bootout", f"gui/{os.getuid()}", str(plist))
        if r.returncode != 0:
            r = _launchctl("unload", str(plist))  # older launchctl
        plist.unlink(missing_ok=True)
        if r.returncode != 0:
            print(f"! launchd agent file removed, but unload failed: {r.stderr.strip()}")
            return False
        print("✓ launchd agent removed")
        return True
    if sup == "systemd":
        unit = _systemd_unit_path()
        if not unit.exists():
            print("✓ no systemd user unit installed")
            return True
        r = _systemctl("disable", "--now", "beacon-serve")
        unit.unlink(missing_ok=True)
        _systemctl("daemon-reload")
        if r.returncode != 0:
            print(f"! systemd unit file removed, but disable failed: {r.stderr.strip()}")
            return False
        print("✓ systemd user unit removed")
        return True
    print("no supervised-process manager (launchd/systemd) here; nothing to remove")
    return True


def _service_status() -> None:
    sup = _service_supervisor()
    if sup == "launchd":
        plist = _launchd_plist_path()
        print(f"unit:  {plist} ({'present' if plist.exists() else 'absent'})")
        r = _launchctl("list", SERVICE_LABEL)
        print("state: loaded" if r.returncode == 0 else "state: not loaded")
    elif sup == "systemd":
        unit = _systemd_unit_path()
        print(f"unit:  {unit} ({'present' if unit.exists() else 'absent'})")
        r = _systemctl("is-active", "beacon-serve")
        print(f"state: {r.stdout.strip() or 'unknown'}")
    else:
        print("no supervised-process manager (launchd/systemd) here")
        print(f"run it yourself: beacon serve --port {DEFAULT_SERVE_PORT} &")


# --- resolver ---

def chain(providers):
    for name, fn in providers:
        try:
            v = fn()
            if v:
                return v, name
        except Exception:
            continue
    return None, None


def resolve(cwd: Path | None = None) -> dict:
    cwd = cwd or Path.cwd()

    _recover_stale_red()

    project, p_proj = chain([
        ("override",   lambda: p_override("project")),
        ("package",    lambda: p_package_name(cwd)),
        ("git-remote", lambda: p_git_remote(cwd)),
        ("dir",        lambda: p_project_dir(cwd)),
    ])
    if not project:
        project, p_proj = _local_path_at(cwd), "pwd"

    # A user's /rename does not appear here as its own tier: it is shorthand
    # for setting the task, so the harvest folds a new custom-title into
    # `override.task` (see _read_cc_signals) and it competes as an override —
    # recency-wins against `beacon set task`, rather than sitting permanently
    # below it.
    task, p_task = chain([
        ("override", lambda: p_override("task")),
        ("pr",       lambda: p_pr_title(cwd)),
        ("branch",   lambda: p_branch(cwd)),
        ("ai-title", lambda: read_state("cc.ai_title")),
    ])

    # The two state axes resolve independently — no chain between them, which is
    # the whole point. Merging them by priority meant the declared value won and
    # the observed one was discarded, so a session in `release` or `retro` could
    # not report that it was blocked on the user (RES-06).
    mode, note = read_mode()
    activity = read_activity()

    # STATE-12: `done` suppresses the task slot — a completed session shows its
    # project alone. Reversible and non-destructive: applied here at resolve
    # time, not by deleting any task override, so leaving the mode restores it.
    if mode == "done":
        task, p_task = "", "done"

    return {
        "project": project, "project_provider": p_proj,
        "task": task, "task_provider": p_task,
        "mode": mode, "note": note.strip(),
        "activity": activity,
        "pending_attention": _state_path("pending-attention").exists(),
    }


# --- CLI bridge ---

def _cli(*args, timeout: float = 5.0) -> None:
    """Invoke beacon-iterm. Failures are swallowed so the plugin never crashes
    a hook on display issues."""
    cmd = ["python3", str(BEACON_ITERM), *map(str, args)]
    try:
        subprocess.run(cmd, capture_output=True, timeout=timeout, check=False)
    except Exception:
        pass


# --- session anchor (mirrors shell/beacon.zsh _beacon_precmd) ---
#
# The navigational identity of a Claude session is the cwd Claude was invoked
# with. SessionStart captures that and publishes the full set of status-bar
# slots (project, project_full, branch×5, url) plus the per-session handoff
# files for the ↗ code / ↖ web buttons (HOOK-08). Those slots are not
# refreshed mid-session — they represent *which* session this is, not where
# Claude's current Bash subprocess happens to be. This duplicates
# project/branch/url resolution from shell/beacon.zsh — keep them in sync;
# in interactive (non-Claude) sessions the shell publishes the same slots
# on each prompt redraw and naturally tracks the user's actual PWD.

def _detect_branch_info(cwd: Path) -> tuple[str, str, str, str]:
    """Return (display, state, indicator, identity). Empty quad outside a repo.
    identity is "default" (the repo's default branch) or "feature" (#20),
    mirroring the shell's _beacon_branch_info so Claude-session and interactive
    panes classify the branch identically."""
    try:
        r = subprocess.run(
            ["git", "symbolic-ref", "--short", "HEAD"],
            cwd=str(cwd), capture_output=True, text=True, timeout=2, check=False,
        )
    except Exception:
        return ("", "", "", "")
    name = r.stdout.strip()
    if r.returncode != 0 or not name:
        return ("", "", "", "")

    state = "untracked"
    indicator = ""
    try:
        u = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"],
            cwd=str(cwd), capture_output=True, timeout=2, check=False,
        )
        if u.returncode == 0:
            counts = subprocess.run(
                ["git", "rev-list", "--left-right", "--count", "@{u}...HEAD"],
                cwd=str(cwd), capture_output=True, text=True, timeout=2, check=False,
            )
            if counts.returncode == 0:
                parts = counts.stdout.split()
                if len(parts) == 2:
                    behind, ahead = int(parts[0]), int(parts[1])
                    if ahead == 0 and behind == 0:
                        state = "clean"
                    else:
                        state = "diverged"
                        if ahead > 0:
                            indicator += f"↑{ahead}"
                        if behind > 0:
                            indicator += f"↓{behind}"
    except Exception:
        pass

    default_ref = _default_branch_ref(cwd)
    if default_ref:
        identity = "default" if name == default_ref.split("/", 1)[-1] else "feature"
    else:
        identity = "default" if name in ("main", "master", "trunk") else "feature"

    display = f"{indicator} {name}" if state == "diverged" else name
    return (display, state, indicator, identity)


def _project_root_at(cwd: Path) -> Path | None:
    """Mirror shell's `_beacon_project_root`: return the nearest ancestor (or
    cwd itself) holding a project marker, stopping at $HOME. Returns None
    when no marker is found within the search range — distinct from
    `find_project_root`, which falls back to cwd. Used by the anchor
    publisher to match the shell's "blank when not in a project" semantics."""
    home = Path.home().resolve()
    p = cwd.resolve()
    for d in (p, *p.parents):
        # Out of search scope when d reaches or steps outside $HOME's subtree.
        # Markers at or above $HOME (stray dotfiles `.git`, etc.) don't
        # represent the user's "current project".
        if d == home or home not in d.parents:
            return None
        for marker in PROJECT_MARKERS:
            if (d / marker).exists():
                return d
    return None


def _project_name_at(cwd: Path) -> str:
    """Owner/repo form when in a project (preferring git remote, falling
    back to root basename). Empty outside any recognized project."""
    root = _project_root_at(cwd)
    if not root:
        return ""
    name = p_git_remote(cwd)
    if name:
        return name
    return root.name or ""


def _discover_icon_at(cwd: Path) -> str | None:
    """PROV-08: the project's favicon/icon, as an absolute path. Probes the
    conventional locations (ICON_CANDIDATES) under the project root, returning
    the first that exists. None outside any recognized project, or when the
    project ships no icon at a known path."""
    root = _project_root_at(cwd)
    if not root:
        return None
    for rel in ICON_CANDIDATES:
        candidate = root / rel
        if candidate.is_file():
            return str(candidate)
    return None


_REMOTE_HOST_ABBREV = {
    "github.com": "gh",
    "gitlab.com": "gl",
    "bitbucket.org": "bb",
}


def _abbrev_remote_host(host_path: str) -> str:
    """`github.com/owner/repo` → `gh:owner/repo` for known forges; pass-through otherwise."""
    host, sep, rest = host_path.partition("/")
    if not sep:
        return host_path
    abbrev = _REMOTE_HOST_ABBREV.get(host)
    return f"{abbrev}:{rest}" if abbrev else host_path


# GitLab patterns appear first because their `/-/issues/` and `/-/merge_requests/`
# paths contain a literal `/issues/` substring that the GitHub patterns would
# also match — we want the GitLab sigil (`!` for MRs) to win on GitLab URLs.
_DELIVERABLE_PATTERNS = (
    (re.compile(r"/releases/tag/([^/?#]+)"), "", "release"),
    (re.compile(r"/-/tags/([^/?#]+)"),       "", "release"),
    (re.compile(r"/-/merge_requests/(\d+)"), "!", "cr"),
    # GitLab renamed `/-/issues/<n>` to `/-/work_items/<n>`; both are live and
    # the API hands back the new one. Sigils are GitLab's own reference syntax
    # (`#` issue, `!` MR, `&` epic, `%` milestone), so a ref reads the same on
    # the row as it does typed into a GitLab comment.
    (re.compile(r"/-/work_items/(\d+)"),     "#", "issue"),
    (re.compile(r"/-/issues/(\d+)"),         "#", "issue"),
    (re.compile(r"/-/epics/(\d+)"),          "&", "epic"),
    (re.compile(r"/-/milestones/(\d+)"),     "%", "milestone"),
    (re.compile(r"/pull/(\d+)"),             "#", "cr"),
    (re.compile(r"/issues/(\d+)"),           "#", "issue"),
)


def _project_id_from_url(url: str) -> str:
    """The forge identity (`gh:acme/widgets`) of the project a deliverable URL
    belongs to. Empty when the URL isn't forge-shaped.

    STATUSLINE-03 renders a ref bare or qualified by comparing this against the
    session's own identity, so an entry has to carry the project *its own URL*
    names. Taking the cwd's identity was safe only while every entry came from
    the branch resolver, where the URL belonged to the current project by
    construction; an entry learned from a tack route can point anywhere, and
    stamping it with the cwd's identity renders another project's `#9` as if it
    were local."""
    m = re.match(r"https?://([^/]+)/(.+)", url or "")
    if not m:
        return ""
    host, path = m.group(1), m.group(2)
    # GitLab puts everything after `/-/`, so the project path is what precedes
    # it and may be nested any depth; elsewhere it's `<owner>/<repo>`.
    path = path.split("/-/", 1)[0] if "/-/" in path else "/".join(path.split("/")[:2])
    # An epic or a group milestone is group-scoped (`/groups/<group>/-/epics/3`).
    path = path.removeprefix("groups/").strip("/")
    return _abbrev_remote_host(f"{host}/{path}") if path else ""


def _deliverable_suffix(url: str) -> str:
    """`#42` for issues/PRs, `!17` for GitLab MRs. Empty when the URL doesn't
    point at a forge issue/PR/MR. Used to contextualize the project_full chip
    when PROV-07 returns a deliverable URL (tack, user override) — bare repo
    or branch-tree URLs leave the chip showing only the project identity."""
    if not url:
        return ""
    for pat, sigil, _kind in _DELIVERABLE_PATTERNS:
        m = pat.search(url)
        if m:
            return f"{sigil}{m.group(1)}"
    return ""


def _deliverable_kind(url: str) -> str:
    """`cr` for a PR/MR, `release` for a tagged release, `issue` for an issue,
    empty otherwise. Derived from the URL rather than stored, so the distinction
    costs no state field and applies to entries recorded before it existed. On
    GitHub a CR and an issue both render `#<n>` (STATUSLINE-03 leans on grouping
    and weight to tell them apart); GitLab's `!` already differs by sigil."""
    for pat, _sigil, kind in _DELIVERABLE_PATTERNS:
        if url and pat.search(url):
            return kind
    return ""


DELIVERABLES_MAX = 8


def _record_deliverable(ref: str, url: str, project_id: str, title: str = "") -> None:
    """STATUSLINE-03: append a deliverable the session has touched. Deduped on
    URL, and a re-touch moves the entry to the end. Capped at DELIVERABLES_MAX,
    oldest dropped: the row shares a line with the pause reason, and a session
    that has crossed a dozen deliverables is better served by the older ones
    ageing out than by a row that wraps.

    `title` describes the deliverable being recorded now. It is the same string
    the badge is showing (the resolved `task`, when the task chain drew it from
    the PR title or a deliberate override), so the two surfaces name the work
    identically — sourcing them separately is what makes them disagree. Titles
    already captured for other entries are preserved: only the current
    deliverable has a live task to read.

    Every entry is re-stamped against tack on each call, so a CR that merged (or
    a release that shipped) mid-session moves to the delivered line without
    waiting for anything to touch it again."""
    # A dropped URL stays dropped for the session (CMD-24). The acquisition path
    # re-offers the whole route every publish, so removing an entry without
    # remembering the removal would put it back on the next turn.
    if url in read_state_json("deliverables.dropped", []):
        return
    landed = _tack_landed_urls()
    prior = {e.get("url"): e.get("title", "")
             for e in read_state_json("deliverables", []) if isinstance(e, dict)}
    entries = [e for e in read_state_json("deliverables", [])
               if isinstance(e, dict) and e.get("url") != url]
    entries.append({"ref": ref, "url": url, "project": project_id})
    for e in entries:
        e_url = e.get("url", "")
        # A release tag URL only exists once the release is published, so the
        # kind alone settles it — no tack route needed.
        e["delivered"] = e_url in landed or _deliverable_kind(e_url) == "release"
        e["title"] = (title or prior.get(e_url, "")) if e_url == url else prior.get(e_url, "")
    write_state("deliverables", json.dumps(entries[-DELIVERABLES_MAX:]))


def _qualify_deliverable(entry: dict, project_id: str) -> str:
    """`#42` for a deliverable in `project_id`, `otherproj:#42` for one
    elsewhere. The qualifier is the last segment of the forge identity
    (`gh:acme/widgets` → `widgets`), so both sides of the comparison are
    derived the same way and a rename can't make a local ref read as foreign.

    The forge prefix is stripped as well as the owner: a group-scoped identity
    (`gl:acme`, which a GitLab epic resolves to) has no `/` to split on, and
    would otherwise qualify as `gl:acme:&7`.

    An entry whose identity is a path-boundary prefix of the session's reads
    bare too. A GitLab epic or group milestone resolves to the *group*
    (`gl:acme`) where the session resolves to a repo inside it
    (`gl:acme/widgets`), so exact comparison alone would qualify your own
    group's epic as `acme:&7` — foreign-looking, for the tracker the work is
    filed under. The boundary is what keeps `gl:acme` off `gl:acmecorp/x`, and
    a repo-scoped entry is unaffected: both sides are then `owner/repo`, so
    neither can prefix the other."""
    ref = entry.get("ref", "")
    owner = entry.get("project", "")
    if not owner or owner == project_id or project_id.startswith(owner + "/"):
        return ref
    return f"{owner.split(':', 1)[-1].rsplit('/', 1)[-1]}:{ref}"


def cmd_drop(args):
    """CMD-24: take one deliverable off this session's status-line row.

    Acquisition can't tell a deliverable the session is working from one it only
    mentioned in passing, and the row is capped — so noise left in place evicts
    real work. The removal is remembered (`deliverables.dropped`) because the
    route is re-read every publish and would otherwise put the entry straight
    back. Session-scoped like the list itself: a fresh session starts clean."""
    target = (getattr(args, "ref", "") or "").strip()
    project_id = read_state("resolved.project") or ""
    entries = [e for e in read_state_json("deliverables", []) if isinstance(e, dict)]
    matched = [e for e in entries
               if target in (e.get("ref"), e.get("url"), _qualify_deliverable(e, project_id))]
    if not matched:
        print(f"no deliverable matching {target!r} on this session's row", file=sys.stderr)
        sys.exit(2)
    kept = [e for e in entries if e not in matched]
    write_state("deliverables", json.dumps(kept))
    dropped = read_state_json("deliverables.dropped", [])
    dropped += [e["url"] for e in matched if e.get("url") and e["url"] not in dropped]
    write_state("deliverables.dropped", json.dumps(dropped))
    print(f"dropped {target} ({len(kept)} deliverable(s) remaining)")


def _project_full_at(cwd: Path) -> str:
    """Abbreviated remote identity, e.g. `gh:owner/repo`. Empty when there's
    no project or no remote.

    Not a painted value — the project chip carries the project's *name*
    (STATUS-BAR-02). This is the qualifier that tells the status line whether a
    deliverable belongs to this project or another (STATUSLINE-03), which is why
    it survives the chip that used to render it."""
    root = _project_root_at(cwd)
    if not root:
        return ""
    url = _origin_url_at(root)
    if not url:
        return ""
    if "://" in url:
        path = url.split("://", 1)[1]
        if "@" in path:
            path = path.split("@", 1)[1]
    elif ":" in url:
        host_path = url.split("@", 1)[1] if "@" in url else url
        host, _, p = host_path.partition(":")
        path = f"{host}/{p}" if host and p else url
    else:
        path = url
    path = path.rstrip("/")
    if path.endswith(".git"):
        path = path[:-4]
    return _abbrev_remote_host(path)


def _local_path_at(cwd: Path) -> str:
    """`~`-substituted display path. Mirrors the `${PWD/#$HOME/~}` the shell's
    `_beacon_precmd` publishes."""
    home = str(Path.home())
    s = str(cwd)
    if s == home:
        return "~"
    if s.startswith(home + "/"):
        return "~" + s[len(home):]
    return s


_LAST_CHIP_SIGNATURE: tuple[str, ...] | None = None


def _project_chip_at(cwd: Path) -> str:
    """The project chip's value (STATUS-BAR-02): the project's name, and the
    directory's own name when that isn't a project.

    `_project_name_at` answers empty outside a recognized project because its
    other caller (tack route lookup) needs that distinction. The chip has no use
    for a blank slot — it reads the same in a plain shell as under Claude, in a
    git repo or not — so it floors here. Mirrors the shell's precmd."""
    return _project_name_at(cwd) or cwd.name or str(cwd)


def _publish_chips(cwd: Path) -> None:
    """Refresh status-bar chips (project_name, branch*) + the `↗ code` handoff
    file from `cwd`, and persist the resolved URL for the status line. Does NOT
    touch beacon_project / beacon_task — those are owned by the engagement
    renderer.

    Called whenever the shell's precmd can't (mid-session, between turns) so
    chips reflect branch creation / tack-context changes that happened while
    the shell was blocked on Claude."""
    global _LAST_CHIP_SIGNATURE
    display, state, indicator, identity = _detect_branch_info(cwd)
    # `display` leads with the ahead/behind indicator when diverged; route
    # lookup correlates on the branch name itself.
    branch = display[len(indicator):].lstrip() if indicator else display
    proj_name = _project_name_at(cwd)
    url, label = resolve_url(cwd)
    # STATUSLINE-02: `_tack_url_for` falls back to the newest completed
    # deliverable when the route has nothing open, so a fresh session on an idle
    # route would lead its row with a PR that shipped in an earlier session. The
    # `↖ web` button still wants that target and resolves at click time, so the
    # substitution is scoped to the persisted link: the location tiers answer
    # instead — an open PR for the branch, else the branch tree, else the project.
    if _url_delivered_before_session(cwd, branch, url, proj_name):
        url, label = _location_url_at(cwd)

    # The bare forge identity (`gh:acme/widgets`) is not a chip value — the chip
    # carries the project's name. It is still resolved here because it qualifies
    # a deliverable as this project's or another's in the status line
    # (STATUSLINE-03).
    project_id = _project_full_at(cwd)
    ref = _deliverable_suffix(url)
    route_urls = _tack_route_urls(cwd, branch, proj_name)

    # Hybrid branch slots (#20): the default branch fills its own de-emphasized
    # slot; a feature branch routes to its sync-state slot. Mirrors the shell's
    # precmd so Claude-session and interactive panes agree.
    is_default = identity == "default"
    pairs = (
        f"beacon_project_name={_project_chip_at(cwd)}",
        f"beacon_branch={display}",
        f"beacon_branch_state={state}",
        f"beacon_branch_default={display if is_default else ''}",
        f"beacon_branch_clean={display if (not is_default and state == 'clean') else ''}",
        f"beacon_branch_diverged={display if (not is_default and state == 'diverged') else ''}",
        f"beacon_branch_untracked={display if (not is_default and state == 'untracked') else ''}",
    )
    # Last-value gate (mirrors shell's precmd sentinels per AGENTS.md hot
    # path policy): Stop fires once per turn, but most turns don't change
    # branch/url. Skip the CLI spawn + file writes when nothing differs.
    # The URL rides the signature but not the uservar payload: two URLs can
    # differ while every chip stays identical (a branch-tree URL narrowing to
    # a sibling), and the status line reads the persisted value below.
    # The route's URL set rides the signature too: a link added to the route
    # changes nothing about the branch or the resolved URL, and gating on those
    # alone would leave the new deliverable unrecorded until the branch moved.
    signature = pairs + (f"url={url}", f"label={label}") + tuple(route_urls)
    if signature == _LAST_CHIP_SIGNATURE:
        return
    _LAST_CHIP_SIGNATURE = signature
    _cli("uservar-batch", *pairs)

    # STATUSLINE-02: the status line renders this per prompt, so it must never
    # re-run resolve_url (which shells to git and can shell to gh/glab). The
    # resolution is persisted here, on the hooks that already pay for it.
    # Distinct from the `resolved` badge snapshot (STATE-03), which is written
    # by the renderer and holds project/task/status.
    write_state("resolved.url", url)
    write_state("resolved.url_label", label)
    write_state("resolved.project", project_id)
    # The route first, the resolved URL last: only the latter has a live task to
    # title it, and recording it last keeps the work in hand furthest from the
    # DELIVERABLES_MAX eviction edge.
    for r_url in route_urls:
        r_ref = _deliverable_suffix(r_url)
        if r_ref and r_url != url:
            _record_deliverable(r_ref, r_url, _project_id_from_url(r_url) or project_id)
    # The substitution above takes a pre-session delivery off the link, which
    # leaves one case it can't reach: a tack marked done while its PR is still
    # open on this branch, which the forge probe hands straight back. Recording it
    # would credit this session with a delivery it had no part in.
    if ref and not _url_delivered_before_session(cwd, branch, url, proj_name):
        # The badge's own task, when the chain drew it from the PR title (or the
        # user said so outright). Any other tier — a branch name, an ai-title —
        # is spatial context rather than a name for the deliverable, and would
        # read as noise next to the ref it follows.
        snap = read_state_json("resolved", {})
        title = (snap.get("task") or "") if snap.get("task_provider") in ("pr", "override") else ""
        _record_deliverable(ref, url, _project_id_from_url(url) or project_id, title)

    key = _iterm_cache_key()
    if key:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        (CACHE_DIR / f"cwd-{key}.txt").write_text(f"{cwd}\n")


def _publish_anchor(cwd: Path) -> None:
    """HOOK-08: pin the navigational identity of this Claude session.

    SessionStart-only: publishes chips via `_publish_chips`, then anchors
    `beacon_project` (badge text fallback) and clears `beacon_task` so a
    fresh session starts from a known state. The cwd and resolved project
    are persisted as `anchor.cwd` / `anchor.project` so the Stop hook
    (HOOK-08b) re-resolves chips from this fixed anchor rather than trusting
    each turn's payload cwd — the anchor is beacon's own record of where the
    session began, not an implicit property of Claude's hook payloads."""
    _publish_chips(cwd)

    project = _project_name_at(cwd)
    local_path = _local_path_at(cwd)
    # BADGE-04 + PROV-06: when SessionStart's cwd is outside any recognized
    # project, fall back to the abbreviated cwd so the badge always carries
    # spatial context.
    project_display = project or local_path
    write_state("anchor.cwd", str(cwd))
    write_state("anchor.project", project_display)
    icon = _discover_icon_at(cwd)
    if icon:
        write_state("anchor.icon", icon)
    else:
        remove_state("anchor.icon")
    _cli("uservar-batch", f"beacon_project={project_display}", "beacon_task=")


# --- pane sizing for note overlay ---

def detect_pane_pixels(default=(1440, 1080)) -> tuple[int, int]:
    cols = lines = 0
    try:
        cols = int(os.environ.get("COLUMNS") or 0)
        lines = int(os.environ.get("LINES") or 0)
    except ValueError:
        pass
    if cols == 0 or lines == 0:
        try:
            with open("/dev/tty", "rb") as tty:
                r = subprocess.run(["stty", "size"], stdin=tty,
                                   capture_output=True, text=True, timeout=2)
            if r.returncode == 0:
                parts = r.stdout.split()
                if len(parts) == 2:
                    lines, cols = int(parts[0]), int(parts[1])
        except Exception:
            pass
    if cols <= 0 or lines <= 0:
        return default
    try:
        cell_w = float(os.environ.get("BEACON_CELL_WIDTH") or "7")
        cell_h = float(os.environ.get("BEACON_CELL_HEIGHT") or "16")
    except ValueError:
        cell_w, cell_h = 7.0, 16.0
    w = max(640, min(3200, int(cols * cell_w)))
    h = max(480, min(2000, int(lines * cell_h)))
    return (w // 8) * 8, (h // 8) * 8


# --- initialization ---

_initialized = False


def ensure_initialized():
    global _initialized
    if _initialized:
        return
    for d in (STATE_DIR, CACHE_DIR):
        d.mkdir(parents=True, exist_ok=True)
    _initialized = True


def _is_iterm_running() -> bool:
    # osascript is the reliable cross-macOS way to ask. pgrep can return
    # false negatives under sandboxing.
    try:
        r = subprocess.run(
            ["osascript", "-e", 'application "iTerm" is running'],
            capture_output=True, text=True, timeout=2,
        )
        return r.returncode == 0 and r.stdout.strip().lower() == "true"
    except Exception:
        return False


def _is_iterm_installed() -> bool:
    """Whether the iTerm2 render adapter can be configured on this machine —
    macOS with iTerm.app present. Gates the iTerm2-specific install steps; a
    box without it gets the dashboard-only install (CLI + fleet service). The
    adapter needs `defaults`/`osascript`/DynamicProfiles (all macOS) plus the
    app itself, so a macOS user on kitty/Terminal.app with no iTerm2 is
    correctly treated as adapter-less."""
    if sys.platform != "darwin":
        return False
    for p in (Path("/Applications/iTerm.app"),
              Path.home() / "Applications" / "iTerm.app"):
        if p.exists():
            return True
    # Launch Services lookup catches non-standard install locations.
    try:
        r = subprocess.run(
            ["osascript", "-e", 'POSIX path of (path to application "iTerm")'],
            capture_output=True, text=True, timeout=3,
        )
        return r.returncode == 0 and r.stdout.strip().endswith(".app/")
    except Exception:
        return False


def _hex_to_color_components(hex_str: str) -> dict:
    """Convert a 6-digit hex color (no leading #) to iTerm2's dynamic-profile
    color dict — sRGB float components, opaque. Mirrors the float form the
    base template uses for chip text (THEME-03), so a mode background stays
    single-sourced from its MODE_SPECS hex."""
    r = int(hex_str[0:2], 16) / 255.0
    g = int(hex_str[2:4], 16) / 255.0
    b = int(hex_str[4:6], 16) / 255.0
    return {
        "Red Component": r,
        "Green Component": g,
        "Blue Component": b,
        "Color Space": "sRGB",
        "Alpha Component": 1.0,
    }


# An action component draws its title inside the `maxwidth` knob, and the layout
# sets "remove empty components" — so a title wider than the cap leaves the
# button blank rather than truncated. The template's caps fit the default labels;
# a longer one from `statusbar.buttons.<name>.label` (STATUS-BAR-09) needs the cap
# grown with it. Sized from the layout font's advance width (Menlo-Regular 18pt),
# rounded up generously: maxwidth is a ceiling, not a fixed width, so an
# over-estimate costs nothing, where an under-estimate erases the button.
STATUSBAR_TITLE_ADVANCE = 12.0
STATUSBAR_TITLE_PADDING = 16


def _fit_action_button_widths(profile: dict) -> None:
    layout = profile.get("Status Bar Layout") or {}
    for component in layout.get("components") or []:
        knobs = (component.get("configuration") or {}).get("knobs") or {}
        title = (knobs.get("action") or {}).get("title")
        if not title:
            continue
        needed = int(len(title) * STATUSBAR_TITLE_ADVANCE) + STATUSBAR_TITLE_PADDING
        knobs["maxwidth"] = max(knobs.get("maxwidth") or 0, needed)


def install_dynamic_profile() -> tuple[bool, str]:
    """Write the base beacon-dev profile (status bar layout + badge sizing, §6.6)
    and one derived mode profile per MODE_SPECS entry (beacon-pause,
    beacon-release, beacon-retro, beacon-done; RENDER-05) into iTerm2's
    DynamicProfiles directory. iTerm2
    watches the directory and reloads on change without restart, so the write
    needs no quit.

    Substitutions in `iterm/profile.json.template`:
      __BEACON_SCRIPT__     — script path for the non-interactive coprocess
                              shells behind the status-bar action buttons.
      __BEACON_PYTHON__     — the running interpreter, absolute. A coprocess
                              action shell has no interactive `PATH` (§6.10
                              caveat 3), so a bare `python3` may not resolve.
      __BEACON_CACHE_DIR__  — so the `↗ code` action shell reads the
                              per-session handoff file without deriving it.
      __BEACON_*_LABEL__    — each action button's title, from
                              `statusbar.buttons.<name>.label` (STATUS-BAR-09).
                              Baked in rather than read from a user var: an
                              action component's title is a static knob
                              (§6.10), so a label change applies by
                              re-rendering here, not on the next click.

    Always rewrites — iTerm2 re-serializes dynamic profiles back to disk with
    its own formatting and any GUI-edited values, so a "content matches"
    short-circuit would silently let stale state win. Also sweeps the retired
    per-state profiles a pre-1.0 install left behind so iTerm2 stops loading
    them.
    """
    target_dir = Path.home() / "Library" / "Application Support" / "iTerm2" / "DynamicProfiles"
    beacon_script = str(PLUGIN_ROOT / "scripts" / "beacon")
    template = PLUGIN_ROOT / "iterm" / "profile.json.template"
    target = target_dir / "beacon-dev.json"

    try:
        target_dir.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        return False, f"failed to create {target_dir}: {e}"

    if not template.is_file():
        return False, f"profile template not found: {template}"
    # The placeholders sit inside JSON string literals, so a path with
    # backslashes (Windows) would otherwise emit invalid JSON escapes. Encode
    # each value for string-literal context — json.dumps quotes and escapes,
    # the slice drops the surrounding quotes the template already supplies.
    def _json_inner(value: str) -> str:
        return json.dumps(value)[1:-1]
    content = (template.read_text(encoding="utf-8")
               .replace("__BEACON_SCRIPT__", _json_inner(beacon_script))
               .replace("__BEACON_PYTHON__", _json_inner(sys.executable or "python3"))
               .replace("__BEACON_CACHE_DIR__", _json_inner(str(CACHE_DIR)))
               .replace("__BEACON_WEB_LABEL__", _json_inner(_statusbar_button("web")["label"]))
               .replace("__BEACON_CODE_LABEL__", _json_inner(_statusbar_button("code")["label"])))
    try:
        base_profile = json.loads(content)["Profiles"][0]
    except (ValueError, KeyError, IndexError) as e:
        return False, f"failed to parse base profile template: {e}"
    # Default the badge color to the dev-cycle gray (the `ready` state) so a
    # fresh pane reads gray before the first status render — and in a plain
    # shell, which emits no badge-color OSC. Without this the base inherits the
    # parent profile's badge color (e.g. Default's red). Single-sourced from
    # COLOR_PALETTE so the profile default and the rendered `ready` color
    # never drift. Written to all three keys for the same reason the mode
    # backgrounds are (below): which set iTerm2 reads depends on the parent
    # profile's light/dark switch.
    badge_color = _hex_to_color_components(COLOR_PALETTE["ready"])
    for key in ("Badge Color", "Badge Color (Light)", "Badge Color (Dark)"):
        base_profile[key] = badge_color
    _fit_action_button_widths(base_profile)
    try:
        target.write_text(json.dumps({"Profiles": [base_profile]}, indent=2))
    except OSError as e:
        return False, f"failed to write {target}: {e}"

    # Derive each mode profile from the just-rendered base (RENDER-05): same
    # status-bar layout / badge sizing (and gray badge-color default), differing
    # only in a de-emphasized background (and, for paused, a faint
    # background-image watermark). Deriving rather than hand-maintaining sibling
    # templates keeps the layout single-sourced so the profiles never drift.
    written = [str(target)]
    for mode, spec in MODE_SPECS.items():
        mode_target = target_dir / f"{spec['profile']}.json"
        try:
            mode_profile = copy.deepcopy(base_profile)
            mode_profile["Name"] = spec["profile"]
            mode_profile["Guid"] = spec["guid"]
            # All three keys: iTerm2 reads the plain key when the profile has
            # "Use Separate Colors for Light and Dark Mode" off and the (Light)
            # / (Dark) pair when it is on. That switch belongs to the parent
            # profile (RENDER-05 inherits it rather than forcing a value, so a
            # user's own light/dark colors survive), so the mode background has
            # to be written for whichever set the parent turns out to read.
            background = _hex_to_color_components(spec["background"])
            for key in ("Background Color", "Background Color (Light)",
                        "Background Color (Dark)"):
                mode_profile[key] = background
            if spec["image"]:
                # iTerm2 Background Image Mode 3 = Scale Aspect Fit: the square
                # asset stays centered and proportional on any pane size. Blend
                # dials the watermark down so the background color still reads.
                mode_profile["Background Image Location"] = str(PLUGIN_ROOT / "iterm" / "resources" / spec["image"])
                mode_profile["Background Image Mode"] = 3
                mode_profile["Blend"] = spec["blend"]
            mode_target.write_text(json.dumps({"Profiles": [mode_profile]}, indent=2))
            written.append(str(mode_target))
        except (OSError, ValueError, KeyError) as e:
            return False, f"failed to write {mode_target}: {e}"

    # Sweep beacon profiles this install didn't just write, so a profile whose
    # name retired stops showing up as an orphaned row in iTerm2's picker. Keyed
    # on what was written rather than on a list of past names, which is what kept
    # every rename since 0.x accumulating here. DynamicProfiles is a shared
    # directory, so a candidate has to *be* a beacon profile — one whose declared
    # `Name` sits in beacon's own namespace — not merely be named like one; a
    # stray file, or JSON that isn't a dynamic profile at all, is left alone.
    keep = {Path(p).name for p in written}
    try:
        # Only beacon's own namespace: the DynamicProfiles dir is shared, and
        # parsing every other tool's profile to decide it isn't ours is work
        # the filename already answers. The Name check below still gates the
        # unlink, so a same-prefix file from elsewhere survives.
        stale_files = [p for p in target_dir.glob(f"{PROFILE_NAMESPACE}*.json")
                       if p.name not in keep]
    except OSError:
        stale_files = []
    for stale in stale_files:
        try:
            profiles = json.loads(stale.read_text()).get("Profiles") or []
            names = [str(p.get("Name") or "") for p in profiles if isinstance(p, dict)]
        except (OSError, ValueError, AttributeError, TypeError):
            continue
        if names and all(n == PROFILE_NAMESPACE or n.startswith(f"{PROFILE_NAMESPACE}-")
                         for n in names):
            try:
                stale.unlink(missing_ok=True)
            except OSError:
                pass

    return True, "wrote " + " + ".join(written)


# --- apply ---

def _engagement_marker_path() -> Path | None:
    """BADGE-14: per-pane marker. Keyed by the pane GUID (_iterm_cache_key) —
    not the session hash — so the shell snippet can probe existence with a
    plain `[[ -e ... ]]` test, no SHA-1 in the prompt hot path. The GUID (not
    the full ITERM_SESSION_ID) so the marker survives a pane move, like the
    cwd / url handoff files it sits beside."""
    key = _iterm_cache_key()
    if not key:
        return None
    return CACHE_DIR / f"engaged-{key}"


def place_engagement_marker() -> None:
    p = _engagement_marker_path()
    if not p:
        return
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.touch(exist_ok=True)
    except OSError:
        pass


def remove_engagement_marker() -> None:
    p = _engagement_marker_path()
    if not p:
        return
    try:
        p.unlink()
    except (FileNotFoundError, OSError):
        pass


def _color_state_for(state: dict) -> str:
    """The logical color state the tab is painted (BADGE-09): `ready` / `busy` /
    `blocked`, from `activity` alone. No mode reaches this — a mode is legible
    from another tab as its glyph and, once focused, as its pane background, so
    the one always-painted channel is spent on the axis that actually varies.

    `pending_attention` (HOOK-03b) forces `blocked` over the activity mapping,
    because hook delivery isn't ordered: a late PostToolUse for an earlier tool
    can arrive after a fresh permission prompt, and without the sticky marker
    the tab would flip back to `busy` while the user is still being asked."""
    if state.get("pending_attention"):
        return "blocked"
    return ACTIVITY_TO_COLOR_STATE.get(state.get("activity"),
                                      ACTIVITY_TO_COLOR_STATE[DEFAULT_ACTIVITY])


def _mode_glyph_for(state: dict) -> str:
    """The glyph leading line 1 of the session name (TITLE-06) — the mode's only
    cross-tab surface. Trailing space so it separates from the project without
    the template having to carry one; empty in the dev cycle."""
    glyph = _mode_glyph(state.get("mode"))
    return f"{glyph} " if glyph else ""


def _profile_for(state: dict) -> str:
    """The dynamic profile the pane sits in (RENDER-05): the mode's, or the base
    profile in the dev cycle. Call sites never name an iTerm profile."""
    spec = MODE_SPECS.get(state.get("mode"))
    return spec["profile"] if spec else BASE_PROFILE_NAME


def _set_session_title(fmt: str = TITLE_FORMAT) -> None:
    """WINDOW-TITLE / TITLE-05: set this session's iTerm2 *session name* to the
    two-line title template so `project` over `task` surfaces as the tab label
    and line 1 (`project`) as the single-line OS window title, surviving Claude
    Code's `/rename` — the beacon profile disables OSC title-setting (`Allow
    Title Setting: false`), so Claude's title OSC can't overwrite it, and beacon
    owns the name out-of-band via Apple Events (set-name). The name is the
    interpolated template, so iTerm2 re-evaluates it live as SetUserVar updates
    flow in — it need only be re-set when a profile swap resets it, not every
    hook. Real iTerm sessions only; the synthesized `claude-session:` id has no
    addressable surface. `fmt` is the managed template by default and
    INTERACTIVE_TITLE_FORMAT when disengaging, so the sid guard has one home."""
    sid = os.environ.get("ITERM_SESSION_ID") or ""
    if ":" in sid and not sid.startswith("claude-session:"):
        _cli("set-name", sid, fmt)


def apply(state: dict):
    prev = read_state_json("resolved", {})

    # BADGE-14: marker presence is the shell snippet's engagement gate.
    place_engagement_marker()

    # The two axes paint two disjoint surfaces, so nothing here arbitrates
    # between them: activity picks the tab color (BADGE-09), the mode picks the
    # glyph (TITLE-06) and the profile whose background it owns (RENDER-05).
    # `release` + `waiting` therefore paints a red tab over the release pane —
    # a state the merged field could not represent at all.
    color_state = _color_state_for(state)
    glyph = _mode_glyph_for(state)
    target_profile = _profile_for(state)

    # RENDER-05: switch profiles when the target changes — which also covers
    # the first render (prev carries no profile). set-profile must precede the
    # OSC below: SetProfile wipes the session's OSC overrides including
    # SetBadgeFormat (§6.10), so a switch re-emits the badge format here and
    # forces the user vars + badge/tab color further down.
    switched = target_profile != prev.get("profile")
    badge_on = _badge_enabled()
    if switched:
        _cli("set-profile", target_profile)
        # BADGE-15: the badge is opt-in (off by default). Its format is only
        # re-emitted after a profile swap wipes the OSC when the badge is on.
        if badge_on:
            _cli("badge-format", BADGE_FORMAT)
        # SetProfile resets the session name to the profile's literal Name, so
        # restore the interpolated window title (WINDOW-TITLE) after every swap
        # — and on the first render, which is also a swap (prev has no profile).
        _set_session_title()

    # RENDER-04: tab color for the logical color state (and the badge color too
    # when the badge is enabled). Repaint when the state changed, or
    # unconditionally after a profile switch wiped the OSC.
    if switched or color_state != prev.get("color_state"):
        hex_color = COLOR_PALETTE.get(color_state, COLOR_PALETTE["ready"])
        if badge_on:
            _cli("badge-color", hex_color)
        _cli("tab-color", hex_color)

    # BADGE-02 / -11 / -12: plugin is sole writer of beacon_project. The badge
    # text is always the raw project — no mode decorates it (BADGE-11). Republish
    # when the value changed; a profile swap wiped the var, so restore a non-empty
    # value — an empty one already matches the wiped slot.
    project_text = state["project"]
    if project_text != prev.get("project", "") or (switched and project_text):
        _cli("uservar", "beacon_project", project_text)

    # BADGE-03: the user-var value carries its own separator so an empty task
    # collapses the slot without leaving a trailing separator on the badge. The
    # middle dot mirrors the fleet dashboard's project · task separator. A wander
    # (PROV-02a) swaps in " @ " — symmetric with " · " — so it reads
    # "<home> @ <where> · <what>" rather than colliding a "· @" against a glued
    # marker. Same swap-restore rule as the project above.
    task_text = state["task"]
    if task_text != prev.get("task") or (switched and task_text):
        sep = " @ " if state.get("task_provider") == "wander" else " · "
        _cli("uservar", "beacon_task", f"{sep}{task_text}" if task_text else "")
        # TITLE-05: the tab/window-title Name puts the task on a second line,
        # indented two spaces under the project. Same collapse-when-empty
        # contract as beacon_task; the wander " @ " marker is a badge-only
        # nicety, so the two-line title just carries the bare task.
        _cli("uservar", "beacon_task_nl", f"\n  {task_text}" if task_text else "")

    # TITLE-06: line 1 (tab label + single-line OS window title) leads with the
    # mode's glyph. This is what makes a mode readable from a tab the user isn't
    # looking at — the pane background it also owns is only visible in the focused
    # pane, and the tab color now answers a different question. A glyph, not the
    # word, because line 1 is shared by the tab and the window title and cannot
    # differ between them. The mode's *note* is not here: it goes to the Claude
    # Code status line (STATUSLINE-01), a footer row with room for prose.
    if glyph != prev.get("mode_glyph", "") or (switched and glyph):
        _cli("uservar", "beacon_title_prefix", glyph)

    snapshot = {
        "project": state["project"], "project_provider": state["project_provider"],
        "task": state["task"], "task_provider": state["task_provider"],
        "mode": state["mode"], "note": state.get("note", ""),
        "activity": state["activity"],
        "pending_attention": state.get("pending_attention", False),
        "color_state": color_state,
        "mode_glyph": glyph,
        "profile": target_profile,
    }
    write_state("resolved", json.dumps(snapshot, indent=2))


def _resolve_for_display() -> dict:
    """Resolve the badge state the way the renderer paints it: against the
    SessionStart anchor (BADGE-02), with the PROV-02a wander overlay. Shared by
    render() (paints the badge) and cmd_show() (reports what the badge shows) so
    `show` (CMD-01) can never diverge from the painted value (BADGE-12).

    BADGE-02: beacon_project follows the anchor (HOOK-08), not Claude's live
    subprocess cwd, so a mid-turn `cd` doesn't repaint the badge. No anchor (a
    session that never reached SessionStart, or an interactive CLI invocation)
    falls back to live cwd."""
    anchor = read_state("anchor.cwd")
    anchor_cwd = Path(anchor).expanduser() if anchor else None
    state = resolve(anchor_cwd)

    # PROV-02a: when the session has wandered into a different project root than
    # its anchor, surface the wandered project root in the task slot as a
    # location, joined to the pinned home project by a " @ " separator at render
    # (apply()) — "<home> @ <where> · <what>" — secondary spatial context. The
    # project slot stays pinned to the anchor (BADGE-02). The task text after the
    # location is the pinned label
    # (an explicit override, which now includes a /rename) when one is set;
    # without one, the task
    # chain (PR title → branch) is re-resolved at the wandered cwd so the marker
    # carries what's happening there. With neither, the marker stands alone —
    # ai-title is skipped here as too weak to caption a wander. Gating on project root (not
    # raw cwd) keeps subdirectory navigation within the anchored project from
    # displacing the badge. The live cwd must resolve to a recognized project
    # (a marker-bearing root, not find_project_root's bare-cwd fallback): a
    # mktemp /tmp scratch dir the agent cd's into for ad-hoc work is not a
    # project it has wandered into, so it carries no @marker.
    #
    # The marker is live "where the subprocess is right now" context, so it
    # applies only while the session is actively working in the dev cycle. At
    # rest — idle, blocked on a prompt — or in any declared mode, the tab shows
    # the session's resting identity and the task re-resolves from the anchor.
    # This is what removes a wander once the session comes home: the returning
    # turn's Stop renders at rest (activity → idle) and drops the marker even if
    # the last working render fired while the cwd was still away, and a session
    # that blocks or ends mid-wander never freezes a stale @marker into its
    # snapshot. The dev-cycle half of that used to come free: a mode won the
    # merged field outright, so a moded session could never read `busy`. Now that
    # a mode and `working` coexist, the gate has to say so.
    if (anchor_cwd is not None
            and state["mode"] == DEV_MODE
            and _color_state_for(state) == "busy"):
        live_cwd = Path.cwd()
        live_root = _project_root(live_cwd)
        if live_root is not None and live_root != find_project_root(anchor_cwd):
            if state["task_provider"] == "override":
                wandered_task = state["task"]
            else:
                wandered_task, _ = chain([
                    ("pr",     lambda: p_pr_title(live_cwd)),
                    ("branch", lambda: p_branch(live_cwd)),
                ])
            # Bare location: the " @ " separator (applied at render, apply())
            # marks it as "at <where>", and an inner task hangs off the normal
            # " · " so the badge reads "<home> @ <where> · <what>".
            state["task"] = (f"{live_root.name} · {wandered_task}"
                             if wandered_task else live_root.name)
            state["task_provider"] = "wander"

    return state


def render():
    ensure_initialized()
    apply(_resolve_for_display())


# --- subcommands ---

def cmd_show(_args):
    state = _resolve_for_display()
    rows = []
    for field in ("project", "task"):
        value = state[field]
        provider = state[f"{field}_provider"]
        if value and provider:
            rows.append((field, value, provider))
    # Only the chained signals carry a provider. The two state axes have one
    # writer each, so naming a tier for them would invent a distinction that
    # doesn't exist; `activity` shows unconditionally because it always has a
    # value, `mode` only when one is declared.
    if state["mode"] != DEV_MODE:
        rows.append(("mode", state["mode"], None))
        if state.get("note"):
            rows.append(("note", state["note"], None))
    rows.append(("activity", state["activity"], None))
    if state.get("pending_attention"):
        rows.append(("attention", "pending", None))
    width = max(len(v) for _, v, _ in rows)
    for field, value, provider in rows:
        suffix = f"  ({provider})" if provider else ""
        print(f"{field+':':<12} {value:<{width}}{suffix}")


def _set_field(field: str, value: str):
    if field not in VALID_FIELDS:
        sys.exit(f"unknown field: {field} (allowed: {', '.join(VALID_FIELDS)})")
    write_state(f"override.{field}", value)


def cmd_set(args):
    _set_field(args.field, " ".join(args.value))
    render()


def cmd_task(args):
    _set_field("task", " ".join(args.value))
    render()


def cmd_project(args):
    _set_field("project", " ".join(args.value))
    render()


def _disengage() -> None:
    """BADGE-14 disengagement: return the pane to its unpainted, unmanaged
    look. Clears overrides, the mode, and sticky red markers, drops the
    engagement marker and the resolved snapshot, blanks the badge user vars,
    and reverts badge / tab color to default. Callers must NOT render()
    afterward — render() would re-place the engagement marker and re-engage.
    Shared by `clear` (OVR-04) and the SessionEnd hook (HOOK-09)."""
    for f in VALID_FIELDS:
        remove_state(f"override.{f}")
    write_mode(DEV_MODE)
    # Drop any sticky red markers — if the session is genuinely blocked,
    # the next Notification re-asserts both.
    remove_state("pending-attention")
    if read_activity() == "waiting":
        remove_state("activity")
    _clear_cc_signals()
    remove_state("title_reasserted")
    remove_engagement_marker()
    remove_state("resolved")
    # A mode swapped the pane into a mode profile whose background the color-only
    # `clear` below cannot undo (RENDER-05). apply() swaps back to the base
    # profile when *leaving* a mode, but disengagement bypasses apply(), so a
    # session that ends (or is cleared) mid-mode would keep its "powered off" /
    # paused background. Swap back to base here so the pane reads as unmanaged.
    # Harmless no-op when already on the base profile.
    _cli("set-profile", BASE_PROFILE_NAME)
    _cli("clear")
    # Hand the name back to the interactive template (TITLE-04) *before* blanking
    # the badge user vars, and after the profile swap that resets the name to the
    # target profile's own (RENDER-05). Order is load-bearing: the vars are
    # everything TITLE_FORMAT interpolates, so a pane left on the managed template
    # with them blanked renders a blank tab label and blank OS window title. The
    # shell's own set-name is a one-shot at source time that skipped this pane (it
    # was engaged) and never re-runs, so nothing else reclaims the name — and
    # `_cli` swallows failures, so a handback that ran last and failed would strand
    # the pane blank for the rest of its life. Blanking last means an interrupted
    # disengage leaves a stale label rather than an empty one.
    _set_session_title(INTERACTIVE_TITLE_FORMAT)
    _cli("uservar", "beacon_project", "")
    _cli("uservar", "beacon_task", "")
    _cli("uservar", "beacon_task_nl", "")
    _cli("uservar", "beacon_title_prefix", "")


def cmd_clear(args):
    if args.field:
        remove_state(f"override.{args.field}")
        render()
        return

    _disengage()


def _note_from(words) -> str:
    """Join an argparse nargs list into a single trimmed note string."""
    return " ".join(words).strip() if words else ""


def cmd_status(args):
    """`status <mode>` — enter a mode, or `dev` to leave one.

    Activity is deliberately not settable. It named the same field until 2.5.0,
    and every pinned activity found in live state was contradicting the hooks it
    outranked — tabs painted `working` for months while the session underneath
    was blocked on the user, which is the failure this split exists to remove."""
    write_mode(args.mode, _note_from(args.note))
    render()


def cmd_pause(args):
    write_mode("pause", _note_from(args.note))
    render()
    # --clear-screen (#8): a clean stand-down wipes the terminal too. The agent
    # can't clear its own buffer (captured stdout), but the CLI writes straight
    # to /dev/tty; outside iTerm2 or with no tty it's a harmless no-op, so the
    # pause always applies regardless.
    if getattr(args, "clear_screen", False):
        _cli("clear-screen")


def cmd_release(args):
    """Enter release mode: a ship-it / release flow is in progress — the one
    active mode a session or skill declares while cutting or deploying a release.
    Unlike pause it does not auto-resume on the next prompt (AUTO_RESUME_MODES) —
    it persists until `status dev` / `resume` / `clear` or the session ends. The
    tab takes a 🚀; the pane takes the deep launch-sky navy with its rocket
    watermark."""
    write_mode("release", _note_from(args.note))
    render()


def cmd_retro(args):
    """Enter retro mode: a post-work follow-up / retro phase a session or skill
    declares. Like release it does not auto-resume on the next prompt — it
    persists until `status dev` / `resume` / `clear` or the session ends. The tab
    takes a 📋; the pane takes the muted green with its ticked-clipboard
    watermark."""
    write_mode("retro", _note_from(args.note))
    render()


def cmd_done(args):
    """Enter done mode: the session is complete and ready to hand off to another
    — the terminal mode a closing-out skill reaches for instead of `pause`. Like
    retro it does not auto-resume on the next prompt. The tab takes a 🏁; the pane
    takes the dimmest 'powered off' near-black with its checkered-flag watermark,
    and the task slot is suppressed so the tab shows the project alone
    (STATE-12)."""
    write_mode("done", _note_from(args.note))
    render()


def cmd_resume(_args):
    """Return the session to auto-detected defaults: drop the overrides and leave
    whatever mode is set. Activity is untouched — it is the hooks' to report, and
    the next hook restates it anyway."""
    for f in VALID_FIELDS:
        remove_state(f"override.{f}")
    write_mode(DEV_MODE)
    render()


# Trailing bytes of the transcript to scan for the last assistant turn. The
# newest message sits at EOF, so a bounded tail finds it without reading a
# multi-MB session front-to-back on every Stop hook.
_TRANSCRIPT_TAIL_BYTES = 65536

# Upper bound on a stored turn excerpt — purely to keep the wip.json payload
# small. Visual truncation (the trailing ellipsis) is the dashboard's job
# (WIP-11); this never decides where the "…" lands.
TURN_EXCERPT_MAX = 240

# Upper bound on the stored *full* turn (WIP-14) — the on-demand enrichment the
# dashboard fetches when a card is expanded. Larger than the excerpt (it's a
# read-a-paragraph view, not a scan line) but still bounded: past this, the "…"
# says "open the session for the rest". Kept out of the bulk wip.json payload.
FULL_TURN_MAX = 2000

# Leading block-level markdown markers (heading, blockquote, list bullet,
# ordered-list number) stripped from a turn's first line so the excerpt reads
# as prose. Inline emphasis is left alone — stripping it mangles code snippets.
_MD_PREFIX_RE = re.compile(r"^(?:[#>]+\s+|[-*+]\s+|\d+[.)]\s+)+")


def _tail_text(p: Path, max_bytes: int = _TRANSCRIPT_TAIL_BYTES) -> str:
    """Trailing `max_bytes` of a file as text, with a leading partial line
    dropped so JSONL parsing starts on a clean record boundary."""
    try:
        size = p.stat().st_size
        with p.open("rb") as f:
            if size > max_bytes:
                f.seek(size - max_bytes)
            data = f.read()
    except OSError:
        return ""
    chunk = data.decode("utf-8", errors="replace")
    if size > max_bytes:
        nl = chunk.find("\n")
        chunk = chunk[nl + 1:] if nl != -1 else chunk
    return chunk


def _excerpt(text: str | None) -> str:
    """Collapse a turn's text to one scannable line for the fleet view: first
    non-empty line, leading markdown markers stripped, whitespace collapsed,
    capped at TURN_EXCERPT_MAX. The cap bounds the payload, not the display —
    the dashboard ellipsizes to the card width (WIP-11)."""
    if not text:
        return ""
    for raw in text.splitlines():
        s = raw.strip()
        if s:
            line = _MD_PREFIX_RE.sub("", s)
            return re.sub(r"\s+", " ", line).strip()[:TURN_EXCERPT_MAX]
    return ""


def _full_turn(text: str | None) -> str:
    """The turn's full text for on-demand fleet-view enrichment (WIP-14): the
    dashboard fetches this when a card is expanded, since the bulk payload
    carries only the single-line _excerpt (WIP-11). Trailing whitespace is
    trimmed per line and blank runs collapsed, but line breaks are kept (the
    dashboard renders it pre-wrap) — unlike the excerpt, which flattens to one
    line. Capped at FULL_TURN_MAX with a trailing ellipsis when clipped."""
    if not text:
        return ""
    lines: list[str] = []
    for raw in text.splitlines():
        line = raw.rstrip()
        if not line and lines and not lines[-1]:
            continue  # collapse a run of blank lines to a single separator
        lines.append(line)
    s = "\n".join(lines).strip()
    return (s[: FULL_TURN_MAX - 1] + "…") if len(s) > FULL_TURN_MAX else s


def _write_latest_turn(role: str, text: str | None) -> None:
    """Persist the session's most recent turn (WIP-11) as JSON for the fleet
    view, plus the full turn text (WIP-14) in a companion field the on-demand
    /turn route serves on expand. Written at hook time so the cross-session
    scan never touches a transcript. A turn with no usable text (e.g. a pure
    tool_use turn) leaves the prior values in place rather than blanking."""
    excerpt = _excerpt(text)
    if not excerpt:
        return
    write_state("latest_turn", json.dumps(
        {"role": role, "text": excerpt, "at": _iso(time.time())}
    ))
    write_state("latest_turn_full", _full_turn(text))


def _last_assistant_text() -> str | None:
    """Tail of the most recent assistant message text in this session's
    transcript. Returns None when no transcript is known or no assistant
    text exists yet. The transcript is JSONL — one entry per line, each a
    Claude Code conversation event. Assistant entries carry message.content
    as either a string or a list of content blocks; we want the trailing
    text block of the last assistant entry that has any text (skipping
    pure tool_use turns). Only the trailing tail is scanned — the newest
    message is at EOF."""
    path = read_state("transcript_path")
    if not path:
        return None
    p = Path(path)
    if not p.is_file():
        return None
    try:
        last_text = None
        for line in _tail_text(p).splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except Exception:
                continue
            if obj.get("type") != "assistant":
                continue
            content = (obj.get("message") or {}).get("content")
            if isinstance(content, str):
                if content.strip():
                    last_text = content
            elif isinstance(content, list):
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "text":
                        t = (block.get("text") or "").strip()
                        if t:
                            last_text = t
        return last_text
    except Exception:
        return None


# The Claude Code transcript records the user's own /color and /rename edits
# (and Claude's auto-generated title) as dedicated single-line JSONL records.
# beacon has no hook for those slash commands, so it harvests them from the
# transcript tail at hook time — the same transport that feeds latest_turn.
# This is a soft dependency on a Claude-Code-internal format: if a record type
# disappears the signal simply goes quiet, never crashing a hook.
_CC_SIGNAL_FIELDS = {
    "custom-title": ("customTitle", "cc.custom_title"),  # /rename
    "agent-color":  ("agentColor",  "cc.agent_color"),   # /color
    "ai-title":     ("aiTitle",     "cc.ai_title"),       # auto-generated
}


def _read_cc_signals() -> None:
    """Harvest the latest /rename (custom-title), /color (agent-color), and
    auto ai-title from this session's transcript tail and persist each. A
    value set once early in a long session eventually scrolls out of the tail
    window, so a field absent from the tail leaves its prior persisted value in
    place (mirrors _write_latest_turn) rather than blanking a still-current
    signal."""
    path = read_state("transcript_path")
    if not path:
        return
    p = Path(path)
    if not p.is_file():
        return
    latest: dict[str, str] = {}
    try:
        for line in _tail_text(p).splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except Exception:
                continue
            spec = _CC_SIGNAL_FIELDS.get(obj.get("type"))
            if not spec:
                continue
            key, _field = spec
            val = obj.get(key)
            if isinstance(val, str) and val.strip():
                latest[obj["type"]] = val.strip()
    except Exception:
        return
    prev_custom = read_state("cc.custom_title")
    for rtype, val in latest.items():
        write_state(_CC_SIGNAL_FIELDS[rtype][1], val)
    # PROV-02: a /rename is shorthand for setting the task, so fold a *changed*
    # custom-title into `override.task` — exactly as `beacon set task` would.
    # Sharing the one override slot makes /rename and `set task` recency-wins:
    # a later `beacon set task` isn't clobbered back on the next harvest,
    # because the custom-title is then unchanged and this no-ops. A custom-title
    # absent from the tail (scrolled out) is not in `latest`, so it never blanks
    # or re-applies a still-current label.
    new_custom = latest.get("custom-title")
    if new_custom and new_custom != prev_custom:
        write_state("override.task", new_custom)


def _looks_idle(text: str | None) -> bool:
    if not text:
        return False
    head = text.lstrip().splitlines()[0] if text.strip() else ""
    return bool(IDLE_LOOK_RE.match(head))


def _recover_stale_red() -> None:
    """Stop / PreToolUse / UserPromptSubmit are responsible for clearing
    pending-attention and `activity = waiting` (HOOK-03b). When one of
    those hooks didn't fire — typically because the prior Claude session
    was killed mid-permission-prompt — the markers outlive the actual
    blocked state. Peek at the transcript: if the last assistant message
    reads as idle ("Ready..."), drop the stale markers so resolve() and
    apply() don't render red against a session that's actually idle."""
    if not (_state_path("pending-attention").exists()
            or read_activity() == "waiting"):
        return
    if not _looks_idle(_last_assistant_text()):
        return
    remove_state("pending-attention")
    if read_activity() == "waiting":
        remove_state("activity")


def _wipe_session_for_fresh_start() -> None:
    """Targeted state wipe so a freshly-started Claude (or `/recipe`,
    `/clear`) in a reused iTerm pane doesn't inherit signals from a prior
    tenant. Keeps `claude_session_id` (just written by the caller)."""
    for f in VALID_FIELDS:
        remove_state(f"override.{f}")
    write_mode(DEV_MODE)
    remove_state("activity")
    remove_state("pending-attention")
    remove_state("latest_turn")
    remove_state("latest_turn_full")
    remove_state("title_reasserted")
    # STATUSLINE-03: the accumulated list is scoped to one Claude session, but
    # the state keys on the pane — without this, a fresh session inherits the
    # previous tenant's deliverables and the footer credits it with work it
    # never touched.
    remove_state("deliverables")
    remove_state("deliverables.dropped")
    # The window the row is scoped to (_session_started_at). Stamped at the same
    # boundary as the wipe so the two agree: the wipe empties the row, and this
    # keeps acquisition from refilling it with the route's earlier work.
    write_state("session_started_at",
                datetime.now(timezone.utc).isoformat(timespec="milliseconds"))
    _clear_cc_signals()


def _clear_cc_signals() -> None:
    """Drop the harvested /color, /rename, and ai-title so a reused pane or a
    fresh session in the same bucket doesn't inherit a prior tenant's title or
    color."""
    for _key, field in _CC_SIGNAL_FIELDS.values():
        remove_state(field)


def cmd_reset(_args):
    sh = session_hash()
    for p in STATE_DIR.glob(f"{sh}.*"):
        try:
            p.unlink()
        except OSError:
            pass
    _cli("clear")


def cmd_render(_args):
    render()


STATUSLINE_SEPARATOR = " · "
STATUSLINE_LINK_COLOR = "36"
# A mode's note reads as de-emphasized context, not as an alert: the tab already
# says which mode, so the note is the detail you look down for. Dracula `comment`
# in the 256-color space, matching the identity role it plays elsewhere.
_MODE_NOTE_COLOR = "38;5;61"
# STATUSLINE-03: change requests lead the row and carry full weight; issues
# trail, dimmed. Same hue for both — the palette's "one hue, two weights" split
# between an actionable thing and its context (THEME-03) — so the row reads as
# one group, and no state carries a text glyph (BADGE-11 / WIP-12).
STATUSLINE_CR_SGR = "1;36"
STATUSLINE_ISSUE_SGR = "2;36"
# Delivered work gets its own line and its own vocabulary. The strike is
# decoration; the word and the glyph are what carry it — a bare struck `#27` is
# four characters of subtlety, and strikethrough is among the first attributes a
# terminal drops. Green is beacon's release colour throughout (THEME-02). The
# verb is muted against its ref: the ref is the content, the verb is the label.
STATUSLINE_DELIVERED_SGR = "32"
STATUSLINE_VERB_SGR = "2;32"
# A CR line usually holds one ref and a lot of empty terminal, so the title
# earns its place there. Issues stay bare — several share a line, and titling
# each would wrap the row the cap exists to prevent.
STATUSLINE_TITLE_SGR = "2;37"
STATUSLINE_TITLE_MAX = 72
STATUSLINE_DELIVERED = {
    "cr": ("merged", "🏁"),
    "release": ("released", "🚀"),
    "issue": ("closed", "✓"),
}


def _osc8(url: str, text: str) -> str:
    """Wrap `text` as an OSC-8 hyperlink to `url`. BEL (`\\a`) terminates each
    sequence rather than ST (`ESC \\`) — both are legal and BEL is the more
    widely accepted across emulators. Claude Code passes the sequence through
    its status-line renderer untouched (verified in iTerm2), so the terminal is
    what decides whether it becomes clickable."""
    return f"\033]8;;{url}\a{text}\033]8;;\a"


def _statusline_mode_segment() -> str:
    """`<glyph> <note>` for the declared mode, colored; empty in the dev cycle or
    with no note. This is where a mode's prose goes: the tab carries the glyph
    alone (line 1 is shared with the OS window title, so it has no room), and the
    status line is a footer Claude owns that never overlaps terminal output."""
    mode, note = read_mode()
    note = " ".join(note.split())
    if mode == DEV_MODE or not note:
        return ""
    glyph = _mode_glyph(mode)
    return f"\033[{_MODE_NOTE_COLOR}m{glyph} {note}\033[0m"


def _statusline_link_segment() -> str:
    """STATUSLINE-02/03: the deliverables this session has touched, each a
    clickable OSC-8 link — bare (`#4`) for this project, qualified
    (`otherproj:#75`) for another. Change requests lead the row at full weight
    and issues trail dimmed, newest first within each group, so the row answers
    "what am I shipping" before "what does it answer".

    A session that has touched no deliverable falls back to the single resolved
    URL (an open PR for the branch, else a branch or repo page), which is the same
    rendering with one element. `_publish_chips` keeps a delivery from an earlier
    session out of that slot, so the fallback names a location and never a ref the
    session had no part in.

    Reads only what `_publish_chips` persisted; never re-resolves — the row
    renders per prompt, and `resolve_url` shells to git and can shell to
    `gh`/`glab`."""
    entries = [e for e in read_state_json("deliverables", []) if isinstance(e, dict)]
    if entries:
        return ""
    url = read_state("resolved.url")
    if not url:
        return ""
    body = _osc8(url, read_state("resolved.url_label") or url)
    return f"\033[{STATUSLINE_LINK_COLOR}m{body}\033[0m"


def _statusline_open_lines() -> list[str]:
    """STATUSLINE-03: open work, one line per kind — change requests above the
    issues they answer. Newest first within each line. Splitting by kind rather
    than packing one row is what lets a glance separate "what I'm shipping" from
    "what I'm shipping it for"; on GitHub the two are both `#<n>` and share a
    line only by accident of numbering."""
    project_id = read_state("resolved.project") or ""
    live = [e for e in read_state_json("deliverables", [])
            if isinstance(e, dict) and not e.get("delivered")]
    lines = []
    # An epic and a milestone are the same class of thing as an issue — what the
    # work is for, not what ships it — so they share the trailing line rather
    # than earning one each and pushing the row toward wrapping.
    for kinds, sgr in ((("cr",), STATUSLINE_CR_SGR),
                       (("issue", "epic", "milestone"), STATUSLINE_ISSUE_SGR)):
        refs = []
        for e in reversed(live):
            if _deliverable_kind(e.get("url", "")) not in kinds:
                continue
            ref = f"\033[{sgr}m{_osc8(e.get('url', ''), _qualify_deliverable(e, project_id))}\033[0m"
            title = " ".join((e.get("title") or "").split()) if "cr" in kinds else ""
            if title:
                if len(title) > STATUSLINE_TITLE_MAX:
                    title = title[:STATUSLINE_TITLE_MAX - 1].rstrip() + "…"
                ref += f" \033[{STATUSLINE_TITLE_SGR}m{title}\033[0m"
            refs.append(ref)
        if refs:
            lines.append(STATUSLINE_SEPARATOR.join(refs))
    return lines


def _statusline_delivered_line() -> str:
    """STATUSLINE-03: what the session has shipped, on its own line above the
    open work. `~#27~ merged 🏁`. Newest first — the most recent thing shipped
    is the one worth seeing."""
    project_id = read_state("resolved.project") or ""
    parts = []
    for e in reversed([e for e in read_state_json("deliverables", [])
                       if isinstance(e, dict) and e.get("delivered")]):
        url = e.get("url", "")
        word, glyph = STATUSLINE_DELIVERED.get(_deliverable_kind(url), ("done", "✓"))
        ref = _osc8(url, f"\033[9m{_qualify_deliverable(e, project_id)}\033[29m")
        parts.append(f"\033[{STATUSLINE_DELIVERED_SGR}m{ref}\033[0m"
                     f" \033[{STATUSLINE_VERB_SGR}m{word} {glyph}\033[0m")
    return STATUSLINE_SEPARATOR.join(parts)


def cmd_statusline(_args):
    """STATUSLINE-01: Claude Code status-line provider. Claude runs this per
    prompt (and on its other status-line events) and renders stdout as a footer
    row it owns — above its built-in badges, never overlapping terminal output,
    in any terminal. The row carries the pause reason (the highest-signal 'why
    is this parked' recall context) and the resolved URL as a clickable link;
    `project` / `task` / `status` are already on the tab (RENDER-04 / TITLE-05),
    so they are not repeated here. Reads only per-session state files — no
    network — per Claude Code's guidance that the status-line command stay cheap
    (it runs frequently)."""
    # Drain Claude's status-line JSON on stdin so the pipe closes cleanly; beacon
    # resolves its own session from the environment (session_hash), so the payload
    # is unused.
    try:
        sys.stdin.read()
    except Exception:
        pass
    # One line per class, most urgent first: what mode the session declared and
    # why, what it has shipped, then the open work split by kind. Shipping is
    # rare, and burying it among the open refs is what made it unreadable on a
    # shared row.
    rows = [
        STATUSLINE_SEPARATOR.join(
            s for s in (_statusline_mode_segment(), _statusline_link_segment()) if s),
        _statusline_delivered_line(),
        *_statusline_open_lines(),
    ]
    rows = [r for r in rows if r]
    if rows:
        sys.stdout.write("\n".join(rows) + "\n")


def _is_active(line: str) -> bool:
    """A zshrc line is active if it isn't a comment and isn't blank."""
    stripped = line.strip()
    return bool(stripped) and not stripped.startswith("#")


def _has_active(content: str, needle: str) -> bool:
    return any(needle in line for line in content.splitlines() if _is_active(line))


def _install_completions(print_only: bool = False) -> None:
    if print_only:
        sys.stdout.write(ZSH_COMPLETION)
        return

    target_dir = Path.home() / ".zsh" / "completions"
    target = target_dir / "_beacon"
    target_dir.mkdir(parents=True, exist_ok=True)
    target.write_text(ZSH_COMPLETION)
    print(f"  ✓ wrote {target}")

    zshrc = Path.home() / ".zshrc"
    fpath_line = "fpath=(~/.zsh/completions $fpath)"

    if not zshrc.exists():
        print(f"  ! {zshrc} doesn't exist; create it and add:")
        print(f"      {fpath_line}")
        print("      autoload -Uz compinit && compinit")
        return

    content = zshrc.read_text()

    # Only consider uncommented lines — a stale `# fpath=…` shouldn't pass.
    if _has_active(content, ".zsh/completions"):
        print(f"  ✓ {zshrc} already configures fpath")
        return

    if _has_active(content, "compinit"):
        lines = content.splitlines(keepends=True)
        out_lines = []
        inserted = False
        for line in lines:
            if not inserted and "compinit" in line and _is_active(line):
                indent = line[: len(line) - len(line.lstrip())]
                out_lines.append(f"{indent}{fpath_line}\n")
                inserted = True
            out_lines.append(line)
        zshrc.write_text("".join(out_lines))
        print(f"  ✓ inserted fpath line before compinit in {zshrc}")
    else:
        with zshrc.open("a") as f:
            if not content.endswith("\n"):
                f.write("\n")
            f.write(f"{fpath_line}\nautoload -Uz compinit && compinit\n")
        print(f"  ✓ appended fpath + compinit to {zshrc}")


_SHELL_SENTINEL = "# beacon: project · branch · status badging"


def _install_shell_source() -> None:
    # Upgrade-safe: if the marketplace bumps the plugin version, the cache path
    # changes. Detect any prior beacon source line via the sentinel comment and
    # rewrite it to point at this PLUGIN_ROOT.
    snippet = PLUGIN_ROOT / "shell" / "beacon.zsh"
    if not snippet.is_file():
        print(f"  ! shell snippet not found at {snippet}")
        return

    zshrc = Path.home() / ".zshrc"
    source_line = f'source "{snippet}"  {_SHELL_SENTINEL}'

    if not zshrc.exists():
        print(f"  ! {zshrc} doesn't exist; create it and add:")
        print(f"      {source_line}")
        return

    content = zshrc.read_text()
    lines = content.splitlines(keepends=True)
    existing_idx = next(
        (i for i, line in enumerate(lines)
         if _SHELL_SENTINEL in line and _is_active(line)),
        None,
    )

    if existing_idx is not None:
        if str(snippet) in lines[existing_idx]:
            print(f"  ✓ {zshrc} already sources beacon.zsh from this path")
            return
        old = lines[existing_idx].rstrip("\n")
        lines[existing_idx] = source_line + "\n"
        zshrc.write_text("".join(lines))
        print(f"  ✓ updated source line in {zshrc} (path changed)")
        print(f"      old: {old}")
        print(f"      new: {source_line}")
        return

    with zshrc.open("a") as f:
        if not content.endswith("\n"):
            f.write("\n")
        f.write(f"\n{source_line}\n")
    print(f"  ✓ appended source line to {zshrc}")


def cmd_completions(args):
    if args.shell != "zsh":
        sys.exit(f"only zsh is supported (got: {args.shell})")
    _install_completions(print_only=args.print_only)
    if not args.print_only:
        print("restart your shell (or run 'exec zsh') to activate completions")


def _path_contains(target_dir: Path) -> bool:
    target = target_dir.resolve()
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry:
            continue
        try:
            if Path(entry).expanduser().resolve() == target:
                return True
        except OSError:
            continue
    return False


def _install_cli_wrapper(target_dir: Path | None = None) -> Path:
    # Drops a wrapper at <target_dir>/beacon that execs the source script.
    # The source path is hardcoded into the wrapper at install time — plugin
    # upgrades don't auto-refresh it. The plugin's SessionStart hook
    # (hooks/cli-freshness.sh) compares `beacon --version` against
    # plugin.json#version and nudges the user to re-run install on drift. The
    # nudge has to name a path under the *new* plugin root, which is why
    # /beacon:install exists (CMD-26): a stale wrapper re-installs itself from
    # the old version, and the .zshrc source line is version-pinned the same
    # way — so refreshing the wrapper alone was never enough.
    source = (PLUGIN_ROOT / "scripts" / "beacon").resolve()
    target_dir = target_dir or (Path.home() / ".local" / "bin")
    target = target_dir / "beacon"
    target_dir.mkdir(parents=True, exist_ok=True)

    wrapper = f'#!/usr/bin/env bash\nexec python3 "{source}" "$@"\n'

    if target.exists() and target.read_text() == wrapper:
        print(f"  ✓ already installed: {target} -> {source}")
    else:
        target.write_text(wrapper)
        target.chmod(0o755)
        print(f"  ✓ wrote {target} -> {source}")

    if not _path_contains(target_dir):
        print(f"  ! {target_dir} is not on $PATH — add it to your shell rc")

    return target


def cmd_refresh_iterm_profiles(_args):
    """CMD-23: re-render the dynamic profiles from the template and the user
    config, skipping the rest of the install bootstrap. This is how a changed
    `statusbar.buttons.<name>.label` is applied (STATUS-BAR-09) — iTerm2 watches
    DynamicProfiles and reloads on change, so the new label reaches every open
    pane with no restart and no re-run of the wrapper / completions / shell
    steps."""
    if not _is_iterm_installed():
        sys.exit("iTerm2 not detected — the dynamic profile is the iTerm2 "
                 "render adapter's surface, and there is nothing to render here")
    ok, msg = install_dynamic_profile()
    if not ok:
        sys.exit(msg)
    print(f"✓ {msg}")


CLAUDE_SETTINGS = Path.home() / ".claude" / "settings.json"


def _statusline_settings_value() -> dict:
    """Claude Code's `statusLine` value pointing at beacon. `beacon` is the PATH
    wrapper the install just placed."""
    return {"type": "command", "command": "beacon statusline", "padding": 0}


def _statusline_settings_block() -> str:
    """The `statusLine` block to paste by hand, shown when the install declines
    to write it."""
    return json.dumps({"statusLine": _statusline_settings_value()}, indent=2)


def _install_statusline(settings: Path | None = None) -> None:
    """STATUSLINE-01: wire `beacon statusline` into Claude Code's user
    settings.json, which is the only thing that makes the footer row exist.

    Left to a printed block, this step was skipped or applied to one project's
    `.claude/settings.local.json`, so the row was absent everywhere else and the
    whole surface read as broken. Writing it is scoped hard: `statusLine` is the
    one key touched, and an existing one is never replaced — a status line the
    user already chose outranks beacon's, so that case prints the block and says
    so rather than deciding for them."""
    settings = settings or CLAUDE_SETTINGS

    def decline(why: str) -> None:
        print(f"  ! {why}")
        print(f"  To use beacon's instead, set `statusLine` in {settings} to:")
        print(textwrap.indent(_statusline_settings_block(), "  "))

    data = {}
    if settings.exists():
        try:
            data = json.loads(settings.read_text())
        except (json.JSONDecodeError, OSError) as exc:
            decline(f"{settings} is unreadable ({exc}) — leaving it alone")
            return
        if not isinstance(data, dict):
            decline(f"{settings} is not a JSON object — leaving it alone")
            return

    current = data.get("statusLine")
    if isinstance(current, dict) and "beacon statusline" in str(current.get("command", "")):
        print(f"  ✓ already wired: {settings}")
        return
    if current is not None:
        decline(f"{settings} already defines a statusLine — leaving it alone")
        return

    data["statusLine"] = _statusline_settings_value()
    settings.parent.mkdir(parents=True, exist_ok=True)
    settings.write_text(json.dumps(data, indent=2) + "\n")
    print(f"  ✓ wrote statusLine to {settings}")


def cmd_install(_args):
    print("beacon install")
    print("==============")
    print()
    iterm = _is_iterm_installed()
    total = 6 if iterm else 3
    n = 0

    def step(title: str) -> None:
        nonlocal n
        n += 1
        print(f"[{n}/{total}] {title}")

    # Terminal-agnostic surface — the fleet dashboard, works in any terminal.
    step("CLI wrapper on PATH")
    _install_cli_wrapper(Path(_args.dir).expanduser() if _args.dir else None)
    print()
    step("tab completion")
    _install_completions()
    print()

    # Terminal-agnostic: Claude Code renders the status line in any terminal, so
    # this step runs on both paths.
    step("Claude Code status line")
    _install_statusline()
    print()

    if not iterm:
        print(_color("33",
            "iTerm2 not detected — per-pane painting (badge, status bar) is"))
        print(_color("33",
            "unavailable here. The fleet dashboard is ready:"))
        print("  beacon wip      # snapshot of active work streams")
        print("  beacon watch    # live view (q to quit)")
        print("  beacon serve    # localhost endpoint for a dashboard")
        print()
        print("  beacon serve install   # keep serve running for an external dashboard")
        return

    # iTerm2 render adapter — macOS + iTerm.app only. Every step completes in
    # place: iTerm2 reloads DynamicProfiles live, and beacon writes no pref
    # that needs iTerm2 quit, so there is no deferred-action step.
    step("shell integration")
    _install_shell_source()
    print()
    step("iTerm2 dynamic profile (status bar + badge sizing)")
    ok, msg = install_dynamic_profile()
    print(f"  ✓ {msg}" if ok else _color("33", f"  ! {msg}"))
    print()
    step("iTerm2 fleet layout (recommended, user-set)")
    # The tab-strip layout beacon's tab color is tuned for lives in app-wide
    # Appearance prefs beacon deliberately never writes (the no-`defaults write`
    # boundary). Surface any drift so the user can set it in the GUI; advisory
    # only, so its non-zero drift exit never fails the install.
    try:
        r = subprocess.run(["python3", str(BEACON_ITERM), "configure"],
                           capture_output=True, text=True, timeout=10)
        print(textwrap.indent(r.stdout.rstrip(), "  "))
    except Exception:
        print(_color("33", "  ! could not audit layout prefs — see docs/iterm.md"))
    print()
    print("Next: exec zsh, then open a fresh iTerm2 tab.")
    print("Every step completed in place — no iTerm2 restart required.")
    print()
    print("Optional: `beacon serve install` keeps serve running for an external dashboard.")


def _record_focus_handle() -> None:
    """FOCUS-02: record the iTerm2 session GUID as the session's focus handle.
    Real iTerm ids look like `w2t0p0:GUID`; the synthesized
    `claude-session:<id>` fallback (a non-iTerm terminal) has no addressable
    surface, so it is not recorded and the session is not focusable."""
    sid = os.environ.get("ITERM_SESSION_ID") or ""
    if ":" in sid and not sid.startswith("claude-session:"):
        guid = sid.rsplit(":", 1)[-1].strip()
        if guid:
            write_state("iterm_session_id", guid)


def cmd_hook(args):
    payload = {}
    try:
        raw = sys.stdin.read()
        if raw.strip():
            payload = json.loads(raw)
    except Exception:
        payload = {}
    event = args.event

    # Only a hook is told which install is loaded, so record the dir it was
    # handed for the invocations that get no env to read (`_default_data_dir`).
    handed_data_dir = os.environ.get("CLAUDE_PLUGIN_DATA")
    if handed_data_dir:
        _record_data_dir(handed_data_dir)

    # Capture the Claude session ID for cross-session handoff. It's stable
    # for the lifetime of the Claude conversation; a colleague can resume it
    # via `claude --resume <id>`.
    claude_sid = payload.get("session_id") or ""
    # When the iTerm pane id is unavailable (session launched outside an
    # iTerm-integrated shell — auto-spawned tab, `claude --resume`, a non-iTerm
    # terminal), seed the session key from the Claude session id instead so each
    # session gets its own state bucket. Without this, session_hash() falls
    # through to the literal "default" and every such session shares one bucket,
    # cross-wiring their project/url (last writer wins). Set before the first
    # write_state below so the claude_session_id record lands in the right bucket.
    if not os.environ.get("ITERM_SESSION_ID") and claude_sid:
        os.environ["ITERM_SESSION_ID"] = f"claude-session:{claude_sid}"
    if claude_sid:
        write_state("claude_session_id", claude_sid)
    transcript_path = payload.get("transcript_path") or ""
    if transcript_path:
        write_state("transcript_path", transcript_path)
        # Pick up any /color, /rename, or auto ai-title the user ran since the
        # last hook (PROV-02 task tiers + fleet-view color). Slash commands
        # fire no hook of their own, so the next hook is the harvest point.
        _read_cc_signals()

    if event == "SessionEnd":
        # HOOK-09: the session is over, so the pane is no longer managed —
        # disengage (BADGE-14) so it stops carrying a stale badge color/text
        # after the user exits. Returning here skips the trailing render(),
        # which would re-place the engagement marker and re-engage the pane.
        # Skip reasons that aren't a real exit of this pane: `clear` is
        # immediately followed by a fresh SessionStart that re-engages, and
        # `resume` suspends the session expecting its state to persist.
        reason = (payload.get("reason") or "").lower()
        if reason not in ("clear", "resume"):
            _disengage()
        return

    if event == "SessionStart":
        cwd_str = payload.get("cwd") or os.getcwd()
        # State files key on the pane (the GUID of ITERM_SESSION_ID, per
        # _session_seed), which outlives any single Claude session. A fresh
        # `claude` invocation (source=startup) or `/clear` (source=clear) in a
        # pane that hosted a prior session would otherwise inherit that
        # session's stale `activity = waiting` / `pending-attention` and
        # render red. A resumed session (source=resume) continues prior state
        # by design.
        source = (payload.get("source") or "").lower()
        if source != "resume":
            _wipe_session_for_fresh_start()
        _record_focus_handle()
        _publish_anchor(Path(cwd_str))

    elif event == "UserPromptSubmit":
        prompt_text = (payload.get("prompt") or "").strip()
        # A <task-notification> (and kin) is the harness waking the agent to
        # process finished background work, not a human turn — let the prior
        # turn stand and the agent's next Stop overwrite it, rather than
        # surfacing the raw tag as the latest turn. The status flip below still
        # runs: the session is resuming work.
        if not SYNTHETIC_PROMPT_RE.match(prompt_text):
            _write_latest_turn("human", prompt_text)
        if prompt_text and FRESH_START_RE.match(prompt_text):
            # In-session commands like /recipe re-bootstrap context; treat them
            # like SessionStart non-resume and drop stale signals before the
            # prompt lands.
            _wipe_session_for_fresh_start()
        elif read_mode()[0] in AUTO_RESUME_MODES:
            # STATE-04 auto-resume: a returning prompt leaves `pause`,
            # dropping the note with the mode. The other modes are deliberate
            # declarations that persist until explicitly left.
            write_mode(DEV_MODE)
        # The activity write is unconditional now. It used to sit in the else
        # branch, because a mode override would have discarded it anyway — under
        # the split the two are disjoint, so a session that submits a prompt
        # while in `release` correctly reads as working *and* releasing.
        write_state("activity", "working")
        # The user just submitted, so any pending Notification is resolved.
        remove_state("pending-attention")

    elif event == "Stop":
        if not payload.get("stop_hook_active"):
            # HOOK-02: a finished turn is calm, not blocking. Red is reserved
            # for active Notification (permission/idle prompt) so glancing
            # across many panes distinguishes calm sessions from sessions
            # truly waiting on user input.
            write_state("activity", "idle")
        # Turn ended: any pending permission/idle notification is no longer in flight.
        remove_state("pending-attention")
        # Refresh chips that may have drifted during the turn (branch the
        # agent created, tack context the user set). The shell's precmd
        # can't run while Claude holds the prompt, so the plugin covers
        # the gap once per turn. HOOK-08b: resolve from the SessionStart
        # anchor cwd (persisted by HOOK-08), not this turn's payload cwd —
        # the anchor is fixed for the session even as chip values evolve.
        cwd_str = read_state("anchor.cwd") or payload.get("cwd") or os.getcwd()
        _publish_chips(Path(cwd_str))
        _write_latest_turn("agent", _last_assistant_text())

    elif event == "Notification":
        write_state("activity", "waiting")
        # Sticky marker: takes precedence over a stale PostToolUse working signal
        # that may arrive after this Notification due to out-of-order delivery.
        # Only its presence matters — permission and idle both read as "needs the
        # user" and beacon does not distinguish them on any surface (HOOK-03), so
        # the marker carries a constant, not the prompt type.
        write_state("pending-attention", "1")

    elif event == "PreToolUse":
        # Tool activity means the agent is working, not waiting. This
        # transitions out of `waiting` after a permission_prompt Notification
        # is granted — without this, the tab would stay red for the rest of
        # the turn.
        write_state("activity", "working")
        # PreToolUse fires when a tool is starting — past any permission gate.
        # Clear the sticky marker so the tab can flip back to working.
        remove_state("pending-attention")

    elif event == "PostToolUse":
        # Re-assert working between tool calls — a tool just returned and the
        # agent is back to thinking, even if no further matching PreToolUse fires
        # before the next Notification or Stop. Deliberately does NOT clear
        # pending-attention: a late PostToolUse arriving after a fresh
        # Notification must not undo the sticky waiting marker.
        write_state("activity", "working")

    render()

    # WINDOW-TITLE (TITLE-04): the interactive shell sets the session name once
    # on source (shell/beacon.zsh), backgrounded — so its write can land AFTER
    # the plugin's SessionStart set-name and revert an engaged pane's title to
    # the shell's INTERACTIVE_TITLE_FORMAT template. render() only (re)sets
    # the name on a profile swap, so reclaim it once on the first turn boundary
    # (by then the launch-time shell write has settled). It's a one-shot: after
    # SessionStart nothing else clobbers the name (the shell never re-sources
    # while Claude holds the pane, and swaps are covered in apply()), so a flag
    # keeps this off every subsequent turn — an Apple Event is too costly to
    # spend per turn for a launch-only race. A fresh start / disengage clears the
    # flag so the next engagement re-arms it.
    if (event in ("UserPromptSubmit", "Stop")
            and not read_state("title_reasserted")):
        _set_session_title()
        write_state("title_reasserted", "1")


# --- argparse ---

def _build_parser() -> "argparse.ArgumentParser":
    parser = argparse.ArgumentParser(prog="beacon", description=__doc__)
    parser.add_argument("--version", "-v", action="version",
                        version=f"beacon {_plugin_version()}")
    parser.add_argument("--color", choices=["auto", "always", "never"], default="auto",
                        help="colorize output: auto (TTY-detect, the default), always, or never. "
                             "Use --color=always to keep color through a pipe (e.g. `watch --color`).")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("show", help="show resolved signal state")

    sp = sub.add_parser("set", help="set an override")
    sp.add_argument("field", choices=list(VALID_FIELDS))
    sp.add_argument("value", nargs="+")

    sp = sub.add_parser("task", help="set task override")
    sp.add_argument("value", nargs="+")

    sp = sub.add_parser(
        "status",
        help=f"enter a mode ({'|'.join(MODES)}) with an optional note, "
             f"or `{DEV_MODE}` to leave one",
    )
    sp.add_argument("mode", choices=[DEV_MODE, *MODES])
    sp.add_argument("note", nargs="*")

    sp = sub.add_parser("project", help="set project override")
    sp.add_argument("value", nargs="+")

    sp = sub.add_parser("clear", help="clear overrides")
    sp.add_argument("field", nargs="?", choices=list(VALID_FIELDS))

    sp = sub.add_parser("pause", help="enter pause mode with an optional note")
    sp.add_argument("note", nargs="*")
    sp.add_argument("--clear-screen", action="store_true",
                    help="also clear the iTerm2 session's screen + scrollback for a clean stand-down")

    sub.add_parser("statusline",
                   help="(internal) Claude Code status-line provider: the mode note + deliverable links")

    sp = sub.add_parser("release",
                        help="enter release mode (ship-it flow in progress) with an optional note")
    sp.add_argument("note", nargs="*")

    sp = sub.add_parser("retro",
                        help="enter retro mode (post-work follow-up) with an optional note")
    sp.add_argument("note", nargs="*")

    sp = sub.add_parser("done",
                        help="enter done mode (session complete, ready to hand off) with an optional note")
    sp.add_argument("note", nargs="*")

    sub.add_parser("resume", help="drop the overrides and leave any mode")
    sub.add_parser("reset", help="clear all session state")
    sub.add_parser("render", help="re-render current state")

    sp = sub.add_parser("hook", help="(internal) handle a Claude Code hook event")
    sp.add_argument("event")

    sp = sub.add_parser("completions", help="install or print shell completions")
    sp.add_argument("shell", choices=["zsh"], nargs="?", default="zsh")
    sp.add_argument("--print", dest="print_only", action="store_true",
                    help="print the script to stdout instead of installing")

    sp = sub.add_parser("install",
                        help="run all install steps (wrapper, completions, + iTerm2 adapter if present)")
    sp.add_argument("--dir", default=None,
                    help="directory to install the wrapper into (default: ~/.local/bin)")

    sub.add_parser("refresh-iterm-profiles",
                   help="re-render the iTerm2 dynamic profiles (applies a changed button label)")

    sub.add_parser("copy-url", help="copy the resolved URL to the clipboard via pbcopy")

    sp = sub.add_parser("open-url",
                        help="open the session's web view (config: statusbar.buttons.web.cmd)")
    sp.add_argument("dir", nargs="?", help="directory to resolve from (default: cwd)")

    sp = sub.add_parser("open-code",
                        help="open a directory in the configured editor (config: statusbar.buttons.code.cmd)")
    sp.add_argument("dir", nargs="?", help="directory to open (default: cwd)")

    sub.add_parser("json", help="print the resolved session state as JSON")

    sp = sub.add_parser("wip", help="list active work streams across all beacon sessions (+ tack routes)")
    sp.add_argument("--json", action="store_true", help="emit JSON instead of a table")
    sp.add_argument("--since", default=None, metavar="WHEN",
                    help="only sessions active since this time — a duration (1d, 2h, 30m) "
                         "or ISO-8601 timestamp (default: last 24h)")
    sp.add_argument("--all", action="store_true",
                    help="every recorded session, no time window (the full history)")
    sp.add_argument("--timing", action="store_true",
                    help="print a scan-timing breakdown to stderr (profiling)")

    sp = sub.add_parser("watch", help="live, person-facing work-stream view (recency feed; q to quit)")
    sp.add_argument("--interval", type=float, default=1.0, metavar="SECS",
                    help="refresh cadence in seconds (default 1.0)")
    sp.add_argument("--since", default=None, metavar="WHEN",
                    help="only sessions active since this time — a duration (1d, 2h, 30m) "
                         "or ISO-8601 timestamp (default: last 24h)")
    sp.add_argument("--all", action="store_true",
                    help="every recorded session, no time window (the full history)")

    sp = sub.add_parser("serve",
                        help="serve the wip payload on http://127.0.0.1, or manage the always-on unit")
    sp.add_argument("action", nargs="?",
                    choices=["run", "install", "uninstall", "status"], default="run",
                    help="run in the foreground (default), or manage the launchd/systemd unit")
    sp.add_argument("--port", type=int, default=DEFAULT_SERVE_PORT,
                    help=f"port to bind (default {DEFAULT_SERVE_PORT})")

    sp = sub.add_parser("prune", help="remove per-session state for long-idle sessions")
    sp.add_argument("--since", "--keep", dest="keep", default="30d", metavar="WHEN",
                    help="keep sessions active within this window and prune the rest — "
                         "a duration (14d, 12h) or ISO-8601 timestamp (default 30d)")

    sp = sub.add_parser("forget", help="remove per-session state for one session, by its per-pane hash")
    sp.add_argument("hash", help="the session's per-pane hash (the `hash` field of a `wip --json` record)")

    sp = sub.add_parser("drop", help="remove one deliverable from this session's status-line row")
    sp.add_argument("ref", help="the deliverable's ref (#42, !17, otherproj:#9) or its URL")

    sp = sub.add_parser("export",
                        help="emit a lossless JSON backup of all per-session state (joins to a tack export on claude_session_id)")
    sp.add_argument("--out-file", metavar="FILE", default=None,
                    help="write to FILE instead of stdout (the default)")
    sp.add_argument("--compress", action="store_true",
                    help="gzip the output (implied by an --out-file path ending .gz)")

    sp = sub.add_parser("import",
                        help="restore per-session state from a `beacon export` file (non-destructive unless --force)")
    sp.add_argument("file", help="the export file to restore (plain or gzipped JSON)")
    sp.add_argument("--force", action="store_true",
                    help="overwrite sessions already present on disk (default: skip them)")

    sub.add_parser("data-dir", help="print the resolved data dir (consumed by shell/beacon.zsh on source)")

    sp = sub.add_parser("config-get", help="(internal) print a user-config value by key")
    sp.add_argument("key")

    return parser


# Subcommands intentionally absent from tab-completion (ZSH_COMPLETION): internal
# hook entry points and shell-integration helpers a user never types by hand. The
# CompletionsMatchSubcommands test asserts completion covers every *other*
# subcommand, so a new user-facing command that skips ZSH_COMPLETION fails CI.
_UNCOMPLETED_COMMANDS = {"hook", "data-dir", "config-get", "statusline"}


def main(argv=None):
    parser = _build_parser()

    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["help"]:
        argv = ["--help"]
    args = parser.parse_args(argv)

    if args.color != "auto":
        global _COLOR_OVERRIDE
        _COLOR_OVERRIDE = args.color == "always"

    handlers = {
        "show": cmd_show, "set": cmd_set, "task": cmd_task,
        "status": cmd_status, "project": cmd_project,
        "clear": cmd_clear,
        "pause": cmd_pause, "release": cmd_release, "retro": cmd_retro, "done": cmd_done,
        "resume": cmd_resume, "reset": cmd_reset,
        "render": cmd_render, "statusline": cmd_statusline, "hook": cmd_hook,
        "completions": cmd_completions, "install": cmd_install,
        "refresh-iterm-profiles": cmd_refresh_iterm_profiles,
        "copy-url": cmd_copy_url,
        "open-url": cmd_open_url, "open-code": cmd_open_code,
        "json": cmd_json,
        "wip": cmd_wip, "watch": cmd_watch, "serve": cmd_serve, "prune": cmd_prune,
        "forget": cmd_forget, "drop": cmd_drop, "export": cmd_export, "import": cmd_import,
        "data-dir": cmd_data_dir, "config-get": cmd_config_get,
    }
    if not args.cmd:
        parser.print_help(sys.stderr)
        sys.exit(1)
    handlers[args.cmd](args)


if __name__ == "__main__":
    main()
