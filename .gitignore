__pycache__

# `shipyard build-docs` renders into docs/; only the hand-authored sources below
# are tracked. Ignoring the directory rather than listing what it renders means a
# page shipyard adds later isn't committed as though it were a source.
docs/*
!docs/README.md
!docs/_sidebar.md
!docs/favicon.svg
!docs/demo.md
!docs/iterm.md
!docs/palette.md
!docs/statusbar.md
!docs/why.md
!docs/images/

.claude/*
!.claude/hooks/
!.claude/settings.json
.preview/
