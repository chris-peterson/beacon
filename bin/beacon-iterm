#!/usr/bin/env python3
"""beacon-iterm — emit iTerm2 control operations.

Stateless CLI. Most subcommands paint one surface via an escape sequence;
`focus` is the exception — an out-of-band Apple Events action.
  uservar      — set a user variable (SetUserVar=)
  badge-format — set the per-session badge format template
  badge-color  — set the per-session badge color (SetColors=badge=)
  tab-color    — set the per-tab color (SetColors=tab=)
  set-profile  — switch the session's dynamic profile (SetProfile=)
  set-name     — set a session's name by its session id (interpolated title)
  clear        — restore badge + tab color to profile defaults
  focus        — bring an iTerm2 session to the foreground by its session id
"""
from __future__ import annotations

import argparse
import base64
import os
import re
import sys

# `subprocess`, `tempfile`, `shlex` and `pathlib` are imported inside the
# functions that need them, not here. Every paint verb (uservar, tab-color,
# set-profile) runs on a hook or a shell prompt, and at module scope those four
# add ~16ms of interpreter startup to each of those invocations — none of which
# ever reaches the Apple Events, `defaults`, or `configure` code that wants
# them. `argparse` and `re` stay at module scope: both measure free here.

_TTY = None


def _ancestor_tty() -> str | None:
    """Walk up the process tree to find an ancestor with a controlling
    terminal (a /dev/ttys* device on macOS). Used as a fallback when
    `/dev/tty` fails — happens when invoked from a subprocess detached
    from its ctty (e.g., Claude Code's Bash tool spawns subprocesses
    with `setsid`, so `TT=??` and `/dev/tty` returns ENXIO). Writing
    OSC to the ancestor's pty reaches iTerm2 directly.

    FUTURE: the iTerm2 Python API (websocket) is a more robust transport
    and would unlock interactive surfaces (clickable status bar, menus,
    keyboard shortcuts). Larger refactor — tracked separately.
    """
    import subprocess

    # Queried one ancestor at a time on purpose. Reading the whole table in a
    # single `ps -e` sounds cheaper and measures ~2.5x worse: the walk is only
    # about three levels deep, and formatting ~1000 rows costs far more than the
    # two extra spawns it saves.
    pid = os.getpid()
    seen = set()
    for _ in range(32):
        if pid <= 1 or pid in seen:
            return None
        seen.add(pid)
        try:
            r = subprocess.run(
                ["ps", "-o", "tt=,ppid=", "-p", str(pid)],
                capture_output=True, text=True, timeout=2,
            )
        except Exception:
            return None
        if r.returncode != 0:
            return None
        parts = r.stdout.split()
        if len(parts) < 2:
            return None
        tt, ppid = parts[0], parts[1]
        if tt and tt != "??":
            path = f"/dev/tty{tt}"
            if os.path.exists(path):
                return path
        try:
            pid = int(ppid)
        except ValueError:
            return None
    return None


def _tty():
    global _TTY
    if _TTY is None:
        try:
            _TTY = open("/dev/tty", "w")
        except OSError:
            path = _ancestor_tty()
            if path:
                try:
                    _TTY = open(path, "w")
                except OSError:
                    _TTY = sys.stdout
            else:
                _TTY = sys.stdout
    return _TTY


def _osc(payload: str, st: str = "\x07") -> None:
    f = _tty()
    f.write(f"\x1b]{payload}{st}")
    f.flush()


def _b64(s: str) -> str:
    return base64.b64encode(s.encode("utf-8")).decode("ascii")


def _hex6(s: str) -> bool:
    return len(s) == 6 and all(c in "0123456789abcdefABCDEF" for c in s)


# --- subcommands ---

def cmd_badge_color(args):
    v = args.value
    if v.lower() == "default":
        _osc("1337;SetColors=badge=default")
        return
    if not _hex6(v):
        sys.exit(f"badge-color expects 6-digit hex or 'default', got: {v}")
    _osc(f"1337;SetColors=badge={v.lower()}")


def cmd_tab_color(args):
    v = args.value
    if v.lower() == "default":
        _osc("1337;SetColors=tab=default")
        return
    if not _hex6(v):
        sys.exit(f"tab-color expects 6-digit hex or 'default', got: {v}")
    _osc(f"1337;SetColors=tab={v.lower()}")


def cmd_uservar(args):
    name = args.name
    value = args.value or ""
    _osc(f"1337;SetUserVar={name}={_b64(value)}")


def cmd_uservar_batch(args):
    for pair in args.pairs:
        if "=" not in pair:
            continue
        name, value = pair.split("=", 1)
        if not name:
            continue
        _osc(f"1337;SetUserVar={name}={_b64(value)}")


def cmd_badge_format(args):
    # iTerm2 expects the format template base64-encoded. The template can
    # reference \(user.foo) variables; iTerm re-evaluates them whenever the
    # vars change, so SetUserVar updates flow into the badge automatically.
    _osc(f"1337;SetBadgeFormat={_b64(args.template)}")


def cmd_set_profile(args):
    # Profile names must exist in iTerm2's DynamicProfiles dir. iTerm2
    # silently ignores unknown names, so this fails quietly if the caller
    # asks for a profile that wasn't installed — the plugin treats that as
    # an install-time misconfiguration rather than runtime fallibility.
    name = args.name.strip()
    if not name:
        sys.exit("set-profile expects a profile name")
    _osc(f"1337;SetProfile={name}")


def cmd_clear(_args):
    _osc("1337;SetColors=badge=default")
    _osc("1337;SetColors=tab=default")


def cmd_clear_screen(_args):
    # Clear the session's visible screen AND scrollback — the Cmd+K / "Clear
    # Buffer" equivalent, for a clean stand-down. CSI H (cursor home) + 2J (erase
    # display) + 3J (erase scrollback, the xterm E3 capability iTerm2 honors).
    # Written straight to /dev/tty like every other surface, so it reaches the
    # real terminal even when the caller's stdout is captured (e.g. a hook); when
    # there's no tty it degrades to stdout, a harmless no-op for the buffer.
    f = _tty()
    f.write("\x1b[H\x1b[2J\x1b[3J")
    f.flush()


# iTerm2 has no escape sequence to raise *another* session, so focus drives
# Apple Events via osascript. The script captures the target with no side
# effects and only then selects it — selecting a window mid-enumeration
# reorders iTerm2's window list and invalidates the in-flight reference
# (Invalid index -1719) on nested splits. A minimized window sits in the Dock
# where select/activate can't reach it, so de-miniaturize the captured window
# first (a no-op when it isn't minimized). Indented with spaces, not tabs:
# AppleScript is whitespace-insensitive and spaces survive string embedding.
_FOCUS_APPLESCRIPT = '''
tell application "iTerm2"
  set theID to "__SID__"
  set targetSession to missing value
  set targetTab to missing value
  set targetWindow to missing value
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if id of s is theID then
          set targetSession to s
          set targetTab to t
          set targetWindow to w
          exit repeat
        end if
      end repeat
      if targetSession is not missing value then exit repeat
    end repeat
    if targetSession is not missing value then exit repeat
  end repeat
  if targetSession is missing value then error "no session" number 3
  if miniaturized of targetWindow then set miniaturized of targetWindow to false
  select targetSession
  select targetTab
  select targetWindow
  activate
end tell
'''

_GUID_RE = re.compile(r"^[A-Za-z0-9-]+$")


def cmd_focus(args):
    import subprocess

    sid = args.session_id.strip()
    # Accept either the bare session GUID or a full ITERM_SESSION_ID
    # (`w2t0p0:GUID`) — the GUID after the last colon is iTerm2's session id.
    if ":" in sid:
        sid = sid.rsplit(":", 1)[-1]
    if not _GUID_RE.match(sid):
        sys.exit(f"focus: invalid session id: {args.session_id}")
    script = _FOCUS_APPLESCRIPT.replace("__SID__", sid)
    r = subprocess.run(["osascript", "-e", script],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"focus: {r.stderr.strip() or ('no iTerm2 session with id ' + sid)}")


# iTerm2 has no escape sequence to set a session's name (the OSC 0/1/2 title
# codes are the only ones, and they're gated by the profile's "Allow Title
# Setting" — which beacon disables so Claude Code's title OSC can't overwrite
# the pane). So set-name drives Apple Events, like focus. The name is stored as
# an interpolated string: passing `\(user.beacon_project)…` lets iTerm2
# re-evaluate it live as SetUserVar updates flow in, so it need only be set once
# per profile swap rather than on every render. Indented with spaces (see focus).
_SET_NAME_APPLESCRIPT = '''
tell application "iTerm2"
  set theID to "__SID__"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if id of s is theID then
          set name of s to "__NAME__"
          return
        end if
      end repeat
    end repeat
  end repeat
  error "no session" number 3
end tell
'''


# The read counterpart of set-name, and the only way a *local* process can see a
# user var a *remote* host published: the value lives in iTerm2, and a status-bar
# action component cannot interpolate `\(user.*)` into its command (§6.10). Same
# Apple Events transport as focus and set-name — deliberately not the iTerm2
# Python API, which beacon does not use.
_GET_VAR_APPLESCRIPT = '''
tell application "iTerm2"
  set theID to "__SID__"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if id of s is theID then
          return variable s named "__NAME__"
        end if
      end repeat
    end repeat
  end repeat
  error "no session" number 3
end tell
'''

# iTerm2 answers an unset variable with `missing value` at exit 0, so the exit
# code says nothing about whether the var exists.
_APPLESCRIPT_MISSING = "missing value"


def cmd_getvar(args):
    import subprocess

    sid = args.session_id.strip()
    if ":" in sid:
        sid = sid.rsplit(":", 1)[-1]
    if not _GUID_RE.match(sid):
        sys.exit(f"getvar: invalid session id: {args.session_id}")
    script = (_GET_VAR_APPLESCRIPT
              .replace("__SID__", sid)
              .replace("__NAME__", _applescript_str(args.name)))
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"getvar: {r.stderr.strip() or ('no iTerm2 session with id ' + sid)}")
    value = r.stdout.rstrip("\n")
    # An unset var prints nothing rather than the literal, so a caller can test
    # for empty without knowing AppleScript's vocabulary.
    print("" if value == _APPLESCRIPT_MISSING else value)


def _applescript_str(s: str) -> str:
    """Escape a Python string for an AppleScript double-quoted literal. The name
    template carries backslashes (`\\(user.foo)`), so backslash must double
    first, then quotes."""
    return s.replace("\\", "\\\\").replace('"', '\\"')


def cmd_set_name(args):
    import subprocess

    sid = args.session_id.strip()
    if ":" in sid:
        sid = sid.rsplit(":", 1)[-1]
    if not _GUID_RE.match(sid):
        sys.exit(f"set-name: invalid session id: {args.session_id}")
    script = (_SET_NAME_APPLESCRIPT
              .replace("__SID__", sid)
              .replace("__NAME__", _applescript_str(args.name)))
    r = subprocess.run(["osascript", "-e", script],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"set-name: {r.stderr.strip() or ('no iTerm2 session with id ' + sid)}")


# --- layout audit ---

# The app-wide iTerm2 Appearance prefs beacon's tab-color signal is *tuned for*
# but cannot set: all are global keys in com.googlecode.iterm2, none are
# per-profile, so a beacon dynamic profile can't carry them (confirmed against a
# live left-tabs plist, iTerm2 3.6.10). beacon writes no iTerm2 pref — the
# no-`defaults write` boundary that keeps it clear of the plist-cache trap — so
# `configure` only audits and names each value for the user to set in
# Preferences → Appearance.
RECOMMENDED_LAYOUT = (
    {"key": "HideTab", "want": "0", "type": "bool",
     "label": "Tab bar always visible",
     "why": "iTerm2 hides the bar at one tab per window, which is where a "
            "single-pane session lives — the tab color and two-line label are "
            "the whole signal, so that window carries none",
     "where": "Appearance → Tabs"},
    {"key": "TabViewType", "want": "2", "type": "int", "label": "Tabs on the left",
     "why": "a tall left strip is the natural home for a fleet of sessions; "
            "the tab color reads as a scannable column",
     "where": "Appearance → Tabs"},
    {"key": "UseCustomTabBarFontSize", "want": "1", "type": "bool",
     "label": "Custom tab font size (on)",
     "why": "the switch that lets the size below take effect",
     "where": "Appearance → Tabs"},
    {"key": "CustomTabBarFontSize", "want": "22", "type": "float",
     "label": "Tab-label font size",
     "why": "default labels are unreadably small in a left strip",
     "where": "Appearance → Tabs"},
    {"key": "DefaultTabBarHeight", "want": "90", "type": "float", "label": "Taller tabs",
     "why": "gives the two-line project/task label room to show both lines",
     "where": "Appearance → Tabs"},
    {"key": "StatusBarPosition", "want": "0", "type": "int",
     "label": "Status bar at the top",
     "why": "reads as a header for the pane; the bottom is where Claude Code "
            "renders beacon's own status line, and the two stack there",
     "where": "Appearance → General"},
    {"key": "HTMLTabTitles", "want": "1", "type": "bool",
     "label": "HTML tab titles (on)",
     "why": "renders the <b> project accent in the two-line tab label",
     "where": "Appearance → Tabs"},
)


def _read_default(key: str) -> str | None:
    """An app-wide iTerm2 preference value, or None when unset (its effective
    value is then iTerm2's built-in default, which for every recommended key
    differs from the wanted value — so unset always reads as drift)."""
    import subprocess

    try:
        r = subprocess.run(["defaults", "read", "com.googlecode.iterm2", key],
                           capture_output=True, text=True, timeout=5)
    except Exception:
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def _layout_drift():
    return [s for s in RECOMMENDED_LAYOUT if _read_default(s["key"]) != s["want"]]


def _is_iterm_running() -> bool:
    # osascript is the reliable way to ask. `pgrep -x iTerm2` misses the running
    # app — macOS matches `-x` against the full executable path
    # (`/Applications/iTerm.app/Contents/MacOS/iTerm2`) — and a false negative
    # here routes the write straight into a live iTerm2, which then restores the
    # old value from its in-memory copy on quit.
    import subprocess

    try:
        r = subprocess.run(
            ["osascript", "-e", 'application "iTerm" is running'],
            capture_output=True, text=True, timeout=5,
        )
    except Exception:
        return False
    return r.returncode == 0 and r.stdout.strip().lower() == "true"


def _prompt_tty(question: str, default_yes: bool):
    """A y/n answer read from the controlling terminal, or None when there is
    no tty to ask on (so callers can fail loudly rather than assume consent)."""
    suffix = "[Y/n]" if default_yes else "[y/N]"
    try:
        with open("/dev/tty") as tty:
            sys.stdout.write(f"{question} {suffix} ")
            sys.stdout.flush()
            resp = tty.readline().strip().lower()
    except OSError:
        return None
    return default_yes if not resp else resp in ("y", "yes")


def _defaults_write_args(spec) -> list[str]:
    if spec["type"] == "bool":
        return ["-bool", "true" if spec["want"] == "1" else "false"]
    return [f"-{spec['type']}", spec["want"]]  # -int / -float, typed per the plist


def _apply_layout(specs) -> None:
    """Write the selected app-wide prefs, then relaunch iTerm2. Only ever runs
    with iTerm2 not running, so the writes survive — iTerm2 rewrites the plist
    from its in-memory copy on quit, which is exactly the clobber the whole
    quit-write-relaunch dance exists to avoid (CLI-18)."""
    import subprocess

    for s in specs:
        r = subprocess.run(["defaults", "write", "com.googlecode.iterm2",
                            s["key"], *_defaults_write_args(s)],
                           capture_output=True, text=True, timeout=10)
        ok = "wrote" if r.returncode == 0 else f"FAILED: {r.stderr.strip()}"
        print(f"  {ok}: {s['key']} = {s['want']}")
    subprocess.run(["open", "-a", "iTerm"], capture_output=True, timeout=10)


def _advertised_command() -> str:
    """The command the reader should type to apply the layout. The plugin sets
    this when it shells out, so its output names `beacon layout` — the front
    door — rather than this CLI, which a user is not expected to invoke."""
    return os.environ.get("BEACON_LAYOUT_COMMAND", "beacon-iterm configure")


def _running_caveat() -> str:
    """`defaults read` answers from the plist, which is only the effective value
    while iTerm2 is down: it holds its own copy and rewrites the file from
    memory on quit. So an aligned reading here can disagree with the tab strip
    in front of the user, and a write that landed behind a live iTerm2 reads as
    applied right up until it is discarded."""
    return ("! iTerm2 is running; these are the on-disk values. It keeps its own\n"
            "  copy and rewrites the plist on quit, so what you see in the tab\n"
            "  strip may differ until then.")


def _configure_audit():
    aligned = "\x1b[32m✓\x1b[0m"
    differs = "\x1b[33m✗\x1b[0m"
    print("Recommended iTerm2 fleet layout — app-wide Appearance prefs:\n")
    drift = []
    for s in RECOMMENDED_LAYOUT:
        cur = _read_default(s["key"])
        ok = cur == s["want"]
        mark = aligned if ok else differs
        shown = cur if cur is not None else "unset"
        print(f"  {mark}  {s['label']:<34} {s['key']} = {s['want']}"
              f"  (current: {shown})")
        if not ok:
            drift.append(s)
            print(f"       └ {s['why']}")
    print()
    if not drift:
        print("All aligned — the tab-color signal has the room it needs.")
        if _is_iterm_running():
            print()
            print(_running_caveat())
        sys.exit(0)
    print(f"{len(drift)} of {len(RECOMMENDED_LAYOUT)} settings differ. "
          "Apply them without opening Preferences:\n"
          f"  {_advertised_command()} --write\n"
          "(quits + relaunches iTerm2 — run it when idle).")
    sys.exit(1)


def _configure_write(args):
    running = _is_iterm_running()

    if args.keys is not None:
        wanted = set(args.keys.split(","))
        selected = [s for s in RECOMMENDED_LAYOUT if s["key"] in wanted]
    else:
        drift = _layout_drift()
        if not drift:
            print("Layout already matches the recommendation — nothing to write.")
            if running:
                # The drift check just read the plist, which a live iTerm2 will
                # overwrite from memory — so "matches" here is not proof the tab
                # strip agrees, and the user needs a way past this refusal.
                print()
                print(_running_caveat())
                print("  To apply a setting anyway, name it:\n"
                      f"    {_advertised_command()} --write --keys <Key>")
            return
        if args.yes:
            selected = drift
        else:
            print("Apply the recommended fleet layout — beacon writes each for "
                  "you, no Preferences window:\n")
            selected = []
            for s in drift:
                ans = _prompt_tty(f"  {s['label']}  ({s['key']} = {s['want']})", True)
                if ans is None:
                    sys.exit("configure --write needs a terminal to confirm on; "
                             "re-run with --yes to accept every recommendation.")
                if ans:
                    selected.append(s)

    if not selected:
        print("Nothing selected — no changes made.")
        return

    # iTerm2 down: safe to write directly (nothing will clobber the plist).
    if not running:
        _apply_layout(selected)
        print(f"Applied {len(selected)} setting(s); relaunching iTerm2.")
        return

    # iTerm2 up: a direct write is clobbered on quit, so a detached helper waits
    # for iTerm2 to exit, writes, and relaunches. Confirm first — quitting closes
    # every window and pane, including this session.
    if not args.yes:
        print("\nApplying this needs iTerm2 to quit, which closes every window "
              "and pane — including this session.\nRun it when idle, not with "
              "active work open.")
        ok = _prompt_tty("Quit iTerm2, apply, and relaunch now?", False)
        if not ok:
            print("Aborted — no changes made.")
            return

    import shlex
    import subprocess
    import tempfile

    keys_csv = ",".join(s["key"] for s in selected)
    log_path = os.path.join(tempfile.gettempdir(), "beacon-configure.log")
    self_path = os.path.realpath(__file__)
    # Same running-check as _is_iterm_running, in shell: pgrep would fall
    # through immediately and write before iTerm2 had finished quitting.
    still_up = "osascript -e " + shlex.quote('application "iTerm" is running')
    helper = (
        f'while [ "$({still_up})" = true ]; do sleep 0.5; done; '
        f"python3 {shlex.quote(self_path)} configure --write --yes "
        f"--keys {shlex.quote(keys_csv)}"
    )
    # start_new_session detaches the helper from this pane's session so iTerm2's
    # quit (which SIGHUPs its children, us included) can't take it down with us.
    with open(log_path, "w") as log:
        subprocess.Popen(["nohup", "zsh", "-c", helper], stdout=log,
                         stderr=subprocess.STDOUT, start_new_session=True)
    print(f"Quitting iTerm2 — it relaunches with the new layout (log: {log_path}).")
    subprocess.run(["osascript", "-e", 'tell application "iTerm" to quit'],
                   capture_output=True, timeout=10)


def cmd_configure(args):
    if args.write:
        _configure_write(args)
    else:
        _configure_audit()


# --- entry ---

def main(argv=None):
    p = argparse.ArgumentParser(prog="beacon-iterm")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("badge-color", help="set badge color (6-hex or 'default')")
    sp.add_argument("value")
    sp.set_defaults(func=cmd_badge_color)

    sp = sub.add_parser("tab-color", help="set tab color (6-hex or 'default')")
    sp.add_argument("value")
    sp.set_defaults(func=cmd_tab_color)

    sp = sub.add_parser("uservar", help="publish user.<name>=<value>")
    sp.add_argument("name")
    sp.add_argument("value", nargs="?", default="")
    sp.set_defaults(func=cmd_uservar)

    sp = sub.add_parser("uservar-batch",
                        help="publish multiple user.<name>=<value> pairs in one invocation")
    sp.add_argument("pairs", nargs="+")
    sp.set_defaults(func=cmd_uservar_batch)

    sp = sub.add_parser("badge-format", help="set the per-session badge format template")
    sp.add_argument("template")
    sp.set_defaults(func=cmd_badge_format)

    sp = sub.add_parser("set-profile", help="switch session profile (SetProfile=)")
    sp.add_argument("name")
    sp.set_defaults(func=cmd_set_profile)

    sp = sub.add_parser("clear", help="restore badge + tab color to profile defaults")
    sp.set_defaults(func=cmd_clear)

    sp = sub.add_parser("clear-screen", help="clear the session's screen + scrollback (Cmd+K equivalent)")
    sp.set_defaults(func=cmd_clear_screen)

    sp = sub.add_parser("set-name", help="set a session's name by its session id (interpolated title)")
    sp.add_argument("session_id")
    sp.add_argument("name")
    sp.set_defaults(func=cmd_set_name)

    sp = sub.add_parser("getvar", help="read a session's user var by its session id")
    sp.add_argument("session_id")
    sp.add_argument("name")
    sp.set_defaults(func=cmd_getvar)

    sp = sub.add_parser("focus", help="bring an iTerm2 session to the foreground by its session id")
    sp.add_argument("session_id")
    sp.set_defaults(func=cmd_focus)

    sp = sub.add_parser("configure",
                        help="audit (read-only; exits non-zero on drift) or --write "
                             "the app-wide iTerm2 layout prefs beacon is tuned for")
    sp.add_argument("--write", action="store_true",
                    help="apply the recommended settings (quits + relaunches iTerm2)")
    sp.add_argument("--yes", action="store_true",
                    help="skip confirmation prompts (accept every recommendation)")
    sp.add_argument("--keys",
                    help="comma-separated setting keys to write, skipping the "
                         "drift check (also the restart helper's handoff)")
    sp.set_defaults(func=cmd_configure)

    argv = sys.argv[1:] if argv is None else argv
    if not argv:
        p.print_help(sys.stderr)
        sys.exit(1)
    if argv[:1] == ["help"]:
        argv = ["--help"]

    args = p.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
